<view style="{{theme}}" class="banner-pages"><swiper current="{{current || 0}}" bindchange="change" indicator-dots="{{cards.length > 1}}" indicator-color="{{indicatorColor}}" indicator-active-color="{{indicatorActiveColor}}" circular="{{cards.length > 1}}" autoplay="{{false}}" display-multiple-items="1" previous-margin="0px" next-margin="0px" class="campaign-swiper" aria-label="{{isNodes ? (locale === 'en' ? 'City and followed spaces' : '城市与已关注节点') : (locale === 'en' ? 'Event series' : '活动专题')}}">
 <swiper-item wx:for="{{cards}}" wx:key="id"><view class="campaign-slide" data-route="{{isNodes ? 'space' : 'campaign'}}" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.cover_url && !demo}}" src="{{item.cover_url}}" class="campaign-background" mode="aspectFill"/><view wx:else class="feature-geometry geometry-{{index % 2}}" aria-hidden="true"><view class="geometry-disc"/><view class="geometry-arch"/><view class="geometry-table"/></view><view class="campaign-copy"><text class="banner-kicker">{{isNodes ? item.context + (item.city !== city ? ' · ' + item.cityLabel : '') : item.kicker}}</text><text class="banner-title">{{item.title}}</text><text class="banner-description">{{isNodes ? item.summary : item.banner_description || item.introduction}}</text></view></view></swiper-item>
</swiper></view>
