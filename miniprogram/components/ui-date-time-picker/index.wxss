.datetime{display:flex;gap:var(--actionGap);flex-wrap:wrap;min-width:0;color:var(--ink)}.part{flex:1 1 200rpx;min-width:0;max-width:100%}.picker{box-sizing:border-box;min-height:var(--controlHeight);padding:var(--fieldInsetBlock) var(--fieldInsetInline);border:var(--stroke) solid var(--line);border-radius:var(--radiusField);background:var(--surface);font-size:var(--typeFact);line-height:var(--fieldLineHeight);overflow-wrap:anywhere}
