<view style="{{theme}}" class="overlay"><view class="scrim" bindtap="close"/><view class="sheet {{poster ? 'poster' : ''}}" role="dialog" aria-modal="true" aria-label="{{title}}"><view class="handle"/><view class="heading"><text class="title">{{title}}</text><ui-icon-button icon="/assets/community-icons/close.png" label="{{closeLabel || '关闭'}}" surface="plain" disabled="{{busy}}" bind:press="close"/></view><text wx:if="{{description}}" class="description">{{description}}</text><ui-notice wx:if="{{error}}" state="error" text="{{error}}"/><slot/></view></view>
