.overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end}.scrim{position:absolute;inset:0;background:rgba(35,35,35,.4)}.sheet{position:relative;box-sizing:border-box;background:var(--surface);border-radius:var(--radiusSheet) var(--radiusSheet) 0 0;padding:var(--panelInset) var(--pageGutter) calc(var(--panelInset) + env(safe-area-inset-bottom));width:100%;max-height:88vh;overflow:auto}.handle{width:72rpx;height:8rpx;border-radius:var(--pill);background:var(--line);margin:0 auto var(--headingGap)}.heading{display:flex;align-items:center;gap:var(--actionGap);margin-bottom:var(--headingGap)}.title{flex:1;min-width:0;font-size:var(--typeSection);font-weight:600;line-height:1.4}.description{display:block;color:var(--muted);font-size:var(--typeFact);line-height:1.7;margin-bottom:var(--headingGap)}
