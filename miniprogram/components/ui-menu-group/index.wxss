.group{margin:var(--itemGap) 0}.surface{background:var(--surface);border-radius:var(--radius);overflow:hidden}.card-header{display:flex;align-items:flex-start;gap:var(--actionGap);padding:var(--panelInset) var(--panelInset) var(--headingGap)}.title{display:block;flex:1;min-width:0;overflow-wrap:anywhere;font-size:var(--typeFact);color:var(--muted);line-height:1.5}.header-actions{flex:none;max-width:45%}
