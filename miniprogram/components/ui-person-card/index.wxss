.person-card{box-sizing:border-box;display:inline-block;vertical-align:top;width:var(--stickerWidth);min-height:var(--stickerHeight);margin:0 var(--actionGap) var(--spaceUnit) 0;padding:var(--headingGap);border:0;border-radius:var(--radius);background:var(--peopleSurface);color:var(--ink);white-space:normal;text-align:left}
.person-reason{display:block;max-width:100%;margin:0 0 var(--actionGap);font-size:var(--typeLabel);line-height:1.4;color:var(--muted);white-space:normal;overflow-wrap:anywhere}
.person-action{flex:none;align-self:center;max-width:140rpx}

.in-rail{flex:none;margin:0}
