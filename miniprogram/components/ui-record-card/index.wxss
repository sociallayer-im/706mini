.record-card{box-sizing:border-box;padding:var(--panelInset);margin-bottom:var(--itemGap);border:0;border-radius:var(--radius);background:var(--surface);color:var(--ink)}
.record-title{display:block;margin-top:var(--spaceUnit);font-size:var(--typeSection);font-weight:600;line-height:1.4;white-space:normal;overflow-wrap:anywhere}
.record-description,.record-meta{display:block;margin-top:var(--spaceUnit);font-size:var(--typeFact);line-height:1.7;color:var(--muted);white-space:pre-line;overflow-wrap:anywhere}
.record-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--actionGap)}
.is-interactive.is-pressed{background:var(--control)}

.record-cover{display:block;width:100%;height:var(--eventArtHeight);margin-bottom:var(--headingGap);border-radius:var(--radiusImage);background:var(--control)}
.record-eyebrow{display:block;font-size:var(--typeFact);line-height:1.6;color:var(--muted)}
.record-description.is-prose{font-size:var(--typeBody);color:var(--ink)}
.has-side-actions .record-layout{display:flex;align-items:flex-start;gap:var(--actionGap)}.record-copy{flex:1;min-width:0}.has-side-actions .record-actions{flex:none;max-width:45%;min-width:0;align-self:flex-start;flex-direction:column;align-items:flex-end;justify-content:flex-end}
