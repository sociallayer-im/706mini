<view style="{{theme}}" class="record-card {{interactive ? 'is-interactive' : ''}}" role="{{interactive ? 'button' : ''}}" aria-label="{{interactive ? title : ''}}" aria-disabled="{{interactive && (disabled || loading)}}" aria-busy="{{loading}}" hover-class="{{interactive && !disabled && !loading ? 'is-pressed' : ''}}" bindtap="press">
 <block wx:if="{{!custom}}"><image wx:if="{{cover}}" class="record-cover" src="{{cover}}" mode="aspectFit"/><text wx:if="{{eyebrow}}" class="record-eyebrow">{{eyebrow}}</text><ui-badge wx:if="{{status}}" label="{{status}}" tone="{{tone}}"/><text wx:if="{{title}}" class="record-title">{{title}}<text wx:if="{{interactive}}" aria-hidden="true"> ›</text></text><text wx:if="{{description}}" class="record-description {{prose ? 'is-prose' : ''}}">{{description}}</text><text wx:if="{{meta}}" class="record-meta">{{meta}}</text></block>
 <view class="record-content" catchtap="stop"><slot/></view><view class="record-actions" catchtap="stop"><slot name="actions"/></view>
</view>
