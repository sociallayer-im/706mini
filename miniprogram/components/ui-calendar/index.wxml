<view style="{{theme}}" class="calendar {{month ? 'month' : 'week'}}" aria-hidden="{{hidden}}"><slot name="header"/><view class="grid weekdays"><text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'blank' : ''}}"><button size="mini" class="number" aria-label="{{item.date}}" aria-pressed="{{item.selected}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="select">{{item.label}}</button><text class="count">{{item.count ? item.count + (locale === 'en' ? '' : ' 场') : ' '}}</text></view></view><view class="disclosure"><button size="mini" class="disclosure-hit" hover-class="is-pressed" aria-label="{{month ? (locale === 'en' ? 'Collapse to week' : '收起为周历') : (locale === 'en' ? 'Expand to month' : '展开为月历')}}" aria-expanded="{{month}}" disabled="{{disabled}}" bindtap="toggle"><image class="expand-arrow {{month ? 'is-expanded' : ''}}" src="/assets/community-icons/back.png" aria-hidden="true"/></button></view></view>
