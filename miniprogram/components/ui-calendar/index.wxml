<view style="{{theme}}" class="calendar {{month ? 'month' : 'week'}}" aria-hidden="{{hidden}}"><view class="grid weekdays"><text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'blank' : ''}}"><button size="mini" class="number" aria-label="{{item.date}}" aria-pressed="{{item.selected}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="select">{{item.label}}</button><text class="count">{{item.count ? item.count + (locale === 'en' ? '' : ' 场') : ' '}}</text></view></view></view>
