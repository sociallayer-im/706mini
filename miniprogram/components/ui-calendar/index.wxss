.calendar{background:var(--surface);padding:var(--headingGap);border-radius:var(--radius)}.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.weekdays{color:var(--muted);font-size:var(--typeMeta);text-align:center;padding:var(--spaceUnit) 0}.day{display:flex;align-items:center;flex-direction:column;min-width:0;border-radius:var(--radiusInput);padding:var(--spaceUnit) 0}.selected{background:var(--accent)}.blank{opacity:.4}.number{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:var(--touchTarget);min-height:var(--touchTarget);margin:0;padding:0;border:0;background:transparent;font-size:var(--typeFact);color:var(--ink);line-height:1.5}.number::after{border:0}.count{font-size:var(--typeLabel);color:var(--muted);min-height:var(--typeFact)}
