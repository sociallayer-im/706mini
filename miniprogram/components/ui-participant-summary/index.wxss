.summary{display:flex;align-items:center;gap:var(--actionGap);padding:var(--panelInset);background:var(--surface);border-radius:var(--radius);margin-bottom:var(--itemGap)}.avatars{display:flex;flex:none;padding-left:var(--spaceUnit)}.avatar{margin-left:calc(0px - var(--spaceUnit));border:var(--stroke) solid var(--surface);border-radius:50%}.label{flex:1;min-width:0;font-size:var(--typeBody);line-height:1.5}.chevron{width:var(--iconControlGlyph);height:var(--iconControlGlyph);transform:rotate(180deg)}
