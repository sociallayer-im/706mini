/* Native mini + explicit width reset prevent the platform default button width. */
.control{box-sizing:border-box;display:inline-flex;flex:0 0 auto;align-items:center;justify-content:center;align-self:flex-start;width:auto;max-width:100%;min-width:var(--touchTarget);min-height:var(--touchTarget);height:auto;margin:0;padding:0;border:0;border-radius:var(--pill);background:transparent;color:var(--ink);font-size:var(--typeBody);font-weight:var(--actionWeight);line-height:1.5;white-space:normal;vertical-align:middle;overflow:visible;pointer-events:auto}
.control::after{border:0}
.control-face{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:var(--spaceUnit);width:auto;max-width:100%;min-height:var(--controlHeight);padding:var(--actionGap) var(--controlStandardInset);border-radius:var(--pill);background:var(--control);transition:opacity var(--pressDuration) ease-out}
.control-label{min-width:0;overflow-wrap:anywhere}
.variant-primary .control-face{background:var(--accent)}
.context-canvas.variant-selection .control-face{background:var(--surface)}
.variant-text .control-face{background:transparent}
.variant-danger .control-face{background:var(--control)}
.variant-danger{color:var(--danger)}
.variant-selection.is-selected .control-face{background:var(--ink);color:var(--surface)}
.is-compact{font-size:var(--typeFact)}
.is-compact .control-face{min-height:var(--controlCompactHeight);padding:var(--spaceUnit) var(--controlCompactInset)}
.is-block,.is-block .control-face{width:100%}
.is-pressed .control-face{opacity:var(--pressOpacity)}
.is-disabled{color:var(--muted)}
.is-disabled .control-face{background:var(--control)}
.spinner{box-sizing:border-box;flex:none;width:var(--typeFact);height:var(--typeFact);border:var(--stroke) solid currentColor;border-right-color:transparent;border-radius:50%;animation:button-spin var(--loadingDuration) linear infinite}
@keyframes button-spin{to{transform:rotate(360deg)}}

.align-start{justify-content:flex-start}.align-start .control-face{justify-content:flex-start;text-align:left}
.align-start.variant-text .control-face{padding-left:0;padding-right:0}.control-icon{flex:none;width:var(--iconControlGlyph);height:var(--iconControlGlyph)}

.is-grow{flex:1 1 0%;min-width:var(--touchTarget)}

/* grow fills both native hit box and painted face; inline buttons stay intrinsic. */
.is-grow .control-face{width:100%;flex:1;min-width:0}
