<button size="mini" open-type="{{openType}}" form-type="{{formType}}" style="{{theme}};display:inline-flex;width:{{block ? '100%' : 'auto'}};min-width:var(--touchTarget);min-height:var(--touchTarget);height:auto;margin:0;padding:0;background:transparent;line-height:1.5;font-weight:var(--actionWeight);white-space:normal;font-size:{{compact ? 'var(--typeFact)' : 'var(--typeBody)'}}" class="control variant-{{variant}} context-{{context}} align-{{align}} {{compact ? 'is-compact' : ''}} {{block ? 'is-block' : ''}} {{grow ? 'is-grow' : ''}} {{selected ? 'is-selected' : ''}} {{disabled ? 'is-disabled' : ''}}" disabled="{{disabled || loading}}" hover-class="is-pressed" catchtap="press" aria-label="{{(label) || ''}}" aria-busy="{{loading}}" aria-pressed="{{variant === 'selection' ? selected : undefined}}">
 <view class="control-face"><view wx:if="{{loading}}" class="spinner" aria-hidden="true"/><image wx:if="{{icon}}" class="control-icon" src="{{icon}}" aria-hidden="true"/><slot wx:if="{{custom}}"/><text wx:else class="control-label">{{label}}</text></view>
</button>
