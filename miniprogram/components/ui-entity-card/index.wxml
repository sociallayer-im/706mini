<view style="{{theme}}" class="entity-card variant-{{variant}} {{disabled ? 'is-disabled' : ''}}" role="{{interactive ? 'button' : ''}}" aria-label="{{interactive ? (item.name || item.title) : ''}}" aria-disabled="{{interactive && disabled}}" bindtap="press">
 <image wx:if="{{variant === 'cover' && item.cover_url}}" class="entity-cover" src="{{item.cover_url}}" mode="aspectFill"/><view wx:if="{{variant === 'cover'}}" class="entity-shade"/>
 <view class="entity-body"><block wx:if="{{!custom}}"><text wx:if="{{item.cityLabel || item.city}}" class="entity-meta">{{item.cityLabel || item.city}}{{item.district ? ' · ' + item.district : ''}}</text><text class="entity-title">{{item.name || item.title}}</text><text wx:if="{{item.introduction}}" class="entity-description">{{item.introduction}}</text><text wx:if="{{item.event_count !== undefined && item.event_count !== null}}" class="entity-count">{{item.event_count}} {{locale === 'en' ? 'events' : '场活动'}}</text></block><view class="entity-custom" catchtap="stop"><slot/></view><view class="entity-actions" catchtap="stop"><slot name="actions"/></view></view>
</view>
