.strip{box-sizing:border-box;width:calc(100% + var(--pageGutter) + var(--pageGutter));margin-top:24rpx;margin-left:calc(0rpx - var(--pageGutter));margin-right:calc(0rpx - var(--pageGutter));white-space:nowrap}
.track{box-sizing:border-box;display:inline-flex;align-items:flex-start;gap:var(--actionGap);min-width:100%;width:max-content;padding-left:var(--pageGutter);padding-right:var(--pageGutter);white-space:nowrap}
.item{display:flex;flex-direction:column;align-items:center;flex:none;width:120rpx;min-width:120rpx;max-width:120rpx}
