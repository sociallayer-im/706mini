<view style="{{theme}}" class="feed"><ui-identity-row src="{{(item.author.avatar_url) || ''}}" custom interactive bind:press="author"><text class="identity-copy"><text class="subject">{{item.feedIdentity.subject}}</text>{{locale === 'en' ? ' ' : ''}}{{item.feedIdentity.action}}</text><text class="identity-time">{{(item.display_time || item.notificationTime) + ' · ' + cityName}}</text></ui-identity-row><text wx:if="{{item.text}}" class="text">{{item.text}}</text><ui-event-card wx:if="{{item.event}}" e="{{item.event}}" t="{{t}}" illustrations="{{illustrations}}" bind:interaction="forward"/></view>
