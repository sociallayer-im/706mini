.stat{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:var(--touchTarget);min-width:var(--touchTarget);height:auto;font-size:var(--typeBody);font-weight:400;margin:0;padding:var(--spaceUnit) var(--headingGap);background:transparent;border:0;color:var(--ink);line-height:1.5}.stat::after{border:0}.value{display:block;margin:0;padding:0;line-height:1.5;font-size:var(--typeSection);font-weight:600}.label{display:block;margin:0;padding:0;line-height:1.5;font-weight:400;font-size:var(--typeFact);color:var(--muted)}
