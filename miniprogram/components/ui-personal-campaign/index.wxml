<view class="campaign-item" style="{{theme}}"><text class="state">{{item.statusLabel}}</text><view class="title" role="button" bindtap="open" hover-class="is-pressed">{{item.title}}</view><text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text><view class="actions"><ui-button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" label="{{t.edit}}" variant="primary" compact bind:press="edit"/><ui-button wx:if="{{item.status === 'PUBLISHED'}}" label="{{locale === 'en' ? 'Manage' : '管理'}}" variant="primary" compact bind:press="edit"/><ui-button label="{{t.progress}}" compact bind:press="progress"/><ui-button label="{{t.deleteCampaign}}" variant="text" compact bind:press="remove" disabled="{{busy}}"/></view></view>
