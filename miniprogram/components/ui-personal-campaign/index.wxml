<view class="campaign-item" style="{{theme}}"><text class="state">{{item.statusLabel}}</text><view class="title" role="button" bindtap="open" hover-class="is-pressed">{{item.title}}</view><text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text><view class="actions"><ui-button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" label="{{t.edit}}" variant="primary" compact bind:press="edit"/><ui-button label="{{t.progress}}" compact bind:press="progress"/></view></view>
