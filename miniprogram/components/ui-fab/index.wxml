<view style="{{theme}}" class="fab-position"><button size="mini" style="display:flex;width:var(--fabSize);height:var(--fabSize);min-width:var(--touchTarget);min-height:var(--touchTarget);margin:0;padding:0;line-height:1" class="fab-hit {{disabled ? 'is-disabled' : ''}}" disabled="{{disabled || loading}}" aria-label="{{(label) || ''}}" aria-busy="{{loading}}" hover-class="is-pressed" bindtap="press"><view class="fab-face"><view wx:if="{{loading}}" class="spinner" aria-hidden="true"/><image wx:elif="{{icon}}" class="fab-icon" src="{{icon}}" aria-hidden="true"/><block wx:else><slot/></block></view></button></view>
