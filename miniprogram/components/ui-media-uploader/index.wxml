<view style="{{theme}}" class="uploader">
 <view class="media-grid"><view wx:for="{{media}}" wx:for-item="asset" wx:for-index="assetIndex" wx:key="index" class="media-tile {{route === 'campaign-edit' && assetIndex === 0 ? 'series-cover-tile' : ''}} {{dragIndex === assetIndex ? 'is-dragging' : ''}} {{dragIndex >= 0 && dragTarget === assetIndex && dragIndex !== assetIndex ? 'is-drop-target' : ''}}" style="{{dragIndex === assetIndex ? 'transform:translate3d(' + dragX + 'px,' + dragY + 'px,0)' : ''}}" data-index="{{assetIndex}}" data-handler="mediaTouchStart" bindtouchstart="dispatch" bindlongpress="dragStart" catchtouchmove="move" bindtouchend="end" bindtouchcancel="cancel">
  <image wx:if="{{asset.type === 'image'}}" class="asset" src="{{asset.url}}" mode="aspectFill"/>
  <video wx:elif="{{asset.type === 'video'}}" class="asset" src="{{asset.url}}" controls/>
  <input wx:else class="media-link" bindkeyboardheightchange="keyboard" cursor-spacing="24" value="{{asset.url}}" placeholder="https://" data-index="{{assetIndex}}" data-handler="mediaLinkInput" bindinput="dispatch" disabled="{{busy}}" aria-label="{{locale === 'en' ? 'Media link' : '媒体链接'}}"/>
  <text wx:if="{{assetIndex === mediaCoverIndex}}" class="cover-label">{{locale === 'en' ? 'Cover' : '封面'}}</text>
  <view class="remove" catchtouchstart="ignore" catchlongpress="ignore"><ui-icon-button icon="{{illustrations.remove}}" label="{{t.delete || (locale === 'en' ? 'Delete' : '删除')}}" size="{{22}}" disabled="{{busy}}" data-index="{{assetIndex}}" data-handler="mediaRemove" bind:press="dispatch"/></view>
 </view></view>
 <ui-button wx:if="{{route === 'campaign-edit'}}" label="{{locale === 'en' ? 'Change series cover' : '更换系列封面'}}" data-key="media" data-type="image" data-replace="{{true}}" data-handler="upload" bind:press="dispatch" disabled="{{busy}}" loading="{{busy}}"/>
 <view class="actions"><ui-button compact label="{{locale === 'en' ? 'Select images' : '多选图片'}}" data-key="media" data-type="image" data-handler="upload" bind:press="dispatch" disabled="{{busy}}" loading="{{busy}}"/><ui-button wx:if="{{formKind === 'event'}}" compact label="{{locale === 'en' ? 'Link' : '链接'}}" data-handler="mediaLink" bind:press="dispatch" disabled="{{busy}}"/></view>
 <text class="hint">{{formKind === 'event' ? (locale === 'en' ? 'Up to 9 images and 3 links. Hold and drag to reorder. First image is the cover.' : '最多 9 张图片和 3 个外部链接；长按图片拖动排序，第一张作为活动封面。') : (locale === 'en' ? 'Up to 12 images. Hold and drag to reorder. First image is the campaign cover.' : '正文最多 12 张图片；长按图片拖动排序，第一张作为专题封面。')}}</text>
</view>
