.uploader{color:var(--ink)}.media-grid{position:relative;display:flex;flex-wrap:wrap;gap:var(--actionGap);margin-bottom:var(--headingGap)}.media-tile{box-sizing:border-box;flex:none;width:184rpx;height:184rpx;position:relative;background:var(--control);border-radius:var(--radiusImage);overflow:hidden}.asset{width:100%;height:100%}.media-link{box-sizing:border-box;width:100%;height:100%;padding:var(--spaceUnit);font-size:var(--typeMeta);color:var(--ink);background:var(--surface)}.remove{position:absolute;right:0;top:0;z-index:6}.actions{display:flex;gap:var(--actionGap);flex-wrap:wrap;align-items:center}.hint{display:block;color:var(--muted);font-size:var(--typeFact);line-height:1.7;margin-top:var(--spaceUnit);overflow-wrap:anywhere}.is-dragging{z-index:5;opacity:.9;outline:3rpx solid var(--accent);overflow:visible}.is-dragging .asset{border-radius:var(--radiusImage)}.is-drop-target{outline:4rpx dashed var(--ink);outline-offset:4rpx}.cover-label{position:absolute;bottom:var(--spaceUnit);left:var(--spaceUnit);padding:2rpx var(--headingGap);border-radius:var(--pill);background:var(--accent);color:var(--ink);font-size:var(--typeLabel);pointer-events:none}
