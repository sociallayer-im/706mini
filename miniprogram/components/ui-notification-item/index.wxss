.group{display:block;font-size:var(--typeSection);font-weight:600;margin:var(--itemGap) 0}.notification{padding:var(--panelInset) 0;border-bottom:var(--stroke) solid var(--line)}.attention{padding:var(--panelInset);border-radius:var(--radius);background:var(--surface);border-bottom:0;margin-bottom:var(--itemGap)}.heading{display:flex;align-items:center;gap:var(--actionGap);margin-bottom:var(--headingGap)}.source{flex:1;min-width:0;font-size:var(--typeFact);color:var(--muted)}.time{font-size:var(--typeMeta);color:var(--muted)}.unread{font-size:var(--typeLabel)}.title{display:block;font-size:var(--typeBody);font-weight:600;line-height:1.5}.read .title{font-weight:400}.body{display:block;font-size:var(--typeFact);color:var(--muted);line-height:1.7;margin-top:var(--spaceUnit)}.link{color:var(--ink);font-weight:600}.cta{display:block;font-size:var(--typeFact);margin-top:var(--headingGap)}
