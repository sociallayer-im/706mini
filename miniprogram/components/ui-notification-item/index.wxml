<view style="{{theme}}"><text wx:if="{{item.notificationGroup}}" class="group">{{item.notificationGroup}}</text><view class="notification {{item.needsAttention ? 'attention' : 'quiet'}} {{item.status === 'READ' ? 'read' : ''}}" role="button" hover-class="is-pressed" bindtap="press"><view class="heading"><ui-avatar wx:if="{{item.actor.avatar_url}}" src="{{item.actor.avatar_url}}" name="{{item.actor.display_name}}" size="24"/><text class="source">{{item.actor.display_name || t[item.category]}}</text><text class="time">{{item.notificationTime}}</text><text wx:if="{{item.status === 'UNREAD'}}" class="unread" aria-label="{{locale === 'en' ? 'Unread' : '未读'}}">●</text></view><text class="title">{{item.title || t[item.key]}}</text><text wx:if="{{item.notificationParts}}" class="body">{{item.notificationParts[0]}}<text class="link">{{item.notificationParts[1]}}</text>{{item.notificationParts[2]}}</text><text wx:else class="body">{{item.description}}</text><text class="cta">{{locale === 'en' ? 'View details' : '查看详情'}} ›</text></view></view>
