.bar{position:fixed;bottom:0;left:0;right:0;z-index:8;padding:var(--actionGap) var(--pageGutter) calc(var(--actionGap) + env(safe-area-inset-bottom));pointer-events:none}.surface{display:flex;flex-wrap:wrap;align-items:center;gap:var(--actionGap);padding:var(--actionGap);background:var(--navigationSurface);backdrop-filter:blur(var(--navigationBlur));border-radius:var(--pill);pointer-events:auto}
