<view class="review-history" style="{{theme}}">
 <view class="intro"><text class="state">{{subject.statusLabel}}</text><text class="title">{{subject.title}}</text><text wx:if="{{subject.submitted_display}}" class="meta">{{subject.submitted_display}}</text><text class="guidance">{{subject.reviewGuidance}}</text><view wx:if="{{subject.status === 'CHANGES_REQUESTED' || subject.status === 'DRAFT'}}" class="actions"><ui-button label="{{locale === 'en' ? 'Edit and resubmit' : '修改并重新提交'}}" variant="primary" compact bind:press="edit"/></view></view>
 <text class="section-title">{{locale === 'en' ? 'Review records' : '审核记录'}}</text>
 <view wx:if="{{entries.length}}" class="records"><view wx:for="{{entries}}" wx:key="id" class="entry {{index ? 'has-divider' : ''}}"><view class="record-heading"><text class="scope">{{item.label}}</text><text class="state">{{item.statusLabel}}</text></view><text wx:if="{{item.note}}" class="note">{{item.note}}</text><text wx:if="{{item.date}}" class="meta">{{item.date}}</text></view></view>
 <text wx:else class="guidance">{{locale === 'en' ? 'Review records will appear here after submission.' : '提交审核后，这里会显示每一方的处理记录。'}}</text>
</view>
