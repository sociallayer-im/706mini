<view class="review-history" style="{{theme}}">
 <view class="intro"><view class="intro-copy"><ui-badge label="{{subject.statusLabel}}" tone="{{subject.statusTone}}"/><text class="title">{{subject.title}}</text><text wx:if="{{subject.submitted_display}}" class="meta">{{subject.submitted_display}}</text><text class="guidance">{{subject.reviewGuidance}}</text></view><view wx:if="{{subject.status === 'CHANGES_REQUESTED' || subject.status === 'DRAFT'}}" class="actions"><ui-button label="{{locale === 'en' ? 'Edit and resubmit' : '修改并重新提交'}}" variant="primary" compact bind:press="edit"/></view></view>
 <text class="section-title">{{campaign ? (locale === 'en' ? 'Review records' : '审核记录') : (locale === 'en' ? 'Group review' : '小组审核')}}</text>
 <view wx:if="{{entries.length}}" class="records"><view wx:for="{{entries}}" wx:key="id" class="entry {{index ? 'has-divider' : ''}}"><view class="record-heading"><text class="scope">{{item.label}}</text><ui-badge label="{{item.statusLabel}}" tone="{{item.tone}}"/></view><text wx:if="{{item.note}}" class="note">{{item.note}}</text><text wx:if="{{item.date}}" class="meta">{{item.date}}</text></view></view>
 <text wx:else class="guidance">{{campaign ? (locale === 'en' ? 'Review records will appear here after submission.' : '提交审核后，这里会显示每一方的处理记录。') : (locale === 'en' ? 'The group review result will appear here after submission.' : '提交审核后，这里会显示小组的审核结果。')}}</text>
</view>
