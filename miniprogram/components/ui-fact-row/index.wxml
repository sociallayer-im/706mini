<view style="{{theme}}" class="fact-row" role="{{interactive ? 'button' : ''}}" aria-label="{{interactive ? label : ''}}" bindtap="press" hover-class="{{interactive ? 'is-pressed' : ''}}"><image wx:if="{{icon}}" class="icon" src="{{icon}}" aria-hidden="true"/><view class="copy"><text class="label">{{label}}</text><text wx:if="{{description}}" class="description">{{description}}</text></view><text wx:if="{{interactive}}" class="chevron" aria-hidden="true">›</text></view>
