.fact-row{display:flex;align-items:flex-start;gap:var(--headingGap);min-height:var(--touchTarget);padding:var(--actionGap) 0;color:var(--ink)}.icon{flex:none;width:var(--iconControlGlyph);height:var(--iconControlGlyph);margin-top:var(--spaceUnit)}.copy{flex:1;min-width:0}.label{display:block;margin:0;font-size:var(--typeBody);font-weight:500;line-height:1.5;overflow-wrap:anywhere}.description{display:block;margin-top:var(--spaceUnit);font-size:var(--typeFact);color:var(--muted);line-height:1.6;white-space:pre-line;overflow-wrap:anywhere}.chevron{flex:none;color:var(--muted);font-size:var(--typeSection);line-height:1.5}.is-pressed{opacity:var(--pressOpacity)}
