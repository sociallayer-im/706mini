<button size="mini" style="{{theme}};display:flex;align-items:center;width:100%;min-height:var(--touchTarget);margin:0;padding:var(--headingGap);border:0;border-radius:var(--pill);background:var(--surface);font-size:var(--typeBody);line-height:1.5;white-space:normal" class="picker" open-type="chooseAvatar" bindchooseavatar="choose" disabled="{{disabled}}" aria-label="{{locale === 'en' ? 'Choose or change photo' : '选择或更换头像'}}"><ui-avatar src="{{src || ''}}" name="{{name || '+'}}" size="{{56}}"/><text>{{src ? (locale === 'en' ? 'Change photo' : '更换头像') : (locale === 'en' ? 'Choose photo · optional' : '选择头像 · 选填')}}</text></button>
