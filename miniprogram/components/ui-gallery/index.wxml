<view class="gallery" style="{{theme}}"><swiper class="swiper" current="{{current}}" bindchange="change" indicator-dots="{{urls.length > 1}}" indicator-color="rgba(255,255,255,.6)" indicator-active-color="{{accent}}" autoplay="{{false}}" circular="{{false}}" aria-label="{{label || (locale === 'en' ? 'Event photos' : '活动图片')}}"><swiper-item wx:for="{{urls}}" wx:key="*this"><image class="image" src="{{item}}" mode="aspectFit" data-index="{{index}}" bindtap="preview"/></swiper-item></swiper><text wx:if="{{urls.length > 1}}" class="counter">{{current + 1}} / {{urls.length}}</text></view>
