.select{box-sizing:border-box;display:flex;align-items:center;gap:var(--actionGap);width:100%;max-width:100%;min-width:0;min-height:var(--controlHeight);padding:var(--fieldInsetBlock) var(--fieldInsetInline);border:var(--stroke) solid var(--line);border-radius:var(--radiusField);background:var(--surface);color:var(--ink)}.label{flex:1;min-width:0;font-size:var(--typeFact);line-height:var(--fieldLineHeight)}.chevron{width:var(--iconControlGlyph);height:var(--iconControlGlyph);transform:rotate(-90deg)}

.shape-pill{border-radius:var(--radiusField)}
