<view style="{{theme}}" class="action-row-shell context-{{context}} {{divider ? 'has-divider' : ''}}">
 <button size="mini" style="display:flex;width:100%;min-height:var(--touchTarget);margin:0;padding:{{context === 'canvas' ? '0' : 'var(--headingGap) var(--panelInset)'}};font-size:var(--typeBody);line-height:1.5" class="action-row tone-{{tone}} {{disabled || loading ? 'is-disabled' : ''}}" aria-label="{{label}}" disabled="{{disabled || loading}}" loading="{{loading}}" hover-class="is-pressed" bindtap="onPress">
  <view class="action-row-copy"><text class="action-row-label">{{label}}</text><text wx:if="{{description}}" class="action-row-description">{{description}}</text><text wx:if="{{detail}}" class="action-row-description">{{detail}}</text></view>
  <image wx:if="{{navigation}}" class="action-row-chevron" src="{{chevron}}" aria-hidden="true"/>
 </button>
</view>
