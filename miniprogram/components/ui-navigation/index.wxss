.shell{position:fixed;left:0;right:0;bottom:0;z-index:7;padding:var(--navigationGutter) var(--pageGutter) calc(var(--navigationBottomInset) + env(safe-area-inset-bottom));pointer-events:none}.capsule{position:relative;z-index:1;display:flex;gap:var(--spaceUnit);padding:var(--spaceUnit);border-radius:var(--pill);background:var(--navigationSurface);-webkit-backdrop-filter:blur(var(--navigationBlur));backdrop-filter:blur(var(--navigationBlur));pointer-events:auto}.tab{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:var(--spaceUnit);min-width:0;min-height:var(--tabHeight);padding:var(--spaceUnit);margin:0;border:0;border-radius:var(--pill);background:transparent;color:var(--ink);line-height:1.4}.tab::after{border:0}.selected{background:var(--accent)}.icon{width:var(--tabIconSize);height:var(--tabIconSize)}.label{font-size:var(--typeFact)}

.shell::before{content:"";position:absolute;left:0;right:0;top:calc(var(--navigationGutter) + var(--tabHeight)/2);bottom:0;background:linear-gradient(to bottom,var(--chromeClear) 0,var(--chromeSoft) 72%,var(--canvas) 100%);-webkit-backdrop-filter:blur(var(--navigationBlur));backdrop-filter:blur(var(--navigationBlur));-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 70%);mask-image:linear-gradient(to bottom,transparent 0,#000 70%);pointer-events:none}
