<view style="{{theme}}" class="shell"><view class="capsule" role="tablist"><button wx:for="{{items}}" wx:key="key" class="tab {{current === item.key ? 'selected' : ''}}" role="tab" aria-selected="{{current === item.key}}" data-route="{{item.key}}" catchtap="navigate"><image class="icon" src="{{item.icon}}" aria-hidden="true"/><text class="label">{{item.label}}</text></button></view></view>
