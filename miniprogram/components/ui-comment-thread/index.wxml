<view style="{{theme}}" class="comment-thread surface-{{surface}}"><image class="avatar" src="{{(item.author.avatar_url) || ''}}" data-route="member" bindtap="{{surface === 'sheet' ? '' : 'member'}}"/><view class="comment-content">
 <view class="comment-heading"><text class="comment-author" bindtap="{{surface === 'sheet' ? '' : 'member'}}">{{item.author.display_name}}</text><text wx:if="{{surface === 'sheet'}}" class="meta">{{item.display_time}}</text><text wx:if="{{surface !== 'sheet' && item.badge}}" class="comment-badge">{{item.badge}}</text></view>
 <text class="comment-body">{{item.text}}</text>
 <view wx:if="{{visibleReplies.length}}" class="comment-replies"><view wx:for="{{visibleReplies}}" wx:for-item="reply" wx:key="id" class="comment-reply"><text class="reply-author">{{reply.author.display_name}}：</text><text>{{reply.text}}</text><view wx:if="{{surface !== 'sheet' && reply.owner === currentUser}}" class="reply-actions"><ui-button label="{{t.delete}}" variant="danger" compact data-id="{{reply.id}}" bind:press="removeReply" disabled="{{busy}}" loading="{{busy}}"/></view></view><view wx:if="{{hiddenReplyCount}}" class="reply-expansion"><ui-button variant="secondary" compact expanded="{{expanded}}" label="{{expanded ? (locale === 'en' ? 'Show fewer replies' : '收起回复') : (locale === 'en' ? 'Show ' + hiddenReplyCount + ' more replies' : '展开其余 ' + hiddenReplyCount + ' 条回复')}}" bind:press="toggleReplies"/></view></view>
 <view class="comment-actions"><ui-button label="{{t.reply}}" variant="text" align="start" compact data-kind="comment" data-reply="{{item.id}}" bind:press="reply"/><ui-button wx:if="{{surface !== 'sheet' && item.owner === currentUser}}" label="{{t.delete}}" variant="danger" compact bind:press="remove" disabled="{{busy}}" loading="{{busy}}"/></view>
</view></view>
