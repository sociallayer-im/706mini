.choices{display:flex;gap:14rpx}.layout-tags{flex-flow:row wrap;align-items:center}.layout-list{flex-direction:column;gap:0}.choice{box-sizing:border-box;display:flex;align-items:center;gap:12rpx;min-height:var(--touchTarget);color:var(--ink);font-size:var(--typeFact);line-height:1.5}.choice-tag{display:inline-flex;justify-content:center;max-width:100%;padding:12rpx 20rpx;border:1rpx solid var(--line);border-radius:var(--pill);background:var(--surface)}.choice-row{width:100%;padding:12rpx 0}.choice-tag.is-selected{border-color:var(--ink);background:var(--ink);color:var(--surface)}.choice-control{display:flex;align-items:center;justify-content:center;flex:none;margin:0;line-height:1}.choice-copy{min-width:0}.choice-row .choice-copy{flex:1}.choice-label{display:block;overflow-wrap:anywhere;white-space:normal}.choice-description{display:block;margin-top:6rpx;color:var(--muted);font-size:var(--typeFact);line-height:1.7}.choice-cover{flex:none;width:108rpx;height:108rpx;border-radius:16rpx}.is-disabled{opacity:.45}.choice-tag.is-selected .choice-control{background:var(--surface);border-radius:6rpx}
