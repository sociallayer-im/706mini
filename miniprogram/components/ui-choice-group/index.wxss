.choices{display:flex;gap:14rpx}.layout-tags{flex-flow:row wrap;align-items:center}.layout-list{flex-direction:column;gap:0}.choice{box-sizing:border-box;display:flex;align-items:center;gap:var(--choiceGap);min-height:var(--touchTarget);color:var(--ink);font-size:var(--typeFact);line-height:1.5}.choice-tag{display:inline-flex;justify-content:center;max-width:100%;padding:12rpx var(--choiceInset);border:1rpx solid var(--line);border-radius:var(--pill);background:var(--surface)}.choice-row{width:100%;padding:12rpx 0}.choice-tag.is-selected{border-color:var(--ink);background:var(--ink);color:var(--surface)}.choice-control{display:flex;align-items:center;justify-content:center;flex:none;margin:0;line-height:1}.choice-copy{min-width:0}.choice-row .choice-copy{flex:1}.choice-label{display:block;overflow-wrap:anywhere;white-space:normal}.choice-description{display:block;margin-top:6rpx;color:var(--muted);font-size:var(--typeFact);line-height:1.7}.choice-cover{flex:none;width:108rpx;height:108rpx;border-radius:16rpx}.is-disabled{opacity:.45}

.choice-indicator{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:var(--choiceIndicator);height:var(--choiceIndicator)}.choice-native{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;opacity:0;z-index:1}.choice-mark{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;height:100%;border:var(--stroke) solid var(--ink);border-radius:6rpx;background:transparent}.mode-single .choice-mark{border-radius:50%}.choice-dot{width:20rpx;height:20rpx;border-radius:50%;background:var(--ink)}.choice-tick{width:10rpx;height:20rpx;border-right:3rpx solid var(--surface);border-bottom:3rpx solid var(--surface);transform:translateY(-2rpx) rotate(45deg)}.mode-multiple.is-selected .choice-mark{background:var(--ink)}.choice-tag.is-selected .choice-mark{border-color:var(--surface)}.choice-tag.is-selected .choice-dot{background:var(--surface)}
