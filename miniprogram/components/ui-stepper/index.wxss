.steps{display:flex;gap:var(--actionGap);flex-wrap:wrap;margin:var(--headingGap) 0 var(--itemGap)}.step{display:flex;gap:var(--spaceUnit);align-items:center;color:var(--muted);font-size:var(--typeFact)}.number{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:50%;background:var(--control)}.current{color:var(--ink);font-weight:600}.current .number{background:var(--accent)}.complete .number{background:var(--ink);color:var(--surface)}
