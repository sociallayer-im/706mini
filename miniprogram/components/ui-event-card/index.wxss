.event-card{box-sizing:border-box;padding:var(--eventRim);border:0;border-radius:var(--eventRadius);overflow:hidden;background:var(--invitation);color:var(--ink);margin-bottom:var(--itemGap)}
.event-main{display:flex;gap:0;align-items:stretch}
.event-info{box-sizing:border-box;flex:1;min-width:0;min-height:var(--eventArtHeight);padding:22rpx 18rpx;display:flex;flex-direction:column;align-self:stretch}
.event-title{display:block;flex:none;min-height:0;font-size:var(--typeEvent);line-height:1.3;font-weight:700;letter-spacing:-.5rpx;margin:0 0 14rpx;white-space:normal;overflow-wrap:anywhere}
.event-title-link{box-sizing:border-box;width:100%;max-width:100%;margin:0 0 14rpx;padding:0;border:0;border-radius:0;background:transparent;color:var(--ink);text-align:left;white-space:normal;line-height:1.3}
.event-title-link::after{border:0}
.event-side{display:flex;align-items:center;flex:0 0 var(--eventArtWidth);width:var(--eventArtWidth);min-height:var(--eventArtHeight);background:transparent}
.event-cover{display:block;flex:none;width:var(--eventArtWidth);height:var(--eventArtHeight);border:0;border-radius:var(--eventArtRadius)}
.event-art{overflow:hidden;border-radius:var(--eventArtRadius)}
.placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--control);color:var(--muted);font-size:var(--typeTitle)}
.meta{display:block;font-size:var(--typeMeta);line-height:1.5;color:var(--muted)}
.event-badges{display:flex;flex-wrap:wrap;flex:none;gap:var(--spaceUnit);margin:0 0 12rpx}
.event-capacity{padding:2rpx 9rpx;border:0;border-radius:var(--pill);font-size:var(--typeLabel);line-height:1.4;color:var(--muted);background:var(--control)}
.state-available .event-capacity{background:var(--accentSoft);color:var(--ink)}
.state-waitlist .event-capacity{background:var(--infoSoft);color:var(--info)}
.state-cancelled .event-capacity{background:transparent;color:var(--muted)}
.card-fact{display:flex;flex:none;align-items:flex-start;font-size:var(--typeFact);line-height:1.5;gap:7rpx;margin-top:7rpx;color:var(--ink)}
.fact-illustration{flex:0 0 23rpx;width:23rpx;height:23rpx;margin-top:3rpx}
.fact-copy{flex:1;min-width:0;white-space:normal;overflow-wrap:anywhere}
.card-fee{display:block;flex:none;font-size:var(--typeBody);line-height:1.4;font-weight:600;margin-top:auto;padding-top:var(--actionGap)}
.event-card-large{padding:0}
.event-card-large .event-main{padding:var(--panelInset)}
.event-card-large .event-side,.event-card-large .event-title{display:none}
.large-card-art{height:460rpx;position:relative;overflow:hidden}
.large-cover{width:100%;height:100%}
.large-card-shade{position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(0,0,0,.55))}
.large-card-title{position:absolute;bottom:var(--headingGap);left:var(--headingGap);right:var(--headingGap);font-size:var(--typeEvent);color:var(--surface);font-weight:600;line-height:1.4;overflow-wrap:anywhere}
