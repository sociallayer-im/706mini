.identity{box-sizing:border-box;width:100%;min-width:0;text-align:left;display:flex;align-items:center;gap:var(--identityGap);padding:var(--headingGap) 0}.copy{flex:1;min-width:0}.name{display:block;font-size:var(--typeSection);font-weight:600;line-height:1.4;overflow-wrap:anywhere}.description{display:block;margin-top:var(--spaceUnit);color:var(--muted);font-size:var(--typeBody);line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}.actions{flex:none;align-self:center}
.is-stacked{flex-direction:column;align-items:center;gap:8rpx;width:100%;padding:0;text-align:center}
.is-stacked .copy{flex:none;width:100%}
.is-stacked .name{font-size:var(--typeFact);font-weight:500;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.is-flush{padding:0}

.name-line{display:flex;align-items:center;flex-wrap:wrap;gap:var(--spaceUnit)}.chevron{display:block;flex:none;align-self:center;width:var(--iconControlGlyph);height:var(--iconControlGlyph);margin-left:auto;transform:rotate(180deg)}.is-stacked .name-line{justify-content:center}.is-stacked .name{max-width:100%}

.name-line .name{min-width:0;max-width:100%}
