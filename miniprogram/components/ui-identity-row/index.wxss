.identity{display:flex;align-items:flex-start;gap:var(--actionGap);padding:var(--headingGap) 0}.copy{flex:1;min-width:0}.name{display:block;font-size:var(--typeBody);font-weight:600;line-height:1.4;overflow-wrap:anywhere}.description{display:block;color:var(--muted);font-size:var(--typeFact);line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}.actions{flex:none;align-self:center}
