<view style="{{theme}}" class="identity {{stacked ? 'is-stacked' : ''}} {{flush ? 'is-flush' : ''}}" aria-label="{{name || ''}}" aria-disabled="{{disabled}}" aria-role="{{interactive ? 'button' : ''}}" role="{{interactive ? 'button' : ''}}" bindtap="press"><ui-avatar src="{{(src) || ''}}" name="{{(name) || ''}}" size="{{size}}"/><view class="copy"><block wx:if="{{!custom}}"><view class="name-line"><text class="name">{{name}}</text><ui-badge wx:if="{{typeLabel}}" label="{{typeLabel}}"/></view><text wx:if="{{description}}" class="description">{{description}}</text></block><slot/></view><view class="actions"><slot name="actions"/></view><image wx:if="{{navigation}}" class="chevron" src="/assets/community-icons/back.png" aria-hidden="true"/></view>
