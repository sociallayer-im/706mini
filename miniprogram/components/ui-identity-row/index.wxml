<view style="{{theme}}" class="identity {{stacked ? 'is-stacked' : ''}} {{flush ? 'is-flush' : ''}}" role="{{interactive ? 'button' : ''}}" bindtap="press"><ui-avatar src="{{(src) || ''}}" name="{{(name) || ''}}" size="{{size}}"/><view class="copy"><block wx:if="{{!custom}}"><text class="name">{{name}}</text><text wx:if="{{description}}" class="description">{{description}}</text></block><slot/></view><view class="actions"><slot name="actions"/></view></view>
