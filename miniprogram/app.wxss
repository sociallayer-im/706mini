/* 706 native foundations. Controls and media own their visuals in isolated components.
   Keep only page typography, safe box sizing and still-used business/slot layout here. */
page{background:#F5F5F2;color:#232323;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:28rpx;line-height:1.7}
view,text,button,input,textarea{box-sizing:border-box}
text{overflow-wrap:anywhere}
.screen{box-sizing:border-box;width:100%;min-width:0;padding:32rpx var(--pageGutter) calc(var(--tabBarSpace) + env(safe-area-inset-bottom));min-height:100vh;background:var(--canvas);color:var(--ink);font-size:var(--typeBody)}
.row{display:flex;align-items:center;gap:16rpx}
.section-heading{display:flex;align-items:center;gap:16rpx}
.grow{flex:1;min-width:0}
.section-heading{justify-content:space-between;margin:30rpx 0 20rpx;font-weight:600}
.section-title{display:block;font-size:30rpx;font-weight:600}
.hero-title{display:block;font-size:44rpx;line-height:1.25;font-weight:700;margin:16rpx 0}
.body-text{display:block;white-space:pre-wrap;margin:14rpx 0;line-height:1.75}
.meta{display:block;color:var(--muted);font-size:24rpx;margin-top:6rpx}
.status{display:inline-block;font-size:22rpx;font-weight:600;color:var(--accentText);background:var(--accent);border-radius:8rpx;padding:3rpx 10rpx;margin-bottom:10rpx}
.list-card{background:var(--surface);border-radius:var(--radius);padding:28rpx;margin-bottom:24rpx}
.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#eaeaec;flex-shrink:0}
.people-strip{white-space:nowrap}
.calendar-entry{padding:28rpx;background:var(--accent);border-radius:26rpx;margin-bottom:24rpx}
.chips{white-space:nowrap;margin:14rpx 0}
.chip{display:inline-block;vertical-align:middle;background:transparent;border:1rpx solid var(--line);border-radius:99rpx;margin-right:12rpx;font-size:24rpx;padding:10rpx 20rpx;font-weight:400}
.detail-cover{width:100%;height:440rpx;border-radius:26rpx}
.facts text{display:block;margin:10rpx 0}
.section{padding:26rpx 0}
.label{display:block;font-size:26rpx;font-weight:600;margin-bottom:12rpx}
.login-hero{padding:60rpx 0}
.brand{font-size:100rpx;font-weight:800;letter-spacing:-8rpx}
.poster-preview{width:100%;margin-bottom:24rpx}
.poster-canvas{position:fixed;left:-2000px;top:0;pointer-events:none}
.qr{width:400rpx;margin:20rpx auto}
.screen .chip{width:auto;min-width:0;flex-shrink:0}
.screen .section-heading>text{min-width:0;flex:1}
.calendar-heading{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:600}
.payment-total{display:flex;justify-content:space-between;padding:36rpx 0;font-size:36rpx;font-weight:600}
.sheet-comments{max-height:440rpx}
.mini-logo{display:block;margin-bottom:24rpx}
.repeat-row{display:flex;gap:12rpx;margin-bottom:16rpx}
.review-step{display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}
.review-step>view{flex:1}
.status-dot{width:16rpx;height:16rpx;background:var(--muted);border-radius:50%}
.status-dot.passed{background:var(--accent)}
.screen.reviewing{padding-top:104rpx}
.review-controls{position:fixed;top:0;left:var(--pageGutter);right:var(--pageGutter);z-index:5;background:var(--canvas);display:flex;align-items:center;justify-content:space-between;padding:6rpx 0 16rpx;color:var(--muted);font-size:22rpx}
.settings-intro{padding:24rpx 0 36rpx}
.settings-intro .body-text{color:var(--muted)}
.form-avatar{width:160rpx;height:160rpx;border-radius:50%;margin:28rpx auto;background:var(--control)}
.space-directory-card{position:relative;height:430rpx;border-radius:32rpx;overflow:hidden;margin:28rpx 0;color:white}
.space-directory-card>image{position:absolute;inset:0;width:100%;height:100%}
.space-directory-shade{position:absolute;inset:0;width:100%;height:100%}
.space-directory-shade{background:linear-gradient(180deg,#0001,#000a)}
.space-directory-body{position:relative;padding:36rpx;display:flex;flex-direction:column;height:100%;justify-content:flex-end}
.space-directory-body .meta{color:#ffffffe6}
.avatar-upload{background:var(--control);border-radius:28rpx;padding:28rpx;display:flex;flex-direction:column;align-items:center}
.avatar-upload .form-avatar{margin:0 0 20rpx}
.mine-filter-row{white-space:nowrap;margin:20rpx 0}
.mine-filter-row .chip{display:inline-block;margin-right:12rpx}
.settings-row{display:flex!important;align-items:center;gap:18rpx;width:100%;min-height:100rpx;padding:22rpx 24rpx!important;border-radius:24rpx!important;margin-bottom:12rpx!important;background:#f8f8fa!important;text-align:left!important;font-size:28rpx!important;font-weight:500!important}
.settings-icon{width:60rpx;height:60rpx;background:#fff;border-radius:16rpx;color:#8b9095;font-size:26rpx}
.settings-label{flex:1}
.settings-label>text{display:block}
.self-profile{background:var(--surface);border-radius:28rpx;padding:28rpx}
.self-stats{display:flex;margin-top:26rpx}
.self-stats text:first-child{font-size:38rpx}
.self-stats text:last-child{font-size:24rpx;color:var(--muted)}
.screen .settings-row{width:100%!important;max-width:100%;min-width:0}
.detail-facts{padding:20rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}
.detail-fact{display:flex;align-items:flex-start;gap:20rpx;padding:16rpx 0}
.fact-main{display:block;font-size:28rpx;font-weight:600}
.page-calendar .filters>.chips:first-child{display:flex;align-items:center}
.page-calendar .calendar-period{font-size:26rpx;margin:8rpx 0 22rpx}
.page-calendar .calendar-results-title{margin:24rpx 0 8rpx}
.poster-scroll{flex:1;height:0;min-height:0;margin-top:18rpx}
.poster-actions{flex:none;padding-top:18rpx;display:flex;flex-direction:column;gap:14rpx}
.month-legend{display:flex;justify-content:space-between;color:var(--calendarLegend);font-size:22rpx;margin-top:18rpx}
.month-legend>text:first-child{color:var(--calendarLegendDot)}
.member-hero{background:var(--surface);border-radius:24rpx;padding:28rpx;margin-bottom:28rpx}
.member-avatar{width:112rpx;height:112rpx}
.member-name{display:block;font-size:36rpx;font-weight:600;margin:18rpx 0 16rpx}
.member-city{display:flex;align-items:center;gap:8rpx;font-size:24rpx;line-height:1.6;color:var(--muted)}
.member-intro{display:block;font-size:26rpx;line-height:1.7;margin-top:12rpx}
.member-hero .chips{margin:18rpx 0}
.member-hero .chip{font-size:22rpx;padding:8rpx 16rpx}
.member-actions{margin:24rpx 0}
.member-stats{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--line);padding-top:24rpx}
.member-stats>view{width:33.33%;padding:0;background:transparent;min-height:0;text-align:center;border:0;border-radius:0;line-height:1.5}
.member-stats text{display:block;font-size:30rpx;font-weight:600}
.member-stats text+text{font-size:22rpx;font-weight:400;color:var(--muted);margin-top:4rpx}
.member-section{margin-bottom:32rpx}
.member-section>.section-title{display:block;margin-bottom:16rpx}
.event-secondary-actions{padding:26rpx 0 10rpx}
.screen .settings-row{align-items:center;gap:16rpx}
.settings-icon{flex:none;display:flex;align-items:center;justify-content:center}
.settings-label{min-width:0}

@import "styles/editorial.wxss";
@import "styles/community.wxss";

/* Shared horizontal layout: insets belong to scrollable content, not item margins. */
.horizontal-rail{box-sizing:border-box;min-width:0;white-space:nowrap}
.screen .horizontal-rail.rail-page{flex:none;width:calc(100% + var(--pageGutter) + var(--pageGutter));margin-left:calc(0rpx - var(--pageGutter));margin-right:calc(0rpx - var(--pageGutter))}
.horizontal-track{box-sizing:border-box;display:inline-flex;align-items:flex-start;gap:var(--actionGap);min-width:100%;width:max-content;padding-left:var(--pageGutter);padding-right:var(--pageGutter);vertical-align:top;white-space:nowrap}
.rail-contained .horizontal-track{padding-left:0;padding-right:0;align-items:center}

/* Management actions are right-aligned independently from the record copy. */
.record-side-actions{display:flex;flex-direction:column;align-items:flex-end;gap:var(--actionGap);max-width:100%;min-width:0}.record-side-actions>.row{justify-content:flex-end;flex-wrap:wrap;max-width:100%}
