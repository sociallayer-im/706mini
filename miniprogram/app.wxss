page{background:#f3f3f3;color:#222;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:28rpx;line-height:1.5}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:28rpx;line-height:1.5;border-radius:20rpx;font-weight:600;padding:20rpx 30rpx;white-space:normal}button::after{border:0}button[disabled]{opacity:.4}text{overflow-wrap:anywhere}input,textarea{background:var(--canvas);border:1rpx solid var(--line);border-radius:16rpx;padding:22rpx;width:100%;font-size:28rpx;color:var(--ink)}input{height:88rpx}textarea{min-height:170rpx}image{display:block}.screen{padding:24rpx 28rpx 100rpx;min-height:100vh;background:var(--canvas);color:var(--ink)}.topbar,.row,.section-heading{display:flex;align-items:center;gap:16rpx}.topbar{margin-bottom:32rpx}.city{padding:8rpx 0;background:transparent;flex-shrink:0}.search,.grow{flex:1;min-width:0}.search input{height:66rpx;border-radius:99rpx;background:#e9e9eb;font-size:24rpx;padding:10rpx 24rpx}.icon-button{padding:6rpx 16rpx;background:transparent;font-size:40rpx}.section-heading{justify-content:space-between;margin:30rpx 0 20rpx;font-weight:600}.section-title{display:block;font-size:30rpx;font-weight:600}.hero-title{display:block;font-size:44rpx;line-height:1.25;font-weight:700;margin:16rpx 0}.body-text{display:block;white-space:pre-wrap;margin:14rpx 0;line-height:1.75}.meta{display:block;color:var(--muted);font-size:24rpx;margin-top:6rpx}.status{display:inline-block;font-size:22rpx;font-weight:600;color:var(--accentText);background:var(--accent);border-radius:8rpx;padding:3rpx 10rpx;margin-bottom:10rpx}.primary{background:var(--accent);color:var(--accentText)}.secondary{background:var(--surface);color:var(--ink);border:1rpx solid var(--line)}.small{padding:10rpx 22rpx;font-size:24rpx;background:var(--accent)}.text-button{background:transparent;color:var(--muted);font-size:24rpx;padding:8rpx}.danger{color:var(--danger)}.card,.list-card,.event-card,.profile-card{background:var(--surface);border-radius:var(--radius);padding:28rpx;margin-bottom:24rpx}.event-card{box-shadow:0 4rpx 16rpx #00000008}.event-main{display:flex;gap:24rpx}.event-info{flex:1;min-width:0}.event-title{display:block;font-size:32rpx;font-weight:650;line-height:1.4;margin-bottom:14rpx}.event-cover{width:180rpx;height:240rpx;border-radius:18rpx;flex-shrink:0}.placeholder{display:flex;align-items:center;justify-content:center;background:var(--accent);font-size:46rpx;color:var(--accentText)}.fee{display:block;font-size:26rpx;margin-top:14rpx;font-weight:600}.participant{border-radius:22rpx;background:#eeeef0;padding:16rpx 20rpx;margin-top:20rpx;display:flex;justify-content:space-between;font-size:22rpx;color:var(--muted)}.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#eaeaec;flex-shrink:0}.avatar.large{width:120rpx;height:120rpx}.people-strip,.campaign-strip{white-space:nowrap}.person{display:inline-flex;vertical-align:top;white-space:normal;flex-direction:column;align-items:center;gap:16rpx;background:var(--surface);border-radius:26rpx;margin-right:16rpx;padding:24rpx;width:210rpx;text-align:center}.person .meta{height:60rpx;overflow:hidden}.person .avatar{margin:0 auto 12rpx}.feed-entry>.row{padding:20rpx 10rpx}.calendar-entry{padding:28rpx;background:var(--accent);border-radius:26rpx;margin-bottom:24rpx}.campaign-tile{display:inline-block;vertical-align:top;width:540rpx;white-space:normal;background:var(--surface);border-radius:26rpx;overflow:hidden;margin-right:20rpx;padding-bottom:24rpx}.campaign-tile image{height:200rpx;width:100%;margin-bottom:16rpx}.campaign-tile text{display:block;margin:0 24rpx}.chips{white-space:nowrap;margin:14rpx 0}.chip{display:inline-block;vertical-align:middle;background:transparent;border:1rpx solid var(--line);border-radius:99rpx;margin-right:12rpx;font-size:24rpx;padding:10rpx 20rpx;font-weight:400}.selected{background:var(--accent);color:var(--accentText);border-color:var(--accent)}.calendar-box{background:var(--surface);padding:18rpx;border-radius:26rpx}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.day{text-align:center;height:92rpx;display:flex;flex-direction:column;justify-content:center;border-radius:14rpx}.day.selected{box-shadow:inset 0 0 0 2rpx var(--accentText)}.dot{line-height:16rpx;min-height:16rpx;color:var(--accentText)}.menu{border-radius:26rpx;background:var(--surface);margin:24rpx 0;overflow:hidden}.menu-item{display:flex;justify-content:space-between;padding:28rpx;border-bottom:1rpx solid var(--line)}.profile-card .row{justify-content:space-between}.banner{padding:22rpx;background:var(--accent);border-radius:18rpx;margin:22rpx 0}.detail-cover{width:100%;height:440rpx;border-radius:26rpx}.detail-intro{padding:20rpx 0}.facts text{display:block;margin:10rpx 0}.section{padding:26rpx 0}.comment{border-bottom:1rpx solid var(--line);padding:18rpx 0}.bottom-actions{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--surface);box-shadow:0 -6rpx 24rpx #00000008;z-index:8}.screen.has-bottom{padding-bottom:180rpx}.empty{padding:100rpx 20rpx;display:flex;flex-direction:column;align-items:center;color:var(--muted);text-align:center}.empty-mark{font-size:90rpx;margin-bottom:24rpx;color:var(--accentText)}.fab{position:fixed;right:32rpx;bottom:50rpx;border-radius:26rpx;width:100rpx;height:100rpx;padding:10rpx;background:var(--accent);color:var(--accentText);font-size:56rpx;box-shadow:0 8rpx 24rpx #00000012}.error{background:#fff0ee;color:var(--danger);padding:24rpx;border-radius:20rpx;margin:20rpx 0}.error button{margin-top:16rpx;display:inline-block}.skeleton view{height:150rpx;margin:24rpx 0;border-radius:24rpx;background:linear-gradient(90deg,#e8e8ea,#fdfdfd,#e8e8ea)}.steps{display:flex;justify-content:center;gap:80rpx;margin:24rpx 0 36rpx}.step{border-radius:50%;width:54rpx;height:54rpx;display:flex;justify-content:center;align-items:center;border:1rpx solid var(--line)}.field{margin-bottom:30rpx}.label{display:block;font-size:26rpx;font-weight:600;margin-bottom:12rpx}.picker{background:var(--canvas);border-radius:14rpx;padding:20rpx;font-size:26rpx}.checkbox-row{display:flex;align-items:center;gap:12rpx;margin:22rpx 0;font-size:24rpx}.login-hero{padding:60rpx 0}.brand{font-size:100rpx;font-weight:800;letter-spacing:-8rpx}.login-hero+.card>input,.login-hero+.card>button{margin-bottom:24rpx}.overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end}.scrim{position:absolute;inset:0;background:#0005}.sheet{position:relative;background:var(--surface);border-radius:36rpx 36rpx 0 0;padding:24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));width:100%;max-height:88vh;overflow:auto}.sheet textarea,.sheet input{margin:20rpx 0}.poster-preview{width:100%;margin-bottom:24rpx}.poster-canvas{position:fixed;left:-2000px;top:0;pointer-events:none}.qr{width:400rpx;margin:20rpx auto}.prose text{display:block;white-space:pre-wrap;line-height:1.9}

/* Override style-v2's button:not([size=mini]) fixed width in native rendering. */
.screen .city,.screen .icon-button,.screen .text-button,.screen .small,.screen .chip{width:auto;min-width:0;flex-shrink:0}
.screen .fab{width:100rpx;min-width:100rpx;height:100rpx}
.screen .row>.primary,.screen .row>.secondary,.screen .bottom-actions>.primary,.screen .bottom-actions>.secondary{width:auto;flex:1;min-width:0}
.screen .error>text{display:block}
