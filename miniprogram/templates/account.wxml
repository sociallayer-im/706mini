<template name="privacyConsent"><ui-checkbox custom secondary checked="{{consent}}" disabled="{{busy}}" label="{{locale === 'en' ? 'Agree to the Privacy Policy' : '同意隐私政策'}}" bind:change="consent"><text>{{profileScope ? (locale === 'en' ? 'I understand which profile information is public and agree to ' : '我已了解资料的公开范围，并同意') : (locale === 'en' ? 'I have read and agree to ' : '我已阅读并同意')}}</text><text class="account-legal-link" role="link" data-document="privacy" catchtap="openAccountDocument">{{locale === 'en' ? 'Privacy Policy' : '《隐私政策》'}}</text></ui-checkbox></template>
<template name="accountStageHeading"><view class="account-heading"><view class="account-step-heading"><text class="hero-title">{{title}}</text><text wx:if="{{step}}" class="account-eyebrow">{{step}} / 3</text></view><text wx:if="{{description}}" class="body-text meta">{{description}}</text></view></template>
<template name="accountIdentityFields">
      <ui-avatar-picker src="{{accountForm.avatar_url || ''}}" name="{{accountForm.display_name || ''}}" locale="{{locale}}" disabled="{{busy}}" bind:chooseavatar="chooseAccountAvatar"/>
      <ui-form-field id="account-name" shape="pill" standalone type="nickname" value="{{accountForm.display_name}}" maxlength="{{40}}" bind:input="accountNickname" bind:change="accountNickname" bind:blur="accountNickname" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'Your name in the community' : '在社区里怎么称呼你'}}" error="{{accountErrors.display_name || ''}}" bind:keyboardheightchange="keyboardChange"/>
</template>
<view wx:if="{{accountOpen}}" class="account-overlay" role="dialog" aria-modal="true" aria-label="{{locale === 'en' ? 'Explore more possibilities in life' : '探索生活的更多可能性'}}">
 <view class="account-backdrop" aria-hidden="true"/>
 <view class="account-overlay-header" style="top:{{navigationTop}}px;height:{{navigationHeight}}px;padding-right:{{menuRightInset}}px">
  <ui-icon-button icon="{{illustrations.back}}" label="{{locale === 'en' ? 'Back' : '返回'}}" size="{{menuHeight}}" surface="plain" disabled="{{busy}}" bind:press="accountBack"/>
 </view>
 <scroll-view scroll-y class="account-overlay-scroll" style="top:{{headerHeight}}px;height:calc(100% - {{headerHeight}}px)" show-scrollbar="{{false}}">
  <view class="account-overlay-content">
   <view wx:if="{{accountPrivacy}}" class="account-fields">
    <text class="hero-title">{{accountDocument.title}}</text><text class="body-text account-document">{{accountDocument.text}}</text>
   </view>
   <block wx:else>
    <text wx:if="{{error}}" class="account-error" role="alert">{{error}}</text>
    <view wx:if="{{accountStage === 'login'}}" class="account-fields">
     <text class="brand">706</text><template is="accountStageHeading" data="{{title:locale === 'en' ? 'Explore more possibilities in life' : '探索生活的更多可能性'}}"/>
     <view class="account-consents">
      <ui-checkbox custom secondary checked="{{activityReminders}}" disabled="{{busy}}" label="{{locale === 'en' ? 'Subscribe to event reminders' : '订阅活动消息提醒'}}" bind:change="activityReminderConsent"><text>{{locale === 'en' ? 'Subscribe to event reminders: receive registration confirmations and upcoming event reminders. Turn off in Settings.' : '订阅活动消息提醒：接受活动报名成功、即将开始等提醒，可在设置中关闭'}}</text></ui-checkbox>
      <ui-checkbox custom secondary checked="{{loginConsent}}" disabled="{{busy}}" label="{{locale === 'en' ? 'Agree to the User Agreement and Privacy Policy' : '同意用户协议和隐私政策'}}" bind:change="loginConsent"><text>{{locale === 'en' ? 'I have read and agree to ' : '我已阅读并同意'}}</text><text class="account-legal-link" role="link" data-document="terms" catchtap="openAccountDocument">{{locale === 'en' ? 'User Agreement' : '《用户协议》'}}</text><text>{{locale === 'en' ? ' and ' : '和'}}</text><text class="account-legal-link" role="link" data-document="privacy" catchtap="openAccountDocument">{{locale === 'en' ? 'Privacy Policy' : '《隐私政策》'}}</text></ui-checkbox>
     </view>
     <ui-button label="{{locale === 'en' ? 'Continue with WeChat' : '微信一键登录'}}" variant="primary" block disabled="{{!loginConsent || busy}}" loading="{{busy}}" bind:press="wechatLogin"/>
     <text wx:if="{{demo}}" class="meta">{{locale === 'en' ? 'Offline demo. No real WeChat authorization.' : '离线演示，不调用真实微信授权。'}}</text>
    </view>
    <view wx:elif="{{accountStage === 'identity'}}" class="account-fields">
     <template is="accountStageHeading" data="{{title:locale === 'en' ? 'Choose your photo and name' : '选择头像和昵称',description:locale === 'en' ? 'Tap the photo or name to use your WeChat details, or choose your own. You can edit them later.' : '点头像或昵称，可选择使用微信资料，也可以自行设置。以后仍可在主页编辑。'}}"/>
     <template is="accountIdentityFields" data="{{accountForm,accountErrors,locale,busy}}"/>
     <ui-button variant="primary" block label="{{locale === 'en' ? 'Confirm and continue' : '确认并继续'}}" disabled="{{busy}}" loading="{{busy}}" bind:press="confirmAccountIdentity"/>
    </view>
    <view wx:elif="{{accountStage === 'phone'}}" class="account-fields">
     <template is="accountStageHeading" data="{{title:locale === 'en' ? 'Phone verification' : '手机号验证',description:locale === 'en' ? 'For account contact and recovery. Your phone stays private.' : '用于账号联系与找回，不会展示在个人主页，也不会自动分享给活动发起人。'}}"/>
     <ui-form-field id="account-phone" shape="pill" standalone type="number" maxlength="{{11}}" value="{{phone}}" placeholder="{{locale === 'en' ? '11-digit mobile number' : '输入 11 位手机号'}}" bind:input="phoneInput" disabled="{{busy}}" bind:keyboardheightchange="keyboardChange"/>
     <ui-button label="{{phoneCooldown ? (locale === 'en' ? 'Resend in ' + phoneCooldown + 's' : phoneCooldown + ' 秒后重发') : phoneCodeSent ? (locale === 'en' ? 'Resend code' : '重新发送验证码') : (locale === 'en' ? 'Send code' : '获取验证码')}}" variant="secondary" block loading="{{busy}}" disabled="{{busy || phoneCooldown > 0}}" bind:press="sendPhoneCode"/><text wx:if="{{phoneCodeSent}}" class="meta" role="status">{{demo ? (locale === 'en' ? 'Demo code: 706000. No SMS is sent.' : '演示验证码：706000，不发送真实短信。') : (locale === 'en' ? 'Code sent. Check your SMS.' : '验证码已发送，请查看短信。')}}</text>
     <ui-form-field id="account-code" shape="pill" standalone type="number" maxlength="{{6}}" value="{{phoneCode}}" bind:input="phoneCodeInput" placeholder="{{locale === 'en' ? '6-digit code' : '输入 6 位验证码'}}" disabled="{{busy}}" bind:keyboardheightchange="keyboardChange"/>
     <ui-button label="{{locale === 'en' ? 'Verify and continue' : '验证并继续'}}" variant="primary" block loading="{{busy}}" disabled="{{busy || !phoneCodeSent}}" bind:press="bindPhone"/>
    </view>
    <view wx:elif="{{accountStage === 'profile'}}" class="account-fields">
     <template is="accountStageHeading" data="{{title:accountQuestion === 1 ? (locale === 'en' ? 'We’d like to get to know you' : '我们想要了解你') : accountQuestion === 2 ? (locale === 'en' ? 'Where are you usually based?' : '你平时在哪里？') : (locale === 'en' ? 'Tell us about yourself!' : '请介绍一下自己吧！'),step:accountQuestion,description:accountQuestion === 1 ? (locale === 'en' ? 'You can edit this information later on your profile.' : '这些信息以后也可以在主页继续编辑。') : accountQuestion === 2 ? (locale === 'en' ? 'Choose your usual city to find people and events nearby. No precise address is needed.' : '选择你常在的城市，方便遇见附近的人和活动，不需要具体地址。') : (locale === 'en' ? 'Your words appear in full on your profile. You can add this later.' : '写写你想让大家知道的事。你的文字会完整保留在个人主页，也可以以后再补充。')}}"/>
     <view hidden="{{accountQuestion !== 1}}" class="account-fields {{accountQuestion !== 1 ? 'is-step-hidden' : ''}}">
      <template is="accountIdentityFields" data="{{accountForm,accountErrors,locale,busy}}"/>
      <ui-form-field id="account-bio" show-count shape="pill" standalone type="area" auto-height="{{true}}" value="{{accountForm.bio}}" maxlength="{{80}}" data-key="bio" bind:input="accountText" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'Introduce yourself in one sentence' : '用一句话介绍你自己'}}" error="{{accountErrors.bio || ''}}" bind:keyboardheightchange="keyboardChange"/>
     </view>
     <view hidden="{{accountQuestion !== 2}}" class="account-fields {{accountQuestion !== 2 ? 'is-step-hidden' : ''}}">
      <ui-select-field shape="pill" range="{{cities}}" range-key="{{locale === 'en' ? 'en' : 'zh'}}" value="{{accountCityIndex || 0}}" label="{{accountCityLabel || (locale === 'en' ? 'Choose a city' : '请选择城市')}}" aria-label="{{locale === 'en' ? 'City' : '所在城市'}}" bind:change="accountCity" disabled="{{busy}}"/><text wx:if="{{accountErrors.city}}" class="field-error" role="alert">{{accountErrors.city}}</text>
     </view>
     <view hidden="{{accountQuestion !== 3}}" class="account-fields {{accountQuestion !== 3 ? 'is-step-hidden' : ''}}">
      <ui-form-field standalone show-count type="area" value="{{accountForm.introduction}}" maxlength="{{300}}" data-key="introduction" bind:input="accountText" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'Start wherever you like' : '从哪里说起都可以'}}" error="{{accountErrors.introduction || ''}}" bind:keyboardheightchange="keyboardChange"/>
      <template is="privacyConsent" data="{{consent,busy,locale,profileScope:true}}"/><text wx:if="{{accountErrors.privacy}}" class="field-error" role="alert">{{accountErrors.privacy}}</text>
     </view>
     <view class="account-actions"><ui-button label="{{accountQuestion < 3 ? (locale === 'en' ? 'Continue' : '继续') : (locale === 'en' ? 'Finish' : '完成')}}" variant="primary" block disabled="{{busy}}" loading="{{busy}}" bind:press="{{accountQuestion < 3 ? 'accountNext' : 'completeAccount'}}"/></view>
    </view>
    <view wx:elif="{{accountStage === 'welcome'}}" class="account-fields"><template is="accountStageHeading" data="{{title:locale === 'en' ? 'All set! Welcome.' : '已完成！欢迎你'}}"/><view class="account-actions"><ui-button label="{{locale === 'en' ? 'Let’s go' : '开始吧'}}" variant="primary" block bind:press="finishAccountWelcome"/></view></view>
   </block>
  </view>
 </scroll-view>
</view>
