<view wx:if="{{guest && (route === 'me' || route === 'messages')}}" class="account-guest card">
 <text class="hero-title">{{locale === 'en' ? 'Welcome to 706' : '欢迎来到 706'}}</text><text class="body-text meta">{{locale === 'en' ? 'Sign in for your events and messages, or explore first.' : '登录后查看自己的活动和消息，也可以先去发现感兴趣的内容。'}}</text>
 <ui-button label="{{locale === 'en' ? 'WeChat sign in' : '微信登录'}}" variant="primary" compact bind:press="login"/><ui-button label="{{locale === 'en' ? 'Explore events' : '去发现活动'}}" variant="text" compact data-route="discover" bind:press="navigate"/>
</view>
<view wx:if="{{accountOpen}}" class="account-overlay" role="dialog" aria-modal="true" aria-label="{{locale === 'en' ? 'Welcome to 706' : '先登录，一起玩'}}">
 <view class="account-overlay-header" style="padding-top:{{menuTop}}px;padding-right:{{menuRightInset}}px;min-height:{{headerHeight}}px">
  <ui-icon-button wx:if="{{accountPrivacy}}" icon="{{illustrations.back}}" label="{{locale === 'en' ? 'Back' : '返回'}}" surface="plain" bind:press="accountPrivacy"/>
  <ui-icon-button wx:else icon="{{illustrations.close}}" label="{{locale === 'en' ? 'Close and keep browsing' : '关闭，继续浏览'}}" surface="plain" disabled="{{busy}}" bind:press="browseAccount"/><text class="meta">706</text>
 </view>
 <scroll-view scroll-y class="account-overlay-scroll" style="top:{{headerHeight}}px;height:calc(100% - {{headerHeight}}px)" show-scrollbar="{{false}}">
  <view class="account-overlay-content">
   <view wx:if="{{accountPrivacy}}" class="account-fields">
    <text class="hero-title">{{locale === 'en' ? 'About your information' : '关于你的信息'}}</text><text class="body-text">{{locale === 'en' ? 'Your name, photo, city, optional signature and introduction appear on your profile. Your phone stays private and is not automatically shared with organizers.' : '昵称、头像、城市，以及你选择填写的签名和自我介绍，会展示在个人主页。手机号仅用于账号联系与找回，不会公开，也不会自动分享给活动发起人。'}}</text>
    <ui-button label="{{locale === 'en' ? 'Read full privacy notice' : '阅读完整隐私说明'}}" variant="text" compact data-route="privacy" bind:press="navigate"/><ui-button label="{{locale === 'en' ? 'Back' : '返回'}}" compact bind:press="accountPrivacy"/>
   </view>
   <block wx:else>
    <text wx:if="{{error}}" class="account-error" role="alert">{{error}}</text>
    <view wx:if="{{accountStage === 'login'}}" class="account-fields account-login-content">
     <text class="brand">706</text><text class="hero-title">{{locale === 'en' ? 'Sign in. Join the fun.' : '先登录，一起玩'}}</text><text class="body-text meta">{{locale === 'en' ? 'Meet people and make things happen together.' : '认识彼此，让有意思的事发生。'}}</text>
     <checkbox-group bindchange="loginConsent"><label class="checkbox-row"><checkbox color="{{themeInk}}" checked="{{loginConsent}}"/>{{locale === 'en' ? 'I have read and accept the privacy notice' : '我已阅读并同意隐私说明'}}</label></checkbox-group><ui-button label="{{locale === 'en' ? 'Read privacy notice' : '阅读隐私说明'}}" variant="text" compact bind:press="accountPrivacy"/>
     <ui-button label="{{locale === 'en' ? 'WeChat sign in' : '微信登录'}}" variant="primary" compact disabled="{{!loginConsent || busy}}" loading="{{busy}}" bind:press="wechatLogin"/><text wx:if="{{demo}}" class="meta">{{locale === 'en' ? 'Offline demo. No real WeChat authorization.' : '离线演示，不调用真实微信授权。'}}</text>
    </view>
    <view wx:elif="{{accountStage === 'phone'}}" class="account-fields">
     <text class="account-eyebrow">{{locale === 'en' ? 'Before we begin' : '开始之前'}}</text><text class="hero-title">{{locale === 'en' ? 'Verify your phone' : '先验证一下手机号'}}</text><text class="body-text meta">{{locale === 'en' ? 'For account contact and recovery. Your phone stays private.' : '用于账号联系与找回，不会展示在个人主页，也不会自动分享给活动发起人。'}}</text>
     <label for="account-phone" class="label">{{locale === 'en' ? 'Mainland China mobile · +86' : '中国大陆手机号 · +86'}}</label><input id="account-phone" type="number" maxlength="11" value="{{phone}}" placeholder="{{locale === 'en' ? '11-digit mobile number' : '输入 11 位手机号'}}" bindinput="phoneInput" disabled="{{busy}}" bindkeyboardheightchange="keyboardChange" cursor-spacing="24"/>
     <ui-button label="{{phoneCooldown ? (locale === 'en' ? 'Resend in ' + phoneCooldown + 's' : phoneCooldown + ' 秒后重发') : phoneCodeSent ? (locale === 'en' ? 'Resend code' : '重新发送验证码') : (locale === 'en' ? 'Send code' : '获取验证码')}}" compact disabled="{{busy || phoneCooldown > 0}}" bind:press="sendPhoneCode"/><text wx:if="{{phoneCodeSent}}" class="meta" role="status">{{demo ? (locale === 'en' ? 'Demo code: 706000. No SMS is sent.' : '演示验证码：706000，不发送真实短信。') : (locale === 'en' ? 'Code sent. Check your SMS.' : '验证码已发送，请查看短信。')}}</text>
     <label for="account-code" class="label">{{locale === 'en' ? 'Verification code' : '验证码'}}</label><input id="account-code" type="number" maxlength="6" value="{{phoneCode}}" bindinput="phoneCodeInput" placeholder="{{locale === 'en' ? '6-digit code' : '输入 6 位验证码'}}" disabled="{{busy}}" bindkeyboardheightchange="keyboardChange" cursor-spacing="24"/>
     <ui-button label="{{locale === 'en' ? 'Verify and continue' : '验证并继续'}}" variant="primary" compact loading="{{busy}}" disabled="{{busy || !phoneCodeSent}}" bind:press="bindPhone"/>
    </view>
    <view wx:elif="{{accountStage === 'profile'}}" class="account-fields">
     <text class="account-eyebrow">{{accountQuestion}} / 3</text>
     <view wx:if="{{accountQuestion === 1}}" class="account-fields">
      <text class="hero-title">{{locale === 'en' ? 'What should we call you?' : '怎么称呼你？'}}</text><text class="body-text meta">{{locale === 'en' ? 'Choose a name and photo for your public profile.' : '选一个昵称和头像，让大家认识你。'}}</text>
      <button size="mini" class="account-avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAccountAvatar" disabled="{{busy}}" aria-label="{{locale === 'en' ? 'Choose photo' : '选择头像'}}"><image wx:if="{{accountForm.avatar_url}}" class="avatar large" src="{{accountForm.avatar_url}}"/><text>{{locale === 'en' ? 'Choose photo · optional' : '选择头像 · 可稍后'}}</text></button>
      <label for="account-name" class="label">{{locale === 'en' ? 'Name' : '昵称'}}</label><input id="account-name" type="nickname" value="{{accountForm.display_name}}" maxlength="40" bindinput="accountNickname" bindchange="accountNickname" bindblur="accountNickname" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'Your name in the community' : '在社区里怎么称呼你'}}" bindkeyboardheightchange="keyboardChange" cursor-spacing="24"/><text wx:if="{{accountErrors.display_name}}" class="field-error" role="alert">{{accountErrors.display_name}}</text>
      <label for="account-bio" class="label">{{locale === 'en' ? 'A short signature · optional' : '一句签名 · 选填'}}</label><input id="account-bio" value="{{accountForm.bio}}" maxlength="30" data-key="bio" bindinput="accountText" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'A little something about you' : '比如：喜欢散步，也喜欢听人讲故事'}}" bindkeyboardheightchange="keyboardChange" cursor-spacing="24"/><text class="account-count">{{accountBioCount}} / 30</text><text wx:if="{{accountErrors.bio}}" class="field-error" role="alert">{{accountErrors.bio}}</text>
     </view>
     <view wx:elif="{{accountQuestion === 2}}" class="account-fields">
      <text class="hero-title">{{locale === 'en' ? 'Where are you usually based?' : '你平时在哪里？'}}</text><text class="body-text meta">{{locale === 'en' ? 'Your city helps you find nearby people and gatherings. No precise location is needed.' : '告诉我们你常在的城市，方便遇见附近的人和活动，不需要具体地址。'}}</text><picker range="{{cities}}" range-key="{{locale === 'en' ? 'en' : 'zh'}}" bindchange="accountCity" disabled="{{busy}}"><view class="picker">{{accountCityLabel || (locale === 'en' ? 'Choose a city' : '请选择城市')}}</view></picker><text wx:if="{{accountErrors.city}}" class="field-error" role="alert">{{accountErrors.city}}</text>
     </view>
     <view wx:else class="account-fields">
      <text class="hero-title">{{locale === 'en' ? 'Tell us about yourself!' : '请介绍一下自己吧！'}}</text><text class="body-text meta">{{locale === 'en' ? 'Your words appear on your profile just as you wrote them. You can add this later.' : '写写你想让大家知道的事。你的文字会完整保留在个人主页，也可以以后再补充。'}}</text>
      <textarea value="{{accountForm.introduction}}" maxlength="300" data-key="introduction" bindinput="accountText" disabled="{{busy}}" placeholder="{{locale === 'en' ? 'Start wherever you like…' : '从哪里说起都可以……'}}" bindkeyboardheightchange="keyboardChange" cursor-spacing="24"/><text class="account-count">{{accountIntroCount}} / 300</text><text wx:if="{{accountErrors.introduction}}" class="field-error" role="alert">{{accountErrors.introduction}}</text>
      <checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox color="{{themeInk}}" checked="{{consent}}"/>{{locale === 'en' ? 'I understand the public profile and privacy notice' : '我已了解资料的公开范围，并同意隐私说明'}}</label></checkbox-group><ui-button label="{{locale === 'en' ? 'Read privacy notice' : '阅读隐私说明'}}" variant="text" compact bind:press="accountPrivacy"/><text wx:if="{{accountErrors.privacy}}" class="field-error" role="alert">{{accountErrors.privacy}}</text>
     </view>
     <view class="account-actions"><ui-button wx:if="{{accountQuestion > 1}}" label="{{locale === 'en' ? 'Back' : '上一步'}}" variant="text" compact disabled="{{busy}}" bind:press="accountPrevious"/><ui-button wx:if="{{accountQuestion < 3}}" label="{{locale === 'en' ? 'Continue' : '继续'}}" variant="primary" compact disabled="{{busy}}" bind:press="accountNext"/><ui-button wx:else label="{{locale === 'en' ? 'Finish' : '完成'}}" variant="primary" compact disabled="{{busy}}" loading="{{busy}}" bind:press="completeAccount"/></view>
    </view>
    <view wx:elif="{{accountStage === 'welcome'}}" class="account-fields account-welcome-content"><image class="account-success-icon" src="{{illustrations.success}}" aria-hidden="true"/><text class="hero-title">{{locale === 'en' ? 'All set! Welcome.' : '已完成！欢迎你'}}</text><ui-button label="{{locale === 'en' ? 'Let’s go' : '开始吧'}}" variant="primary" compact bind:press="finishAccountWelcome"/></view>
   </block>
  </view>
 </scroll-view>
</view>
