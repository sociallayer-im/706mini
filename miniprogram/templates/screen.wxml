<template name="eventCard">
 <view class="event-card" data-id="{{e.id}}" bindtap="openEvent">
  <view class="event-main"><view class="event-info"><text class="status">{{t[e.status] || e.status}}</text><text class="event-title">{{e.title}}</text><text class="meta">{{e.dateLabel}}</text><text class="meta">{{t.host}}：{{e.host_display}}</text><text class="meta">{{t.venue}}：{{e.venue_display}}</text><text class="fee">{{e.feeLabel}} · {{e.remaining === null ? t.unlimited : t.remaining + ' ' + e.remaining}}</text></view><image wx:if="{{e.cover_url}}" class="event-cover" src="{{e.cover_url}}" mode="aspectFill"/><view wx:else class="event-cover placeholder">706</view></view>
  <view class="participant"><text>{{t.registered}} {{e.registered || 0}}</text><text>{{t[e.registration.status] || ''}}</text></view>
 </view>
</template>
<view class="screen {{route === 'event' ? 'has-bottom' : ''}}" style="{{theme}}">
 <view wx:if="{{route === 'feed' || route === 'discover'}}" class="topbar"><button class="city" bindtap="chooseCity">{{cityName}}⌄</button><view class="search"><input value="{{query}}" placeholder="{{t.search}}" bindinput="searchInput" bindconfirm="search" confirm-type="search"/></view><button class="icon-button" bindtap="search">⌕</button></view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="small" bindtap="{{needsLogin ? 'login' : 'load'}}">{{needsLogin ? t.login : t.retry}}</button></view>
 <view wx:if="{{loading && !items.length && !record}}" class="skeleton"><view/><view/><view/></view>
 <block wx:if="{{route === 'feed'}}">
  <view class="section-heading"><text>{{t.people}}</text><button class="text-button" bindtap="refreshPeople">{{t.refresh}}</button></view>
  <scroll-view scroll-x class="people-strip"><view class="person" wx:for="{{people}}" wx:key="id"><view data-route="member" data-id="{{item.owner}}" bindtap="navigate"><image class="avatar" src="{{item.avatar_url}}"/><text>{{item.display_name}}</text><text class="meta">{{t[item.reason] || item.bio}}</text></view><button class="small" data-id="{{item.owner}}" data-enabled="{{true}}" bindtap="follow">＋ {{t.follow}}</button></view></scroll-view>
 </block>
 <block wx:if="{{route === 'discover' || route === 'calendar'}}">
  <view wx:if="{{route === 'discover'}}" class="calendar-entry" data-route="calendar" bindtap="navigate"><text class="section-title">{{t.calendar}} ↗</text><text class="meta">{{t.week}} · {{total}} {{t.event}}</text></view>
  <scroll-view wx:if="{{route === 'discover' && campaigns.length}}" scroll-x class="campaign-strip"><view wx:for="{{campaigns}}" wx:key="id" class="campaign-tile" data-route="campaign" data-id="{{item.id}}" bindtap="navigate"><image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill"/><text>{{item.title}}</text><text class="meta">{{item.kicker}}</text></view></scroll-view>
  <view class="filters">
   <view class="chips"><button class="chip {{calendarMode === 'week' && offset === 0 ? 'selected' : ''}}" data-key="date" data-value="week" bindtap="filter">{{t.week}}</button><button wx:if="{{route === 'discover'}}" class="chip" data-key="date" data-value="next" bindtap="filter">{{t.nextWeek}}</button><button wx:if="{{route === 'discover'}}" class="chip" data-key="date" data-value="calendar" bindtap="filter">{{t.calendar}}</button><button wx:else class="chip {{calendarMode === 'month' ? 'selected' : ''}}" data-mode="month" bindtap="calendarMode">{{t.month}}</button></view>
   <scroll-view scroll-x class="chips"><button class="chip {{!filters.space_id ? 'selected' : ''}}" data-key="space_id" data-value="" bindtap="filter">{{t.allSpaces}}</button><button wx:for="{{spaces}}" wx:key="id" class="chip {{filters.space_id === item.id ? 'selected' : ''}}" data-key="space_id" data-value="{{item.id}}" bindtap="filter">{{item.name}}</button></scroll-view>
   <scroll-view scroll-x class="chips"><button class="chip" data-key="clearTags" bindtap="filter">{{t.any}}</button><button class="chip {{filters.free_only ? 'selected' : ''}}" data-key="free_only" data-value="{{!filters.free_only}}" bindtap="filter">{{t.free}}</button><button class="chip {{filters.has_capacity ? 'selected' : ''}}" data-key="has_capacity" data-value="{{!filters.has_capacity}}" bindtap="filter">{{t.capacity}}</button><button wx:for="{{['reading','screening','outdoor']}}" wx:key="*this" class="chip {{filters.tag === item ? 'selected' : ''}}" data-key="tag" data-value="{{item}}" bindtap="filter">{{t[item]}}</button></scroll-view>
  </view>
  <view wx:if="{{route === 'calendar' || showWeek}}" class="calendar-box"><view class="row"><button class="icon-button" data-delta="-1" bindtap="period">‹</button><text>{{rangeLabel}}</text><button class="icon-button" data-delta="1" bindtap="period">›</button></view><view class="calendar-grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDay"><text>{{item.label}}</text><text class="dot">{{item.count ? '•' : ' '}}</text></view></view></view>
  <view class="section-heading"><text>{{total}} {{t.event}}</text><button wx:if="{{route === 'calendar'}}" class="text-button" bindtap="poster">{{t.poster}} ↗</button></view>
 </block>
 <block wx:if="{{route === 'messages'}}"><view class="row"><scroll-view scroll-x class="chips grow"><button wx:for="{{['','ADMIN','EVENT','SOCIAL']}}" wx:key="*this" class="chip {{category === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="category">{{t[item] || t.all}}</button></scroll-view><button class="text-button" bindtap="markRead">{{t.readAll}}</button></view></block>
 <block wx:if="{{route === 'me'}}">
  <view wx:if="{{record}}" class="profile-card"><image class="avatar large" src="{{record.avatar_url}}"/><text class="hero-title">{{record.display_name}}</text><text class="body-text">{{record.bio}}</text><text class="meta">{{record.introduction}}</text><view class="row"><button class="text-button" data-route="relations" bindtap="navigate">{{t.following}} {{me.following}}</button><button class="text-button" data-route="relations" data-extra="{{ {mode: 'followers'} }}" bindtap="navigate">{{t.followers}} {{me.followers}}</button><button class="text-button" data-route="edit-profile" bindtap="navigate">{{t.edit}}</button></view></view>
  <view wx:if="{{reviewCount}}" class="banner" data-route="approvals" bindtap="navigate">{{t.approvals}} · {{reviewCount}} →</view>
  <view class="menu"><view wx:for="{{['publish','drafts','registrations','my-events','my-campaigns','campaign-create','invitations']}}" wx:key="*this" class="menu-item" data-route="{{item}}" bindtap="navigate"><text>{{t[item]}}</text><text>›</text></view></view>
  <view wx:for="{{managed}}" wx:key="id" class="menu-item card" data-route="{{item.kind === 'SPACE' ? 'space' : 'org'}}" data-id="{{item.id}}" bindtap="navigate"><text>{{item.name}}</text><text>›</text></view><view class="menu-item card" data-route="more" bindtap="navigate"><text>{{t.more}}</text><text>›</text></view>
 </block>
 <block wx:if="{{route === 'more'}}"><view class="menu"><view class="menu-item" bindtap="chooseCity">{{t.city}}<text>{{cityName}} ›</text></view><view class="menu-item" bindtap="toggleLanguage">{{t.language}}<text>{{locale === 'en' ? 'English' : '中文'}} ›</text></view><view class="menu-item" data-kind="notifications" bindtap="preference">{{t.notificationSettings}} ›</view><view class="menu-item" data-kind="share_activity" bindtap="preference">{{t.share_activity}} ›</view><view class="menu-item" data-kind="visibility" bindtap="preference">{{t.visibility}} ›</view><view wx:for="{{['onboarding','privacy','feedback']}}" wx:key="*this" class="menu-item" data-route="{{item}}" bindtap="navigate">{{t[item]}}<text>›</text></view><view class="menu-item danger" bindtap="logout">{{t.logout}}</view></view></block>
 <block wx:if="{{route === 'event' || route === 'activity-preview'}}">
  <view wx:if="{{record}}"><image wx:if="{{record.cover_url}}" class="detail-cover" src="{{mediaPreviews.cover_url || record.cover_url}}" mode="aspectFill" data-url="{{mediaPreviews.cover_url || record.cover_url}}" bindtap="previewImage"/><view class="detail-intro"><text class="status">{{record.statusLabel}}</text><text class="hero-title">{{record.title}}</text><text class="body-text">{{record.summary}}</text><view wx:for="{{record.campaigns}}" wx:key="id" class="banner" data-route="campaign" data-id="{{item.id}}" bindtap="navigate">{{item.title}} ↗</view></view>
   <view class="card facts"><text>{{t.time}} · {{record.dateLabel}}</text><text data-route="space" data-id="{{record.space_id}}" bindtap="navigate">{{t.venue}} · {{record.venue_display || record.venue_name}}</text><text>{{record.address}}</text><text>{{record.feeLabel}} · {{record.remaining === null ? t.unlimited : t.remaining + ' ' + record.remaining}}</text></view>
   <view class="section"><text class="section-title">{{t.description}}</text><text class="body-text">{{record.description}}</text></view><view class="section"><text class="section-title">{{t.fit}}</text><text class="body-text">{{record.fit_description}}</text></view>
   <view class="card" data-route="member" data-id="{{record.owner}}" bindtap="navigate"><view class="row"><image class="avatar" src="{{record.initiator.avatar_url}}"/><view><text class="section-title">{{t.organizer}}</text><text class="meta">{{record.host_display}}</text></view></view></view>
   <view class="section"><view class="section-heading"><text>{{t.comments}}</text><button class="text-button" data-kind="comment" bindtap="sheet">＋ {{t.comment}}</button></view><view wx:for="{{comments}}" wx:key="id" class="comment"><text class="section-title">{{item.author.display_name}}</text><text class="body-text">{{item.text}}</text><view class="row"><button class="text-button" data-kind="comment" data-reply="{{item.id}}" bindtap="sheet">{{t.reply}}</button><button wx:if="{{item.owner === currentUser}}" class="text-button" data-op="deleteComment" data-id="{{item.id}}" bindtap="action">{{t.delete}}</button></view></view></view>
   <view class="row"><button class="secondary" open-type="share">{{t.share}}</button><button class="secondary" data-op="clone" bindtap="action">{{t.clone}}</button></view>
   <view wx:if="{{record.can_edit}}" class="menu"><view class="menu-item" data-route="attendees" data-id="{{record.id}}" bindtap="navigate">{{t.attendees}} ›</view><view class="menu-item" data-route="approval-progress" data-id="{{record.id}}" bindtap="navigate">{{t.progress}} ›</view><button class="danger" data-op="cancelEvent" bindtap="action">{{t.cancelEvent}}</button></view>
   <view wx:if="{{route === 'event'}}" class="bottom-actions"><button class="secondary" data-kind="recommend" bindtap="sheet">{{t.recommend}}</button><button wx:if="{{record.activeRegistration}}" class="primary grow" data-route="event-access" data-id="{{record.registration.id}}" bindtap="navigate">{{t[record.registration.status]}}</button><button wx:else class="primary grow" disabled="{{!canRegister}}" data-kind="register" bindtap="sheet">{{!canRegister ? t.closed : record.remaining === 0 ? t.waitlist : record.approval_required ? t.apply : t.register}}</button></view>
  </view>
 </block>
 <block wx:if="{{route === 'campaign' || route === 'member' || route === 'space' || route === 'org'}}"><view wx:if="{{record}}" class="profile-card"><image wx:if="{{record.cover_url}}" class="detail-cover" src="{{mediaPreviews.cover_url || record.cover_url}}" mode="aspectFill"/><view class="row"><image wx:if="{{record.avatar_url}}" class="avatar large" src="{{record.avatar_url}}"/><button wx:if="{{record.can_manage}}" class="small" data-route="edit-entity" data-id="{{record.id}}" bindtap="navigate">{{t.manage}}</button></view><text class="hero-title">{{record.title || record.display_name || record.name}}</text><text class="body-text">{{record.introduction || record.bio}}</text><text class="meta">{{record.address}}</text><text class="meta">{{record.opening_hours}}</text><text class="meta">{{record.public_contact}}</text><button wx:if="{{route !== 'campaign'}}" class="primary" data-id="{{route === 'member' ? record.owner : record.id}}" data-enabled="{{!record.following}}" bindtap="follow">{{record.following ? t.unfollow : t.follow}}</button><view wx:if="{{route === 'space' || route === 'org'}}" class="row"><button class="secondary" data-route="entity-events" data-id="{{record.id}}" bindtap="navigate">{{t['entity-events']}}</button><button class="secondary" data-route="entity-members" data-id="{{record.id}}" bindtap="navigate">{{t['entity-members']}}</button></view><button wx:if="{{record.can_admin}}" class="secondary" data-route="admins" data-id="{{record.id}}" bindtap="navigate">{{t.admins}}</button><button wx:if="{{record.can_edit && route === 'campaign'}}" class="secondary" data-route="campaign-review-progress" data-id="{{record.id}}" bindtap="navigate">{{t.progress}}</button><view wx:if="{{route === 'member'}}" class="row"><button class="text-button" data-op="mute" bindtap="action">{{t.mute}}</button><button class="text-button" data-kind="report" bindtap="sheet">{{t.report}}</button></view></view></block>
 <block wx:if="{{route === 'event-access' && record}}"><view class="card"><text class="status">{{record.statusLabel}}</text><text class="hero-title">{{record.event.title}}</text><text class="body-text">{{record.display_name}}</text><text class="meta">{{record.motivation}}</text><text class="meta">{{record.payment_expires_at}}</text><button wx:if="{{record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="primary" data-op="payment" bindtap="action">{{t.pay}}</button><button wx:if="{{record.status === 'CONFIRMED'}}" class="primary" data-op="access" bindtap="action">{{t.participate}}</button><view wx:if="{{access}}" class="section"><image wx:if="{{access.type === 'GROUP_QR'}}" class="qr" src="{{access.value}}" mode="widthFix"/><text wx:else selectable>{{access.value}}</text></view><button wx:if="{{record.status !== 'CANCELLED' && record.status !== 'EXPIRED'}}" class="secondary" data-op="cancelRegistration" bindtap="action">{{t.cancelRegistration}}</button></view></block>
 <block wx:if="{{route === 'approval-detail' || route === 'campaign-approval-detail'}}"><view wx:if="{{record}}" class="card"><text class="hero-title">{{subject.title}}</text><text class="status">{{t[record.status]}}</text><text class="body-text">{{subject.description || subject.introduction}}</text><text class="meta">{{subject.starts_at}} · {{subject.venue_display}}</text><textarea placeholder="{{t.note}}" data-key="note" bindinput="sheetInput"/><view class="row"><button class="secondary" data-op="review" data-approve="{{false}}" bindtap="action">{{t.reject}}</button><button class="primary" data-op="review" data-approve="{{true}}" bindtap="action">{{t.approve}}</button></view></view></block>
 <block wx:if="{{formKind}}">
  <view wx:if="{{route === 'publish' || route === 'campaign-create' || route === 'campaign-edit' || route === 'onboarding'}}" class="steps"><text wx:for="{{[1,2,3]}}" wx:key="*this" class="step {{step === item ? 'selected' : ''}}">{{item}}</text></view>
  <view class="form card">
   <view wx:for="{{fields}}" wx:key="key" class="field"><text class="label">{{item.label}}</text>
    <textarea wx:if="{{item.type === 'area'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="12000"/>
    <switch wx:elif="{{item.type === 'switch'}}" checked="{{form[item.key]}}" data-key="{{item.key}}" bindchange="switchInput"/>
    <view wx:elif="{{item.type === 'datetime'}}" class="row"><picker mode="date" data-key="{{item.key}}" data-part="date" bindchange="dateInput"><view class="picker">{{form[item.key] || t.choose}}</view></picker><picker mode="time" data-key="{{item.key}}" data-part="time" bindchange="dateInput"><view class="picker">◷</view></picker></view>
    <picker wx:elif="{{item.type === 'city'}}" range="{{cities}}" range-key="{{locale === 'en' ? 'en' : 'zh'}}" data-key="{{item.key}}" data-type="city" bindchange="select"><view class="picker">{{item.display || t.choose}} ⌄</view></picker>
    <picker wx:elif="{{item.type === 'space'}}" range="{{spaceNames}}" data-key="{{item.key}}" data-type="space" bindchange="select"><view class="picker">{{item.display || t.choose}} ⌄</view></picker>
    <picker wx:elif="{{item.type === 'organization'}}" range="{{organizationNames}}" data-key="{{item.key}}" data-type="organization" bindchange="select"><view class="picker">{{item.display || t.personal}} ⌄</view></picker>
    <picker wx:elif="{{item.type === 'access'}}" range="{{[t.groupQr,t.organizerWechat,t.organizerContact]}}" data-key="{{item.key}}" data-type="access" bindchange="select"><view class="picker">{{item.display || t.choose}} ⌄</view></picker>
    <checkbox-group wx:elif="{{item.type === 'events'}}" bindchange="eventSelection"><label wx:for="{{eventOptions}}" wx:for-item="event" wx:key="id" class="checkbox-row"><checkbox value="{{event.id}}" checked="{{event.selected}}"/>{{event.title}}</label></checkbox-group>
    <view wx:elif="{{item.type === 'image'}}"><button class="secondary" data-key="{{item.key}}" bindtap="upload">{{t.chooseImage}}</button><image wx:if="{{mediaPreviews[item.key]}}" class="detail-cover" src="{{mediaPreviews[item.key]}}" mode="aspectFit"/><text class="meta">{{form[item.key] ? t.uploaded : ''}}</text></view>
    <input wx:else type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="{{item.type === 'image' ? 2000 : 500}}"/>
   </view>
   <block wx:if="{{step === 3 && formKind !== 'profile'}}"><text class="hero-title">{{form.title}}</text><text class="body-text">{{form.summary || form.kicker}}</text><text class="body-text">{{form.description || form.introduction}}</text><text class="meta">{{form.starts_at}} · {{form.ends_at}}</text><text class="meta">{{venueName}}</text></block>
   <view wx:if="{{route === 'onboarding' && step === 3}}"><text class="section-title">{{t.publicSummary}}</text><text class="body-text">{{form.display_name}} · {{form.bio}}</text><text class="meta">{{form.introduction}}</text><text class="section-title">{{t.spaces}}</text><checkbox-group bindchange="spaceSelection"><label wx:for="{{spaces}}" wx:key="id" class="checkbox-row"><checkbox value="{{item.id}}" checked="{{item.selected}}"/>{{item.name}}</label></checkbox-group></view><checkbox-group wx:if="{{route === 'onboarding' && step === 3}}" bindchange="consent"><label class="checkbox-row"><checkbox checked="{{consent}}"/>{{t.privacyConsent}}</label></checkbox-group>
   <text wx:if="{{draftSaved}}" class="meta">{{t.formSaved}}</text>
  </view>
  <view class="row"><button wx:if="{{step > 1}}" class="secondary" data-delta="-1" bindtap="step">{{t.back}}</button><button class="secondary" loading="{{busy}}" bindtap="saveForm">{{t.save}}</button><button wx:if="{{step < 3 && (route === 'publish' || route === 'campaign-create' || route === 'campaign-edit' || route === 'onboarding')}}" class="primary" data-delta="1" bindtap="step">{{t.continue}}</button><button wx:elif="{{step === 3}}" class="primary" data-submit="{{true}}" loading="{{busy}}" bindtap="saveForm">{{formKind === 'profile' ? t.confirm : t.submit}}</button></view>
 </block>
 <block wx:if="{{route === 'login'}}"><view class="login-hero"><text class="brand">706</text><text class="hero-title">{{t.login}}</text><text class="meta">{{t.people}}</text></view><view class="card"><input placeholder="{{loginMode === 'email' ? t.email : t.phone}}" data-key="address" bindinput="loginInput"/><button class="secondary" loading="{{busy}}" bindtap="sendCode">{{t.sendCode}}</button><input placeholder="{{t.code}}" data-key="code" bindinput="loginInput"/><button class="primary" loading="{{busy}}" bindtap="verifyCode">{{t.login}}</button><button class="text-button" bindtap="loginMode">{{loginMode === 'email' ? t.phone : t.email}}</button><button class="text-button" bindtap="wechatLogin">{{t.wechatLogin}}</button></view></block>
 <block wx:if="{{route === 'privacy'}}"><view class="card prose"><text class="section-title">706 · 2026-10-08</text><text wx:if="{{locale !== 'en'}}">昵称、头像、城市和你选择公开的介绍用于社区展示。微信号不进入公开资料；报名时只有你明确同意后才可向本次活动的授权发起者提供。报名理由、联系方式、群二维码及支付记录按业务权限访问。取消、退款或撤销权限后，参与方式不再可读。你可以编辑资料、取消关注、屏蔽动态或提交隐私反馈。平台运营方身份与正式隐私政策联系方式需在上线前补齐。</text><text wx:else>Your public name, avatar, city and chosen introduction appear in the community. Your WeChat contact is private and shared with authorized organizers only with your event-specific consent. Registration, contact, access and payment information require permission. Cancelling or revoking access removes participation details. You can edit your profile, unfollow, mute or submit privacy feedback. Operator identity and formal privacy contact must be provided before launch.</text></view></block>
 <block wx:if="{{route === 'feedback'}}"><view class="card"><textarea placeholder="{{t.reason}}" data-key="reason" bindinput="sheetInput"/><button class="primary" data-kind="report" bindtap="sheet">{{t.feedback}}</button></view></block>
 <view wx:if="{{route === 'admins'}}" class="row"><button class="primary" data-kind="invite" bindtap="sheet">{{t.invite}}</button></view>
 <block wx:for="{{items}}" wx:key="id">
  <view wx:if="{{route === 'feed' && !searching}}" class="feed-entry"><view class="row"><image class="avatar" src="{{item.author.avatar_url}}"/><view><text class="section-title">{{item.author.display_name}}</text><text class="meta">{{item.key === 'REGISTRATION_ROLLUP' ? item.count + ' · ' + t.registered : item.text}}</text></view></view><template is="eventCard" data="{{e:item.event,t:t}}"/></view>
  <template wx:elif="{{item.type === 'event' && route !== 'drafts' && route !== 'my-events'}}" is="eventCard" data="{{e:item,t:t}}"/>
  <view wx:else class="list-card" data-index="{{index}}" bindtap="openItem"><text class="status">{{item.statusLabel}}</text><text class="section-title">{{item.title || t[item.scope] || item.scope || item.owner}}</text><text class="meta">{{item.note || item.motivation || item.dateLabel}}</text><text wx:if="{{route === 'messages'}}" class="meta">{{item.status === 'UNREAD' ? '●' : ''}}</text>
   <view wx:if="{{route === 'drafts' || route === 'my-events'}}" class="row"><button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" class="small" data-route="publish" data-id="{{item.id}}" catchtap="navigate">{{t.edit}}</button><button class="small" data-route="activity-preview" data-id="{{item.id}}" catchtap="navigate">{{t.preview}}</button><button class="small" data-route="approval-progress" data-id="{{item.id}}" catchtap="navigate">{{t.progress}}</button></view>
   <view wx:if="{{route === 'my-campaigns'}}" class="row"><button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" class="small" data-route="campaign-edit" data-id="{{item.id}}" catchtap="navigate">{{t.edit}}</button><button class="small" data-route="campaign-review-progress" data-id="{{item.id}}" catchtap="navigate">{{t.progress}}</button></view>
   <view wx:if="{{route === 'attendees' && item.status === 'REQUESTED'}}" class="row"><button class="small" data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{false}}" catchtap="action">{{t.decline}}</button><button class="small primary" data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{true}}" catchtap="action">{{t.approve}}</button></view>
   <button wx:if="{{route === 'admins' && item.role !== 'OWNER' && item.status === 'ACTIVE'}}" class="small" data-op="revokeRole" data-id="{{item.id}}" catchtap="action">{{t.revoke}}</button><button wx:if="{{route === 'invitations'}}" class="small primary" data-op="acceptInvite" data-id="{{item.id}}" catchtap="action">{{t.accept}}</button>
  </view>
 </block>
 <view wx:if="{{!loading && !error && !items.length && !record && !formKind && route !== 'more' && route !== 'login' && route !== 'privacy' && route !== 'feedback'}}" class="empty"><text class="empty-mark">◌</text><text>{{route === 'discover' || route === 'calendar' ? t.noEvents : t.empty}}</text><button wx:if="{{route === 'discover' || route === 'calendar'}}" class="text-button" bindtap="clearFilters">{{t.clear}}</button></view>
 <button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" bindtap="onReachBottom">{{t.loadMore}}</button>
 <button wx:if="{{route === 'feed' || route === 'discover'}}" class="fab" data-route="publish" bindtap="navigate">＋</button>
 <view wx:if="{{sheet}}" class="overlay"><view class="scrim" bindtap="closeSheet"/><view class="sheet"><view class="section-heading"><text>{{t[sheet] || t.confirm}}</text><button class="icon-button" bindtap="closeSheet">×</button></view>
  <block wx:if="{{sheet === 'poster'}}"><image class="poster-preview" src="{{posterPath}}" mode="widthFix"/><button class="primary" bindtap="savePoster">{{t.saveImage}}</button></block>
  <block wx:else><block wx:if="{{sheet === 'register'}}"><input placeholder="{{t.display_name}}" data-key="display_name" bindinput="sheetInput"/><textarea placeholder="{{t.motivation}}" data-key="motivation" bindinput="sheetInput"/><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox checked="{{consent}}"/>{{t.privacyConsent}}</label></checkbox-group><checkbox-group bindchange="contactConsent"><label class="checkbox-row"><checkbox checked="{{shareContact}}"/>{{t.shareContact}}</label></checkbox-group></block><input wx:elif="{{sheet === 'invite'}}" placeholder="{{t.user_id}}" data-key="user_id" bindinput="sheetInput"/><textarea wx:else placeholder="{{t.text}}" data-key="{{sheet === 'report' ? 'reason' : 'text'}}" bindinput="sheetInput"/><button class="primary" loading="{{busy}}" bindtap="submitSheet">{{t.confirm}}</button></block>
 </view></view>
 <canvas canvas-id="poster" class="poster-canvas" style="width:{{posterWidth}}px;height:{{posterHeight}}px"/>
</view>
