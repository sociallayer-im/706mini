  <view class="member-hero"><image class="avatar member-avatar" src="{{record.avatar_url}}"/><text class="member-name">{{record.display_name}}</text><view class="member-city"><view class="glyph glyph-location"/><text>{{record.cityLabel}} · {{record.bio}}</text></view><text class="member-intro">{{record.introduction}}</text><view class="chips"><text wx:for="{{record.interests}}" wx:key="*this" class="chip">{{item}}</text></view>
   <view class="row member-actions"><button wx:if="{{record.owner === currentUser}}" class="secondary" data-route="edit-profile" bindtap="navigate">{{locale === 'en' ? 'Edit profile' : '编辑个人资料'}}</button><button wx:else class="{{record.following ? 'secondary' : 'primary'}}" data-id="{{record.owner}}" data-enabled="{{!record.following}}" bindtap="follow">{{record.following ? (locale === 'en' ? 'Following' : '已关注') : (locale === 'en' ? 'Follow' : '＋ 关注')}}</button><button class="secondary" open-type="share">{{locale === 'en' ? 'Share profile' : '分享主页'}}</button></view>
   <view class="member-stats"><button data-route="relations" data-id="{{record.owner}}" bindtap="navigate"><text>{{record.following_count}}</text><text>{{t.following}}</text></button><button data-route="relations" data-id="{{record.owner}}" data-extra="{{ {mode: 'followers'} }}" bindtap="navigate"><text>{{record.followers_count}}</text><text>{{t.followers}}</text></button><view><text>{{record.activity_count}}</text><text>{{locale === 'en' ? 'Community activities' : '共同活动'}}</text></view></view>
  </view>
  <view class="member-section"><text class="section-title">{{locale === 'en' ? 'Work and social' : '作品与社交'}}</text><button wx:for="{{memberLinks}}" wx:key="url" class="member-link" data-value="{{item.url}}" bindtap="copy"><view class="member-mark"><view class="glyph {{item.kind === 'social' ? 'glyph-person' : 'icon-draft'}}"/></view><view class="grow"><text class="section-title">{{item.label}}</text><text class="meta">{{item.url}}</text></view><text>›</text></button></view>
  <view class="member-section"><text class="section-title">{{locale === 'en' ? 'Often found at' : '常出没于'}}</text><button wx:for="{{record.frequent_entities}}" wx:key="id" class="member-link" data-route="{{item.kind === 'SPACE' ? 'space' : 'org'}}" data-id="{{item.id}}" bindtap="navigate"><image class="member-mark entity-avatar" src="{{item.cover_url}}" mode="aspectFill"/><view class="grow"><text class="section-title">{{item.name}}</text><text wx:if="{{item.kind === 'SPACE' && item.participation_count !== null}}" class="meta">{{locale === 'en' ? 'Attended ' + item.participation_count + ' past events' : '最近参加过 ' + item.participation_count + ' 场活动'}}</text><text wx:elif="{{item.membership_label}}" class="meta">{{item.membership_label}}{{item.contribution ? ' · ' + item.contribution : ''}}</text></view><text>›</text></button></view>
 </block>
 <block wx:if="{{route === 'space' || route === 'org'}}"><view wx:if="{{record}}" class="profile-card entity-profile"><image wx:if="{{record.cover_url}}" class="detail-cover" src="{{record.cover_url}}" mode="aspectFill"/><image wx:if="{{record.avatar_url}}" class="avatar large entity-avatar" src="{{record.avatar_url}}"/><view class="entity-heading"><text class="hero-title grow">{{record.title || record.name}}</text><button wx:if="{{record.can_manage}}" class="small" data-kind="manage" bindtap="sheet">{{t.manage}}</button><button wx:else class="small" data-id="{{record.id}}" data-enabled="{{!record.following}}" bindtap="follow">{{record.following ? t.unfollow : t.follow}}</button></view><text class="meta">{{record.cityLabel}} {{record.address}}</text><text class="body-text">{{record.introduction}}</text><text class="meta">{{record.opening_hours}}</text><button class="secondary entity-share" open-type="share">{{t.share}}</button>
 <block wx:if="{{route === 'member'}}"><view wx:for="{{record.public_links}}" wx:key="url" class="menu-item" data-value="{{item.url}}" bindtap="copy"><view><text>{{item.label}}</text><text class="meta">{{item.url}}</text></view><text>↗</text></view><text class="section-title">{{t.frequent_spaces}}</text><view wx:for="{{record.frequent_entities}}" wx:key="id" class="menu-item" data-route="{{item.kind === 'SPACE' ? 'space' : 'org'}}" data-id="{{item.id}}" bindtap="navigate">{{item.name}} ›</view></block>
 </view>
 <view wx:if="{{route === 'space' || route === 'org'}}" class="section"><view class="section-heading"><text>{{t['entity-members']}}</text><button class="text-button" data-route="entity-members" data-id="{{record.id}}" bindtap="navigate">{{t.view}} ›</button></view><scroll-view scroll-x class="people-strip"><view class="person active-person" wx:for="{{record.members}}" wx:key="owner" data-route="member" data-id="{{item.owner}}" bindtap="navigate"><image class="avatar" src="{{item.avatar_url}}"/><text>{{item.display_name}}</text></view></scroll-view><view class="section-heading"><text>{{t.event}}</text><button class="text-button" data-route="entity-events" data-id="{{record.id}}" bindtap="navigate">{{t.view}} ›</button></view></view></block>
 <block wx:if="{{route === 'event-access' && record}}">
  <view class="access-hero"><text class="success-mark">{{record.status === 'CONFIRMED' || record.status === 'APPROVED_AWAITING_PAYMENT' ? '✓' : '◷'}}</text><text class="hero-title">{{record.status === 'CONFIRMED' ? (locale === 'en' ? 'You can participate now' : '你可以参加了') : record.status === 'APPROVED_AWAITING_PAYMENT' ? (locale === 'en' ? 'Application approved' : '报名申请已通过') : record.statusLabel}}</text><text class="body-text">{{record.event.title}}</text><text class="meta">{{record.event.dateLabel}}–{{record.event.endTime}} · {{record.event.venue_display}}</text></view>
  <view wx:if="{{record.status === 'CONFIRMED' || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="section"><text class="section-title">{{locale === 'en' ? 'Next steps' : '下一步'}}</text>
   <view wx:if="{{record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">1</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Complete payment' : '完成活动付款'}}</text><text class="meta">{{record.event.feeLabel}} · {{locale === 'en' ? 'Complete within 30 minutes' : '请在 30 分钟内完成'}}
{{locale === 'en' ? 'Pay by' : '付款截止'}} {{paymentDeadline}}</text></view><button class="small" data-kind="payment" bindtap="sheet">{{locale === 'en' ? 'Pay' : '去付款'}}</button></view>
   <view wx:if="{{accessHasGroup || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">{{record.status === 'APPROVED_AWAITING_PAYMENT' ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Join the event group' : '加入活动微信群'}}</text><text class="meta">{{record.status === 'CONFIRMED' ? (locale === 'en' ? 'Your group QR is available. The group shares event reminders.' : '二维码已开放；群内会发布行前提醒。') : (locale === 'en' ? 'The QR will be available after payment. The group shares event reminders.' : '付款后显示二维码；群内会发布行前提醒。')}}</text></view><button class="small" disabled="{{record.status !== 'CONFIRMED'}}" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <view wx:if="{{accessHasContact || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">{{record.status === 'APPROVED_AWAITING_PAYMENT' ? '3' : accessHasGroup ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Contact the organizer' : '联系活动组织者'}}</text><text class="meta">{{record.event.initiator.display_name || record.event.host_display}} · {{record.status === 'CONFIRMED' ? (locale === 'en' ? 'View and copy the organizer contact.' : '可查看、复制组织者联系方式。') : (locale === 'en' ? 'Contact details are available after payment.' : '付款后可查看、复制联系方式。')}}{{record.contact_share_consent ? (locale === 'en' ? ' Your consented contact is shared with the organizer.' : '你报名时同意分享的微信号也会提供给组织者。') : (locale === 'en' ? ' Your WeChat is shared only with your consent at registration.' : '仅在你报名时同意后，才会向组织者提供你的微信号。')}}</text></view><button class="small" disabled="{{record.status !== 'CONFIRMED'}}" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <view wx:if="{{accessWillContact}}" class="next-step"><text class="step-number">{{accessHasGroup ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'The organizer will contact you' : '组织者稍后会与你联络'}}</text><text class="meta">{{locale === 'en' ? 'See the participation instructions for details.' : '具体安排请查看参与方式。'}}</text></view><button class="small" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <text class="body-text meta">{{locale === 'en' ? 'Some events do not provide a group. The organizer may contact you instead.' : '有些活动不会提供群聊。届时这里会说明“组织者稍后会与你联络”，或显示公开联系人。'}}</text>
  </view><button wx:if="{{record.status !== 'CANCELLED' && record.status !== 'EXPIRED'}}" class="secondary access-cancel" data-op="cancelRegistration" bindtap="action">{{t.cancelRegistration}}</button>
 </block>
 <block wx:if="{{route === 'approval-detail' || route === 'campaign-approval-detail'}}"><view wx:if="{{record}}" class="card"><text class="status">{{t[record.status]}}</text><text class="hero-title">{{subject.title}}</text><text class="body-text">{{subject.description || subject.introduction}}</text><view class="facts"><text wx:if="{{subject.starts_at}}">{{subject.dateLabel}}–{{subject.endTime}}</text><text>{{subject.venue_display}}</text><text class="meta">{{subject.venue_note}}</text><text wx:if="{{subject.capacity}}">{{subject.capacity}} {{locale === 'en' ? 'places' : '个名额'}} · {{subject.feeLabel}}</text><text wx:if="{{subject.approval_required}}">{{t.approval_required}}</text></view><text class="section-title">{{locale === 'en' ? 'Other reviewers' : '其他审核方'}}</text><view wx:for="{{reviewSteps}}" wx:key="id" class="review-step"><text class="status-dot {{item.status === 'APPROVED' ? 'passed' : ''}}"/><view><text>{{t[item.scope] || item.scope}}</text><text class="meta">{{item.note}}</text></view><text>{{t[item.status]}}</text></view><text wx:if="{{subject.organizer_note}}" class="section-title">{{locale === 'en' ? 'Organizer notes' : '发起人备注'}}</text><text class="body-text">{{subject.organizer_note}}</text><view wx:if="{{record.status === 'PENDING' && subject.status === 'IN_REVIEW'}}" class="row"><button class="secondary" data-kind="return" bindtap="sheet">{{t.reject}}</button><button class="primary" data-op="review" data-approve="{{true}}" bindtap="action">{{t.approve}}</button></view></view></block>
 <view wx:if="{{route === 'approval-progress' || route === 'campaign-review-progress'}}" class="card"><text class="status">{{record.statusLabel}}</text><text class="hero-title">{{record.title}}</text><text class="body-text">{{record.submitted_display}}</text><text class="meta">{{locale === 'en' ? 'Published automatically after all required reviews pass.' : '所有必要审核通过后会自动公开。'}}</text><text class="section-title">{{locale === 'en' ? 'Current progress' : '当前进度'}}</text></view>
 <view wx:if="{{route === 'relations' || route === 'following'}}" class="chips"><button class="chip {{relationMode === 'following' ? 'selected' : ''}}" data-mode="following" bindtap="relationTab">{{t.following}} {{followingCount}}</button><button class="chip {{relationMode === 'followers' ? 'selected' : ''}}" data-mode="followers" bindtap="relationTab">{{t.followers}} {{followersCount}}</button></view>
 <view wx:if="{{formKind && submitted}}" class="success-page"><text class="success-icon">✓</text><text class="hero-title">{{formKind === 'profile' ? (locale === 'en' ? 'Welcome to 706' : '欢迎来到 706 社区') : formKind === 'event' ? (locale === 'en' ? 'Event submitted for review' : '活动已提交审核') : (locale === 'en' ? 'Campaign submitted for review' : '专题已提交审核')}}</text><text class="body-text">{{formKind === 'profile' ? form.display_name + ' · ' + form.bio : (locale === 'en' ? 'The relevant reviewers have received the request. Follow progress below.' : '相应审核方会收到申请。所有必要审核通过后会自动公开。')}}</text><button wx:if="{{formKind !== 'profile'}}" class="primary" data-route="{{formKind === 'event' ? 'approval-progress' : 'campaign-review-progress'}}" data-id="{{submittedId || optionsId}}" bindtap="navigate">{{t.progress}}</button><button class="primary" data-route="feed" bindtap="navigate">{{locale === 'en' ? 'Enter community' : '进入社区'}}</button><button wx:if="{{formKind === 'profile'}}" class="text-button" bindtap="restartForm">{{t.edit}}</button></view>
 <block wx:if="{{formKind && !submitted}}">
  <view wx:if="{{route === 'publish' || route === 'campaign-create' || route === 'onboarding'}}" class="steps"><text wx:for="{{[1,2,3]}}" wx:key="*this" class="step {{step === item ? 'selected' : ''}}">{{item}}</text></view>
  <view class="form card {{route === 'campaign-edit' ? 'series-edit' : ''}}">
   <view wx:for="{{fields}}" wx:key="key" class="field {{item.type === 'switch' ? 'switch-field' : ''}}"><text class="label">{{item.label}}</text>
    <textarea wx:if="{{item.type === 'area'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="12000"/>
    <switch wx:elif="{{item.type === 'switch'}}" checked="{{form[item.key]}}" data-key="{{item.key}}" bindchange="switchInput"/>
    <view wx:elif="{{item.type === 'datetime'}}" class="row"><picker mode="date" data-key="{{item.key}}" data-part="date" bindchange="dateInput"><view class="picker">{{item.dateDisplay || t.choose}}</view></picker><picker mode="time" data-key="{{item.key}}" data-part="time" bindchange="dateInput"><view class="picker">{{item.timeDisplay || '◷'}}</view></picker></view>
    <picker wx:elif="{{item.type === 'city'}}" range="{{cities}}" range-key="{{locale === 'en' ? 'en' : 'zh'}}" data-key="{{item.key}}" data-type="city" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'space'}}" range="{{spaceNames}}" data-key="{{item.key}}" data-type="space" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'organization'}}" range="{{organizationNames}}" data-key="{{item.key}}" data-type="organization" bindchange="select"><view class="picker select-control"><text>{{item.display || t.personal}}</text><text class="picker-chevron">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'access'}}" range="{{[t.groupQr,t.organizerWechat,t.organizerContact]}}" data-key="{{item.key}}" data-type="access" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron">⌄</text></view></picker>
    <checkbox-group wx:elif="{{item.type === 'events'}}" bindchange="eventSelection"><label wx:for="{{route === 'campaign-edit' ? visibleEventOptions : eventOptions}}" wx:for-item="event" wx:key="id" class="checkbox-row"><checkbox value="{{event.id}}" checked="{{event.selected}}"/><image class="picker-event-cover" src="{{event.cover_url}}" mode="aspectFill"/><view><text>{{event.title}}</text><text class="meta">{{event.dateLabel}} · {{event.cityLabel || event.city}} · {{event.venue_display}}</text><text class="meta">{{event.host_display}}</text></view></label></checkbox-group>
    <view wx:elif="{{item.type === 'image'}}" class="{{item.key === 'avatar_url' ? 'avatar-upload' : ''}}"><image wx:if="{{mediaPreviews[item.key] || form[item.key]}}" class="{{item.key === 'avatar_url' ? 'form-avatar' : 'detail-cover'}}" src="{{mediaPreviews[item.key] || form[item.key]}}" mode="aspectFit"/><button class="secondary" data-key="{{item.key}}" bindtap="upload">{{t.chooseImage}}</button><text wx:if="{{item.key !== 'avatar_url'}}" class="meta">{{form[item.key] ? t.uploaded : ''}}</text></view>
    <view wx:elif="{{item.type === 'links'}}"><view wx:for="{{form[item.key]}}" wx:for-item="link" wx:for-index="linkIndex" wx:key="index" class="repeat-row"><input value="{{link}}" data-key="{{item.key}}" data-index="{{linkIndex}}" bindinput="listInput"/><button class="icon-button" data-key="{{item.key}}" data-index="{{linkIndex}}" bindtap="listRemove">×</button></view><button class="text-button" data-key="{{item.key}}" bindtap="listAdd">＋ {{locale === 'en' ? 'Add' : '添加'}}</button></view>
    <checkbox-group wx:elif="{{item.type === 'spaces'}}" bindchange="spaceSelection"><label wx:for="{{spaces}}" wx:key="id" class="checkbox-row"><checkbox value="{{item.id}}" checked="{{item.selected}}"/>{{item.name}}</label></checkbox-group>
    <checkbox-group wx:elif="{{item.type === 'interests'}}" class="interest-grid" bindchange="interestsChange"><label wx:for="{{interestOptions}}" wx:key="value" class="interest-choice"><checkbox value="{{item.value}}" checked="{{item.selected}}"/>{{item.value}}</label></checkbox-group>
    <view wx:elif="{{item.type === 'methods'}}"><checkbox-group bindchange="methodsChange"><label wx:for="{{accessOptions}}" wx:key="value" class="checkbox-row"><checkbox value="{{item.value}}" checked="{{item.selected}}"/>{{item.label}}</label></checkbox-group><view wx:for="{{accessOptions}}" wx:key="value"><view wx:if="{{item.selected}}"><text class="label">{{item.label}}</text><button wx:if="{{item.value === 'GROUP_QR'}}" class="secondary" data-key="access_values.GROUP_QR" bindtap="upload">{{t.chooseImage}}</button><input wx:else value="{{item.content}}" data-type="{{item.value}}" bindinput="accessInput"/><text wx:if="{{item.value === 'GROUP_QR' && item.content}}" class="meta">{{t.uploaded}}</text></view></view><text class="meta">{{locale === 'en' ? 'Only confirmed participants can access these details.' : '可组合多种方式；仅对报名成功且完成付款的人显示。'}}</text></view>
    <view wx:elif="{{item.type === 'media'}}"><view class="media-grid"><view wx:for="{{form.media}}" wx:for-item="asset" wx:for-index="assetIndex" wx:key="index" class="media-tile {{route === 'campaign-edit' && assetIndex === 0 ? 'series-cover-tile' : ''}}"><image wx:if="{{asset.type === 'image'}}" src="{{asset.url}}" mode="aspectFill"/><video wx:elif="{{asset.type === 'video'}}" src="{{asset.url}}" controls/><input wx:else value="{{asset.url}}" placeholder="https://" data-index="{{assetIndex}}" bindinput="mediaLinkInput"/><button class="media-remove" data-index="{{assetIndex}}" bindtap="mediaRemove">×</button></view></view><button wx:if="{{route === 'campaign-edit'}}" class="secondary" data-key="media" data-type="image" data-replace="{{true}}" bindtap="upload">{{locale === 'en' ? 'Change series cover' : '更换系列封面'}}</button><view class="row"><button class="small" data-key="media" data-type="image" bindtap="upload">＋ {{locale === 'en' ? 'Image' : '图片'}}</button><button wx:if="{{formKind === 'event'}}" class="small" data-key="media" data-type="video" bindtap="upload">＋ {{locale === 'en' ? 'Video' : '视频'}}</button><button wx:if="{{formKind === 'event'}}" class="small" bindtap="mediaLink">＋ {{locale === 'en' ? 'Link' : '链接'}}</button></view><text class="meta">{{formKind === 'event' ? (locale === 'en' ? 'Up to 9 images, 1 video and 3 links. First image is the cover.' : '最多 9 张图片、1 个视频和 3 个外部链接；第一张作为活动卡片封面。') : (locale === 'en' ? 'Up to 12 images. First image is the campaign cover.' : '正文最多 12 张图片；第一张作为专题封面。')}}</text></view>
    <input wx:else type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="{{item.type === 'image' ? 2000 : 500}}"/>
    <button wx:if="{{route === 'campaign-edit' && item.key === 'event_ids'}}" class="text-button" bindtap="toggleEventPicker">{{showEventPicker ? (locale === 'en' ? 'Done' : '完成选择') : (locale === 'en' ? '＋ Add event' : '＋ 添加活动')}}</button>
    <text wx:if="{{item.key === 'public_contact' || item.key === 'wechat'}}" class="meta">{{locale === 'en' ? 'Private contact. Only shared when authorized.' : '默认不公开；仅在获得许可、需要联系时向授权对象提供。'}}</text>
   </view>
   <block wx:if="{{step === 3 && formKind !== 'profile'}}"><text class="hero-title">{{form.title}}</text><text class="body-text">{{form.summary || form.kicker}}</text><text class="body-text">{{form.description || form.introduction}}</text><text class="meta">{{formStartDisplay}} · {{formEndDisplay}}</text><text class="meta">{{venueName}}</text></block>
   <view wx:if="{{route === 'onboarding' && step === 3}}"><text class="section-title">{{t.publicSummary}}</text><text class="body-text">{{form.display_name}} · {{form.bio}}</text><text class="meta">{{form.introduction}}</text><text class="section-title">{{t.spaces}}</text><checkbox-group bindchange="spaceSelection"><label wx:for="{{spaces}}" wx:key="id" class="checkbox-row"><checkbox value="{{item.id}}" checked="{{item.selected}}"/>{{item.name}}</label></checkbox-group></view><checkbox-group wx:if="{{route === 'onboarding' && step === 3}}" bindchange="consent"><label class="checkbox-row"><checkbox checked="{{consent}}"/>{{t.privacyConsent}}</label></checkbox-group>
   <text wx:if="{{draftSaved}}" class="meta">{{t.formSaved}}</text>
  </view>
  <view class="row"><button wx:if="{{step > 1}}" class="secondary" data-delta="-1" bindtap="step">{{t.back}}</button><button class="{{route === 'campaign-edit' ? 'primary' : 'secondary'}}" loading="{{busy}}" bindtap="saveForm">{{route === 'campaign-edit' && record.status === 'PUBLISHED' ? (locale === 'en' ? 'Submit changes for review' : '提交修改审核') : t.save}}</button><button wx:if="{{step < 3 && (route === 'publish' || route === 'campaign-create' || route === 'onboarding')}}" class="primary" data-delta="1" bindtap="step">{{t.continue}}</button><button wx:elif="{{step === 3}}" class="primary" data-submit="{{true}}" loading="{{busy}}" bindtap="saveForm">{{formKind === 'profile' ? t.confirm : t.submit}}</button></view>
 </block>
 <block wx:if="{{route === 'login'}}"><view class="login-hero"><text class="brand">706</text><text class="hero-title">{{t.login}}</text><text class="meta">{{t.people}}</text></view><text wx:if="{{demo}}" class="meta">演示登录验证码：706000，不发送短信 / 邮件</text><view class="card"><input placeholder="{{loginMode === 'email' ? t.email : t.phone}}" data-key="address" bindinput="loginInput"/><button class="secondary" loading="{{busy}}" bindtap="sendCode">{{t.sendCode}}</button><input placeholder="{{t.code}}" data-key="code" bindinput="loginInput"/><button class="primary" loading="{{busy}}" bindtap="verifyCode">{{t.login}}</button><button class="text-button" bindtap="loginMode">{{loginMode === 'email' ? t.phone : t.email}}</button><button class="text-button" bindtap="wechatLogin">{{t.wechatLogin}}</button></view></block>
 <block wx:if="{{route === 'privacy'}}"><view class="settings-menu"><button class="settings-row" data-kind="share_activity" bindtap="preference"><view class="settings-icon"><view class="settings-glyph icon-activity"/></view><text class="settings-label">{{t.share_activity}}</text><text class="settings-value">{{record.share_activity ? (locale === 'en' ? 'On' : '已开启') : (locale === 'en' ? 'Off' : '已关闭')}}</text></button><button class="settings-row" data-kind="visibility" bindtap="preference"><view class="settings-icon"><view class="settings-glyph icon-shield"/></view><text class="settings-label">{{t.visibility}}</text><text class="settings-value">{{record.visibility === 'PUBLIC' ? t.PUBLIC : (locale === 'en' ? 'Members only' : '仅社区成员')}}</text></button></view><view class="card prose"><text class="section-title">706 · 2026-10-08</text><text wx:if="{{locale !== 'en'}}">昵称、头像、城市和你选择公开的介绍用于社区展示。微信号不进入公开资料；报名时只有你明确同意后才可向本次活动的授权发起者提供。报名理由、联系方式、群二维码及支付记录按业务权限访问。取消、退款或撤销权限后，参与方式不再可读。你可以编辑资料、取消关注、屏蔽动态或提交隐私反馈。平台运营方身份与正式隐私政策联系方式需在上线前补齐。</text><text wx:else>Your public name, avatar, city and chosen introduction appear in the community. Your WeChat contact is private and shared with authorized organizers only with your event-specific consent. Registration, contact, access and payment information require permission. Cancelling or revoking access removes participation details. You can edit your profile, unfollow, mute or submit privacy feedback. Operator identity and formal privacy contact must be provided before launch.</text></view></block>
 <block wx:if="{{route === 'feedback'}}"><view class="card"><textarea value="{{sheetForm.reason}}" placeholder="{{t.reason}}" data-key="reason" bindinput="sheetInput"/><button class="primary" data-kind="report" bindtap="sheet">{{t.feedback}}</button></view></block>
 <view wx:if="{{contact}}" class="card"><text selectable>{{contact}}</text></view><view wx:if="{{route === 'admins'}}" class="row"><button class="primary" data-kind="invite" bindtap="sheet">{{t.invite}}</button></view>
 <scroll-view wx:if="{{route === 'registrations' || route === 'my-events'}}" scroll-x class="mine-filter-row"><button wx:for="{{route === 'registrations' ? ['', 'REQUESTED', 'APPROVED_AWAITING_PAYMENT', 'UPCOMING', 'ENDED'] : ['', 'IN_REVIEW', 'PUBLISHED', 'ENDED', 'DRAFT']}}" wx:key="*this" class="chip {{(minePhase || '') === item ? 'selected' : ''}}" data-phase="{{item}}" bindtap="mineFilter">{{!item ? t.all : item === 'UPCOMING' ? (locale === 'en' ? 'Upcoming' : '即将开始') : item === 'ENDED' ? (locale === 'en' ? 'Ended' : '已结束') : t[item]}}</button></scroll-view>
 <text wx:if="{{route === 'member'}}" class="section-title">{{locale === 'en' ? 'Activity history' : '活动历史'}}</text>
 <view wx:if="{{route === 'campaign'}}" class="section-heading"><text>{{locale === 'en' ? 'Events across cities' : '各城市活动'}}</text><text class="meta">{{record.cities.length}} {{locale === 'en' ? 'city nodes' : '个节点'}}</text></view>
 <text wx:if="{{route === 'spaces'}}" class="body-text meta">{{locale === 'en' ? 'Choose a space to explore its events and active members.' : '先选择一个空间，再查看那里近期发生的活动和活跃成员。'}}</text>
 <block wx:for="{{items}}" wx:key="id">
  <view wx:if="{{route === 'feed' && !searching}}" class="feed-entry"><view class="row"><image class="avatar" src="{{item.author.avatar_url}}"/><view><text class="section-title">{{item.key === 'REGISTRATION_ROLLUP' ? (item.actors[0].display_name + (item.actors.length > 1 ? '、' + item.actors[1].display_name : '') + (item.count > 2 ? ' 和 ' + (item.count - 2) + ' 位同城成员' : '') + '报名了') : item.author.display_name + '推荐了一场活动'}}</text><text class="meta">{{item.display_time}} · {{item.key === 'REGISTRATION_ROLLUP' ? '合并动态' : cityName}}</text></view></view><text class="feed-quote">{{item.text}}</text><template is="eventCard" data="{{e:item.event,t:t}}"/></view>
  <view wx:elif="{{route === 'relations' || route === 'following' || route === 'entity-members'}}" class="member-row" data-index="{{index}}" bindtap="openItem"><image class="avatar" src="{{item.avatar_url}}"/><view class="grow"><text class="section-title">{{item.display_name || item.name}}</text><text class="meta">{{item.bio}} · {{item.cityLabel || item.city}}</text></view><button wx:if="{{item.owner !== currentUser}}" class="small" data-id="{{item.owner || item.id}}" data-enabled="{{!item.following}}" catchtap="follow">{{item.following ? t.unfollow : t.follow}}</button></view>
  <view wx:elif="{{route === 'spaces'}}" class="space-directory-card" data-route="space" data-id="{{item.id}}" bindtap="navigate"><image src="{{item.cover_url}}" mode="aspectFill"/><view class="space-directory-shade"/><view class="space-directory-body"><text class="meta">{{item.district}} {{item.distance_label ? '· ' + item.distance_label : ''}}</text><text class="hero-title">{{item.name}}</text><text>{{item.event_count}} {{locale === 'en' ? 'events' : '场活动'}} · {{item.active_member_count}} {{locale === 'en' ? 'active members' : '位成员活跃'}}</text><text class="space-directory-link">{{locale === 'en' ? 'View events' : '查看活动'}} ›</text></view></view>
  <view wx:elif="{{route === 'my-events' || route === 'drafts'}}" class="my-event-card"><image wx:if="{{route === 'drafts'}}" class="draft-cover" src="{{item.cover_url}}" mode="aspectFill"/><view class="row"><text class="status">{{route === 'drafts' ? (locale === 'en' ? 'Editing step ' : '编辑至第 ') + (item.edit_step || 1) : item.phaseLabel}}</text></view><text class="hero-title">{{item.title}}</text><text class="meta">{{item.dateLabel}}–{{item.endTime}}</text><text class="meta">{{item.host_display}} · {{item.organization_name || t.personal}}</text><text class="meta">{{item.venue_display}}</text><text class="body-text meta">{{item.phase === 'IN_REVIEW' ? item.list_note || t.progress : item.phase === 'PUBLISHED' ? item.registered + ' ' + t.registered + ' · ' + item.remaining + ' ' + t.remaining : item.phase === 'ENDED' ? item.registered + ' ' + t.registered + ' · ' + item.comment_count + ' ' + t.comments : (locale === 'en' ? 'Saved ' : '保存于') + (item.saved_display || item.updated_at)}}</text><view class="row"><button wx:if="{{item.phase === 'IN_REVIEW'}}" class="small" data-route="approval-progress" data-id="{{item.id}}" bindtap="navigate">{{t.progress}}</button><button wx:if="{{item.phase === 'IN_REVIEW' || item.phase === 'DRAFT' || item.phase === 'CHANGES_REQUESTED'}}" class="small" data-route="publish" data-id="{{item.id}}" bindtap="navigate">{{item.phase === 'DRAFT' ? (locale === 'en' ? 'Continue editing' : '继续编辑') : t.edit}}</button><button wx:if="{{item.phase === 'PUBLISHED' || item.phase === 'ENDED'}}" class="small" data-route="event" data-id="{{item.id}}" bindtap="navigate">{{locale === 'en' ? 'View event' : '查看活动'}}</button><button wx:if="{{item.phase === 'PUBLISHED'}}" class="small" data-route="attendees" data-id="{{item.id}}" bindtap="navigate">{{t.attendees}}</button><button wx:if="{{item.phase === 'ENDED'}}" class="small" data-op="clone" data-id="{{item.id}}" bindtap="action">{{t.clone}}</button></view></view>
  <view wx:elif="{{route === 'registrations'}}" class="registration-card" data-index="{{index}}" bindtap="openItem"><image class="registration-cover" src="{{item.event.cover_url}}" mode="aspectFill"/><view class="registration-content"><text class="status">{{item.phaseLabel}}</text><text class="section-title">{{item.event.title}}</text><text class="meta">{{item.event.dateLabel}}–{{item.event.endTime}}</text><text class="meta">{{item.event.venue_display}}</text><text class="meta">{{item.event.host_display}}</text><text class="body-text">{{locale !== 'en' && item.list_note ? item.list_note : item.status === 'REQUESTED' ? (locale === 'en' ? 'The organizer usually responds within 24 hours.' : '发起人通常会在 24 小时内处理') : item.status === 'APPROVED_AWAITING_PAYMENT' ? (locale === 'en' ? 'Approved. Complete payment to secure your place.' : '申请已通过，完成付款后保留名额') : item.statusLabel}}</text><button class="text-button" data-route="event-access" data-id="{{item.id}}" catchtap="navigate">{{locale === 'en' ? 'View registration' : '查看报名详情'}} ›</button></view></view>
  <view wx:elif="{{route === 'messages'}}" class="notification-card" data-index="{{index}}" bindtap="openItem"><view class="notification-top"><image wx:if="{{item.actor.avatar_url}}" class="notification-avatar" src="{{item.actor.avatar_url}}"/><view wx:else class="notification-system-icon"><view class="settings-glyph icon-{{item.notificationIcon}}"/></view><text class="notification-source">{{item.actor.display_name || t[item.category]}}</text><text class="notification-time">{{item.notificationTime}}</text><text wx:if="{{item.status === 'UNREAD'}}" class="unread-dot">●</text></view><text class="notification-title">{{item.title}}</text><text wx:if="{{item.notificationParts}}" class="notification-body">{{item.notificationParts[0]}}<text class="notification-event-link">{{item.notificationParts[1]}}</text>{{item.notificationParts[2]}}</text><text wx:else class="notification-body">{{item.description}}</text></view>
  <template wx:elif="{{item.type === 'event' && route !== 'drafts' && route !== 'my-events' && (route !== 'calendar' || calendarMode === 'month')}}" is="eventCard" data="{{e:item,t:t,interactiveTitle:route === 'campaign' || route === 'calendar' || route === 'member',modalOpen:!!sheet}}"/>
  <view wx:elif="{{route !== 'calendar'}}" class="list-card" data-index="{{index}}" bindtap="openItem"><text class="status">{{item.statusLabel}}</text><text class="section-title">{{item.title || t[item.scope] || item.scope || item.owner}}</text><text class="meta">{{item.note || item.motivation || item.dateLabel}}</text><text wx:if="{{route === 'messages'}}" class="meta">{{item.status === 'UNREAD' ? '●' : ''}}</text>
   <view wx:if="{{route === 'drafts' || route === 'my-events'}}" class="row"><button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" class="small" data-route="publish" data-id="{{item.id}}" catchtap="navigate">{{t.edit}}</button><button class="small" data-route="activity-preview" data-id="{{item.id}}" catchtap="navigate">{{t.preview}}</button><button class="small" data-route="approval-progress" data-id="{{item.id}}" catchtap="navigate">{{t.progress}}</button></view>
   <view wx:if="{{route === 'my-campaigns'}}" class="row"><button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" class="small" data-route="campaign-edit" data-id="{{item.id}}" catchtap="navigate">{{t.edit}}</button><button class="small" data-route="campaign-review-progress" data-id="{{item.id}}" catchtap="navigate">{{t.progress}}</button></view>
   <button wx:if="{{route === 'attendees' && item.can_read_contact}}" class="small" data-op="registrationContact" data-id="{{item.id}}" catchtap="action">{{t.readContact}}</button><view wx:if="{{route === 'attendees' && item.status === 'REQUESTED'}}" class="row"><button class="small" data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{false}}" catchtap="action">{{t.decline}}</button><button class="small primary" data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{true}}" catchtap="action">{{t.approve}}</button></view>
   <button wx:if="{{route === 'admins' && item.role !== 'OWNER' && item.status === 'ACTIVE'}}" class="small" data-op="revokeRole" data-id="{{item.id}}" catchtap="action">{{t.revoke}}</button><button wx:if="{{route === 'invitations'}}" class="small primary" data-op="acceptInvite" data-id="{{item.id}}" catchtap="action">{{t.accept}}</button>
  </view>
 </block>
 <view wx:if="{{!loading && !error && !items.length && !record && !formKind && route !== 'more' && route !== 'login' && route !== 'privacy' && route !== 'feedback' && route !== 'review-lab'}}" class="empty"><text class="empty-mark">◌</text><text>{{route === 'calendar' ? (locale === 'en' ? 'No events in this period' : selectedDate ? '这一天还没有活动' : calendarMode === 'month' ? '本月还没有活动' : '这周还没有活动') : route === 'discover' && locale !== 'en' ? '暂时没有活动' : route === 'discover' ? t.noEvents : t.empty}}</text><text wx:if="{{route === 'calendar'}}" class="body-text">{{locale === 'en' ? 'Try another date or filter.' : calendarMode === 'month' ? '可以查看其他月份，或换一个筛选条件。' : '可以查看其他日期，或换一个筛选条件。'}}</text><text wx:if="{{route === 'discover'}}" class="body-text">{{locale === 'en' ? 'Try another date, or host an event you would like to join.' : '换个时间看看，或者发起一场你想参加的活动。'}}</text><button wx:if="{{route === 'discover' || route === 'calendar'}}" class="text-button" bindtap="clearFilters">{{t.clear}}</button></view>
 <button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" bindtap="onReachBottom">{{t.loadMore}}</button>
 <button wx:if="{{route === 'feed' || route === 'discover'}}" class="fab" data-route="publish" bindtap="navigate">＋</button>
 <include src="sheets.wxml"/>
 <canvas wx:if="{{route === 'calendar'}}" canvas-id="poster" class="poster-canvas" style="width:{{posterWidth}}px;height:{{posterHeight}}px"/>
</view>
