   <view wx:if="{{route === 'event'}}" class="bottom-actions"><button class="secondary detail-recommend" data-kind="recommend" bindtap="sheet"><view class="glyph glyph-star"/>{{record.recommended ? (locale === 'en' ? 'Recommended' : '已推荐') : t.recommend}}</button><button wx:if="{{record.activeRegistration}}" class="primary grow" data-route="event-access" data-id="{{record.registration.id}}" bindtap="navigate">{{t[record.registration.status]}}</button><button wx:else class="primary grow" disabled="{{!canRegister}}" data-kind="register" bindtap="sheet">{{!canRegister ? t.closed : record.remaining === 0 ? t.waitlist : record.approval_required ? (locale === 'en' ? 'Apply to join' : '申请报名') : (locale === 'en' ? 'Join event' : '立即报名')}}</button></view>
  </view>
