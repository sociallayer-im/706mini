  <view class="section series-about"><text class="section-title">{{locale === 'en' ? 'About this series' : '关于这个系列'}}</text><text class="body-text">{{record.introduction}}</text><button wx:for="{{record.resource_links}}" wx:key="*this" class="series-resource" data-value="{{item}}" bindtap="copy"><view class="settings-icon"><view class="settings-glyph icon-draft"/></view><view class="grow"><text class="section-title">{{locale === 'en' ? 'Participant resources' : '参与者资料包'}}</text><text class="meta">{{record.resource_description}}</text></view><text>›</text></button></view>
