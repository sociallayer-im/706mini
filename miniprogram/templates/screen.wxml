 <block wx:if="{{route === 'login'}}"><view class="login-hero"><text class="brand">706</text><text class="hero-title">{{t.login}}</text><text class="meta">{{t.people}}</text></view><text wx:if="{{demo}}" class="meta">演示登录验证码：706000，不发送短信 / 邮件</text><ui-panel ><ui-form-field data-key="address" placeholder="{{loginMode === 'email' ? t.email : t.phone}}" type="text" bind:input="loginInput" bind:keyboardheightchange="keyboardChange"/><ui-button loading="{{busy}}" disabled="{{busy}}" bind:press="sendCode" variant="secondary" label="{{t.sendCode}}"/><text wx:if="{{codeSent}}" class="meta" role="status">{{locale === 'en' ? 'Code sent. Check your messages.' : '验证码已发送，请查看消息。'}}</text><ui-form-field data-key="code" placeholder="{{t.code}}" type="text" bind:input="loginInput" bind:keyboardheightchange="keyboardChange"/><ui-button loading="{{busy}}" disabled="{{busy}}" bind:press="verifyCode" variant="primary" grow="{{true}}" label="{{t.login}}"/><ui-button bind:press="loginMode" variant="text" compact="{{true}}" label="{{loginMode === 'email' ? t.phone : t.email}}"/><ui-button bind:press="wechatLogin" variant="text" compact="{{true}}" label="{{t.wechatLogin}}"/></ui-panel></block>
 <block wx:if="{{route === 'privacy'}}"><ui-menu-group ><ui-action-row data-kind="share_activity" bind:press="preference" label="{{t.share_activity}}" value="{{record.share_activity ? (locale === 'en' ? 'On' : '已开启') : (locale === 'en' ? 'Off' : '已关闭')}}" icon="{{illustrations.activity}}"/><ui-action-row data-kind="visibility" bind:press="preference" label="{{t.visibility}}" value="{{record.visibility === 'PUBLIC' ? t.PUBLIC : (locale === 'en' ? 'Members only' : '仅社区成员')}}" icon="{{illustrations.shield}}"/></ui-menu-group><ui-panel ><text class="section-title">706 · 2026-10-08</text><text wx:if="{{locale !== 'en'}}">昵称、头像、城市和你选择公开的介绍用于社区展示。微信号不进入公开资料。报名确认后，发起人会按活动安排联系你。报名理由、群二维码及支付记录按业务权限访问。取消或撤销权限后，参与方式不再可读。你可以编辑资料、取消关注、屏蔽他人或提交隐私反馈。平台运营方身份与正式隐私政策联系方式需在上线前补齐。</text><text wx:else>Your public name, avatar, city and chosen introduction appear in the community. Your WeChat contact stays private. After you are confirmed, the organizer will contact you about the event. Registration notes, group QR codes and payment records stay limited to the people who run that event. Cancelling or revoking access removes participation details. You can edit your profile, unfollow, block someone or submit privacy feedback. Operator identity and formal privacy contact must be provided before launch.</text></ui-panel></block>
 <block wx:if="{{route === 'feedback'}}"><ui-panel ><ui-form-field data-key="reason" value="{{sheetForm.reason}}" placeholder="{{t.reason}}" type="area" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/><ui-button data-kind="report" bind:press="sheet" variant="primary" grow="{{true}}" label="{{t.feedback}}"/></ui-panel></block>
 <ui-panel wx:if="{{contact}}"><text selectable>{{contact}}</text></ui-panel><view wx:if="{{route === 'admins'}}" class="row"><ui-button data-kind="invite" bind:press="sheet" variant="primary" grow="{{true}}" label="{{t.invite}}"/></view><view wx:if="{{route === 'platform-admins'}}" class="settings-intro"><text class="hero-title">{{t['platform-admins']}}</text><text class="body-text meta">{{locale === 'en' ? 'Grant platform access by account ID. You cannot remove your own.' : '输入账号 ID 授权平台管理员。不能取消自己的权限。'}}</text><ui-button data-kind="grantAdmin" bind:press="sheet" variant="primary" grow="{{true}}" label="{{t.grantAdmin}}"/></view>
 <scroll-view wx:if="{{route === 'registrations' || route === 'my-events'}}" scroll-x class="mine-filter-row horizontal-rail rail-page" role="radiogroup" aria-label="{{locale === 'en' ? 'Status filter' : '状态筛选'}}" show-scrollbar="{{false}}"><view class="horizontal-track"><ui-filter-chip rail="{{true}}" wx:for="{{route === 'registrations' ? ['', 'REQUESTED', 'APPROVED_AWAITING_PAYMENT', 'UPCOMING', 'ENDED', 'CANCELLED'] : ['', 'IN_REVIEW', 'PUBLISHED', 'ENDED', 'DRAFT', 'CANCELLED']}}" wx:key="*this" selected="{{(minePhase || '') === item}}" label="{{!item ? t.all : item === 'UPCOMING' ? (locale === 'en' ? 'Upcoming' : '即将开始') : item === 'ENDED' ? (locale === 'en' ? 'Ended' : '已结束') : t[item]}}" selection-mode="single" data-phase="{{item}}" bind:press="mineFilter"/></view></scroll-view>
 <view wx:if="{{route === 'member'}}" class="section-heading member-history-heading"><text>{{locale === 'en' ? 'Activity history' : '活动历史'}}</text></view>
 <view wx:if="{{route === 'campaign'}}" class="section-heading"><text>{{locale === 'en' ? 'Events across cities' : '各城市活动'}}</text><text class="meta">{{record.cities.length}} {{locale === 'en' ? 'city nodes' : '个节点'}}</text></view>
 <view wx:if="{{route === 'spaces'}}" class="node-directory-intro"><text class="body-text meta">{{spacesScope === 'following' ? (locale === 'en' ? 'The places you follow, in this city and beyond.' : '留意你关注的地方，看看那里正在发生什么。') : (locale === 'en' ? 'Find a place to gather, make things and meet people.' : '从一个空间开始，认识这座城市里的活动与人。')}}</text><view class="node-directory-tabs" role="radiogroup" aria-label="{{locale === 'en' ? 'Space scope' : '空间范围'}}"><ui-filter-chip selection-mode="single" data-scope="city" bind:press="nodeScope" label="{{locale === 'en' ? 'In this city' : '当前城市'}}" selected="{{spacesScope === 'city'}}"/><ui-filter-chip selection-mode="single" data-scope="following" bind:press="nodeScope" label="{{locale === 'en' ? 'Following' : '我关注的'}}" selected="{{spacesScope === 'following'}}"/></view></view>
 <view wx:if="{{route === 'messages'}}" class="chips" role="radiogroup" aria-label="{{locale === 'en' ? 'Message type' : '消息类型'}}"><ui-filter-chip selection-mode="single" data-value="" bind:press="category" label="{{t.all}}" selected="{{!category}}"/><ui-filter-chip selection-mode="single" data-value="EVENT" bind:press="category" label="{{t.EVENT}}" selected="{{category === 'EVENT'}}"/><ui-filter-chip selection-mode="single" data-value="SOCIAL" bind:press="category" label="{{t.SOCIAL}}" selected="{{category === 'SOCIAL'}}"/><ui-filter-chip selection-mode="single" data-value="ADMIN" bind:press="category" label="{{t.ADMIN}}" selected="{{category === 'ADMIN'}}"/></view>
 <block wx:for="{{items}}" wx:key="id">
  <text wx:if="{{item.searchSection}}" class="section-title search-section">{{item.searchSection}}</text>
  <ui-feed-item wx:if="{{route === 'feed' && !searching}}" item="{{item}}" t="{{t}}" illustrations="{{illustrations}}" city-name="{{cityName}}" locale="{{locale}}" bind:interaction="uiInteraction"/>
  <ui-identity-row wx:elif="{{route === 'relations' || route === 'following' || route === 'entity-members'}}" data-index="{{index}}" bind:press="openItem" src="{{(item.avatar_url) || ''}}" name="{{item.display_name || item.name}}" description="{{item.bio}} · {{item.cityLabel || item.city}}" interactive="{{true}}"><view slot="actions"><ui-button wx:if="{{item.owner !== currentUser}}" data-id="{{item.owner || item.id}}" data-enabled="{{!item.following}}" catch:press="personFollow" variant="secondary" compact="{{true}}" label="{{item.following ? (locale === 'en' ? 'Following' : '已关注') : t.follow}}"/></view></ui-identity-row>
  <ui-entity-card wx:elif="{{route === 'spaces'}}" data-route="space" data-id="{{item.id}}" item="{{item}}" locale="{{locale}}" bind:press="navigate"/>
  <ui-personal-event wx:elif="{{route === 'my-events' || route === 'drafts' || route === 'registrations'}}" item="{{item}}" mode="{{route}}" locale="{{locale}}" busy="{{busy}}" bind:navigate="personalNavigate" bind:action="personalAction"/>
  <ui-personal-campaign wx:elif="{{route === 'my-campaigns'}}" item="{{item}}" locale="{{locale}}" busy="{{busy}}" bind:navigate="personalNavigate" bind:action="personalAction"/>
  <block wx:elif="{{route === 'messages'}}"><ui-notification-item data-index="{{index}}" item="{{item}}" t="{{t}}" locale="{{locale}}" bind:press="openItem"/></block>
  <template wx:elif="{{item.type === 'event' && route !== 'drafts' && route !== 'my-events'}}" is="eventCard" data="{{icons:icons,illustrations:illustrations,e:item,t:t,interactiveTitle:route === 'campaign' || route === 'calendar' || route === 'member',modalOpen:!!sheet}}"/>
  <block wx:elif="{{route === 'approval-progress' || route === 'campaign-review-progress'}}"/>
  <ui-record-card wx:elif="{{route !== 'calendar'}}" data-index="{{index}}" status="{{item.statusLabel || ''}}" title="{{item.title || t[item.scope] || item.scope || item.display_name || item.owner}}" description="{{item.note || item.motivation || item.dateLabel || ''}}" meta="{{route === 'messages' && item.status === 'UNREAD' ? '●' : ''}}" interactive="{{route !== 'attendees' && route !== 'admins' && route !== 'invitations' && route !== 'approval-progress' && route !== 'campaign-review-progress'}}" bind:press="openItem">
   <view wx:if="{{route === 'drafts' || route === 'my-events'}}" class="row"><ui-button wx:if="{{item.status === 'DRAFT' || item.status === 'CHANGES_REQUESTED'}}" data-route="publish" data-id="{{item.id}}" catch:press="navigate" variant="secondary" compact="{{true}}" label="{{t.edit}}"/><ui-button data-route="activity-preview" data-id="{{item.id}}" catch:press="navigate" variant="secondary" compact="{{true}}" label="{{t.preview}}"/><ui-button data-route="approval-progress" data-id="{{item.id}}" catch:press="navigate" variant="secondary" compact="{{true}}" label="{{t.progress}}"/></view>

   <ui-button wx:if="{{route === 'attendees' && item.can_read_contact}}" data-op="registrationContact" data-id="{{item.id}}" catch:press="action" variant="secondary" compact="{{true}}" label="{{t.readContact}}"/><view wx:if="{{route === 'attendees' && item.can_approve}}" class="row"><ui-button data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{false}}" catch:press="action" variant="secondary" compact="{{true}}" label="{{t.decline}}"/><ui-button data-op="registrationDecision" data-id="{{item.id}}" data-version="{{item.version}}" data-approve="{{true}}" catch:press="action" variant="primary" compact="{{true}}" label="{{t.approve}}"/></view><ui-button wx:if="{{route === 'attendees' && item.can_check_in}}" data-op="checkIn" data-id="{{item.id}}" data-user-id="{{item.user_id}}" catch:press="action" variant="primary" compact="{{true}}" label="{{t.checkIn}}"/><text wx:if="{{route === 'attendees' && item.checked_in_at}}" class="meta">{{t.checkedIn}}</text>
   <ui-button wx:if="{{route === 'admins' && item.role !== 'OWNER' && item.status === 'ACTIVE'}}" data-op="revokeRole" data-id="{{item.id}}" catch:press="action" variant="secondary" compact="{{true}}" label="{{t.revoke}}"/><ui-button wx:if="{{route === 'invitations'}}" data-op="declineInvite" data-id="{{item.id}}" catch:press="action" variant="secondary" compact="{{true}}" label="{{t.decline}}"/><ui-button wx:if="{{route === 'invitations'}}" data-op="acceptInvite" data-id="{{item.id}}" catch:press="action" variant="primary" compact="{{true}}" label="{{t.accept}}"/><ui-button wx:if="{{route === 'blocks'}}" data-op="mute" data-id="{{item.owner}}" data-block-id="{{item.id}}" data-enabled="0" catch:press="action" variant="secondary" compact="{{true}}" label="{{t.unmute}}"/><ui-button wx:if="{{route === 'platform-admins' && item.owner !== currentUser}}" data-op="revokePlatformAdmin" data-id="{{item.owner}}" catch:press="action" variant="secondary" compact="{{true}}" label="{{locale === 'en' ? 'Remove admin' : '取消管理员'}}"/>
  </ui-record-card>
 </block>
 <view wx:if="{{(route === 'space' || route === 'org') && record.members.length}}" class="entity-members-section"><view class="section-heading"><text>{{demo ? (locale === 'en' ? 'People in this space' : '空间成员') : (locale === 'en' ? 'Members' : '小组成员')}}</text><ui-button data-route="entity-members" data-id="{{record.id}}" bind:press="navigate" variant="text" compact="{{true}}" label="{{t.view}}"/></view><text class="meta">{{demo ? (locale === 'en' ? 'Participants who chose to share their public profiles.' : '这里展示选择公开参与记录的成员。') : (locale === 'en' ? 'People who belong to this group.' : '这里展示这个小组的成员。')}}</text><scroll-view scroll-x class="entity-member-strip horizontal-rail rail-page" show-scrollbar="{{false}}"><view class="horizontal-track"><view wx:for="{{record.members}}" wx:key="owner" class="entity-member-item"><ui-identity-row src="{{(item.avatar_url) || ''}}" name="{{item.display_name}}" size="32" interactive data-route="member" data-id="{{item.owner}}" bind:press="navigate"/></view></view></scroll-view></view>
 <ui-empty-state wx:if="{{!loading && !error && !items.length && !record && !formKind && route !== 'more' && route !== 'login' && route !== 'privacy' && route !== 'feedback' && route !== 'review-lab' && route !== 'manage'}}" icon="{{illustrations.empty}}" title="{{route === 'calendar' ? (locale === 'en' ? 'No events in this period' : selectedDate ? '这一天还没有活动' : calendarMode === 'month' ? '本月还没有活动' : '这周还没有活动') : route === 'discover' && locale !== 'en' ? '暂时没有活动' : route === 'discover' ? t.noEvents : t.empty}}"><text wx:if="{{route === 'calendar'}}" class="body-text">{{locale === 'en' ? 'Try another date or filter.' : calendarMode === 'month' ? '可以查看其他月份，或换一个筛选条件。' : '可以查看其他日期，或换一个筛选条件。'}}</text><text wx:if="{{route === 'discover'}}" class="body-text">{{locale === 'en' ? 'Try another date, or host an event you would like to join.' : '换个时间看看，或者发起一场你想参加的活动。'}}</text><ui-button wx:if="{{route === 'discover' || route === 'calendar'}}" bind:press="clearFilters" variant="text" compact="{{true}}" label="{{t.clear}}"/></ui-empty-state>
