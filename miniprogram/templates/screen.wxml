  <ui-floating-bar keyboard-height="{{keyboardHeight}}"><ui-button wx:if="{{step > 1}}" disabled="{{busy}}" data-delta="-1" bind:press="step" variant="text" compact="{{true}}" label="{{t.back}}"/><ui-button wx:if="{{(route === 'publish' || route === 'campaign-create' || route === 'onboarding') && !editingPublished}}" disabled="{{busy}}" bind:press="{{route === 'onboarding' ? 'saveDraft' : 'saveForm'}}" variant="text" compact="{{true}}" label="{{locale === 'en' ? 'Save draft' : '存草稿'}}"/><ui-button wx:elif="{{!(step === 3 && (route === 'publish' || route === 'campaign-create' || route === 'onboarding'))}}" disabled="{{busy}}" loading="{{busy}}" bind:press="saveForm" variant="primary" grow="{{true}}" label="{{route === 'create-space' ? (locale === 'en' ? 'Create space' : '创建空间') : t.save}}"/><ui-button wx:if="{{step < 3 && (route === 'publish' || route === 'campaign-create' || route === 'onboarding')}}" disabled="{{busy}}" data-delta="1" bind:press="step" variant="primary" grow="{{true}}" label="{{t.continue}}"/><ui-button wx:elif="{{step === 3}}" data-submit="{{!editingPublished}}" disabled="{{busy}}" loading="{{busy}}" bind:press="saveForm" variant="primary" grow="{{true}}" label="{{editingPublished ? t.save : formKind === 'profile' ? (locale === 'en' ? 'Enter community' : '进入社区') : t.submit}}"/></ui-floating-bar>
