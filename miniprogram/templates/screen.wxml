<page-meta page-style="{{accountOpen ? 'overflow:hidden;' : ''}}"/>
<template name="eventCard"><ui-event-card e="{{e}}" t="{{t}}" illustrations="{{illustrations}}" large="{{large}}" interactive-title="{{interactiveTitle}}" preview-only="{{previewOnly}}" modal-open="{{modalOpen}}" card-route="{{cardRoute || ''}}" bind:interaction="uiInteraction"/></template>

<template name="featureCarousel"><ui-feature-carousel cards="{{cards}}" is-nodes="{{isNodes}}" current="{{current || 0}}" city="{{city}}" locale="{{locale}}" demo="{{demo}}" bind:interaction="uiInteraction"/></template>
<view class="screen page-{{route}} community-edition {{isTask ? 'task-page' : ''}} {{isMainTab ? 'main-tab-page' : 'child-page'}} {{keyboardHeight ? 'keyboard-open' : ''}} {{locale === 'en' ? 'is-english' : ''}} {{demo && reviewIndex >= 0 ? 'reviewing' : ''}} {{route === 'event' ? 'has-bottom' : ''}}" style="{{theme}};padding-top:{{((route === 'event' || route === 'activity-preview' || route === 'space' || route === 'org' || route === 'campaign') && record.galleryUrls.length ? 0 : headerHeight) + (demo && reviewIndex >= 0 ? 56 : 0)}}px">
 <view class="main-navigation {{!isMainTab ? 'subpage-navigation' : ''}}" style="height:{{headerHeight}}px;padding-top:{{navigationTop}}px"><view class="main-navigation-content" style="min-height:{{navigationHeight}}px;padding-right:{{menuRightInset}}px"><ui-icon-button wx:if="{{!isMainTab}}" icon="{{illustrations.back}}" label="{{locale === 'en' ? 'Back' : '返回'}}" size="{{menuHeight}}" surface="{{(route === 'event' || route === 'activity-preview' || route === 'space' || route === 'org' || route === 'campaign') && record.galleryUrls.length ? 'glass' : 'surface'}}" bindpress="back"/><text wx:if="{{!isMainTab && route !== 'event' && route !== 'activity-preview' && !((route === 'space' || route === 'org' || route === 'campaign') && record.galleryUrls.length)}}" class="subpage-title">{{title}}</text><ui-button wx:if="{{route === 'feed' || route === 'discover'}}" bind:press="chooseCity" variant="secondary" compact="{{true}}" label="{{cityName}}"/><ui-search-field wx:if="{{route === 'discover'}}" value="{{query || ''}}" placeholder="{{t.search}}" size="{{menuHeight - 4}}" bind:input="searchInput" bind:search="search" bind:keyboardheightchange="keyboardChange"/><scroll-view wx:if="{{route === 'messages'}}" scroll-x class="header-message-filters horizontal-rail rail-contained" role="radiogroup" aria-label="{{locale === 'en' ? 'Message categories' : '消息分类'}}" show-scrollbar="{{false}}"><view class="horizontal-track"><ui-filter-chip selection-mode="single" rail="{{true}}" wx:for="{{['','ADMIN','EVENT','SOCIAL']}}" wx:key="*this" data-value="{{item}}" bind:press="category" label="{{t[item] || t.all}}" selected="{{(category || '') === item}}"/></view></scroll-view></view></view>
 <view wx:if="{{demo && reviewIndex >= 0}}" class="review-controls" style="top:{{headerHeight}}px"><ui-button data-delta="-1" bind:press="reviewNext" variant="secondary" compact="{{true}}" label="‹"/><text>{{reviewIndex + 1}} / 118</text><ui-button data-delta="-1" bind:press="reviewScroll" variant="secondary" compact="{{true}}" label="⬆️"/><ui-button data-delta="1" bind:press="reviewScroll" variant="secondary" compact="{{true}}" label="⬇️"/><ui-button data-delta="1" bind:press="reviewNext" variant="secondary" compact="{{true}}" label="›"/></view>
 <block wx:if="{{route === 'review-lab'}}"><ui-panel ><text class="hero-title">{{locale === 'en' ? 'Developer' : '开发者'}}</text><text class="meta">{{demo ? (locale === 'en' ? 'Demo data · ' : '演示数据 · ') + demoName : 'Montana'}}</text><ui-button bind:press="labMode" variant="secondary" label="{{demo ? (locale === 'en' ? 'Connect live service' : '切换真实服务') : (locale === 'en' ? 'Use demo data' : '切换演示数据')}}"/><view wx:if="{{demo}}" class="chips developer-personas" role="radiogroup" aria-label="{{locale === 'en' ? 'Demo persona' : '演示身份'}}"><ui-filter-chip selection-mode="single" wx:for="{{developerPersonas}}" wx:key="id" data-id="{{item.id}}" bind:press="labPersona" label="{{item.label}}" selected="{{currentUser === item.id}}"/></view></ui-panel></block>
 <ui-panel wx:if="{{route === 'review-lab' && demo}}" class="account-fields"><text class="hero-title">{{locale === 'en' ? 'New user journey' : '新用户完整流程'}}</text><text class="body-text">{{locale === 'en' ? 'Start as a guest. Tap Follow or Create event to open sign-in on that page, then verify your phone and finish profile setup.' : '从游客浏览开始。点击「关注」或「发布活动」，在当前页面触发登录，再验证手机号、完成资料设置、浏览自己的主页，并进入现有的编辑资料页。'}}</text><text class="meta">{{locale === 'en' ? 'Only the demo newcomer setup is reset. Demo code: 706000.' : '只清空演示新人的资料设置与登录进度，其他演示记录和编辑草稿保留。演示验证码：706000。'}}</text><ui-button label="{{locale === 'en' ? 'Start new user journey' : '开始新用户走查'}}" variant="primary" compact bind:press="labNewUserJourney"/></ui-panel>
 <block wx:if="{{route === 'review-lab'}}"><ui-panel ><text class="hero-title">待查看页面</text><text class="body-text">12 项待修、32 项待核对、4 个额外路由，共 48 项。已核对的 19 项不列入；开发核对不代表本人验收。</text><text class="meta">点击切换到对应演示身份与上海筛选，保留 r12 业务记录与草稿，不重置数据。从“我的 → 开发者”返回页面目录。</text><ui-button wx:if="{{!demo}}" bind:press="labMode" variant="secondary" label="切换到离线演示后查看"/></ui-panel><ui-menu-group wx:if="{{demo}}"><view wx:for="{{pendingCatalog}}" wx:key="index"><ui-action-row data-index="{{item.index}}" data-pending="{{true}}" bind:press="labOpen" label="{{item.label}}" navigation="{{true}}"/><text wx:if="{{item.note}}" class="meta">{{item.note}}</text></view></ui-menu-group></block>

 <ui-notice wx:if="{{error && !sheet && !accountOpen}}" state="error" text="{{error}}" action="{{needsLogin ? t.login : t.retry}}" disabled="{{busy}}" bind:press="{{needsLogin ? 'login' : 'load'}}"/>
 <ui-loading-state wx:if="{{showLoading && loading && !items.length && !record && !fields.length && !accountOpen}}" label="{{t.loading}}"/><view wx:if="{{showLoading && loading && (items.length || record || fields.length) && !sheet && !accountOpen}}" class="page-refresh-status" style="top:{{headerHeight}}px" role="status" aria-label="{{t.loading}}"/>
 <block wx:if="{{route === 'feed'}}">
  <view wx:if="{{nodeCards.length || nodesError}}" class="node-shelf">
   <template is="featureCarousel" data="{{cards:nodeCards,isNodes:true,current:nodeIndex,city:city,locale:locale,demo:demo}}"/>
   <view wx:if="{{nodesError}}" class="node-load-note"><text>{{nodesError}}</text><ui-button bind:press="retryNodes" variant="secondary" compact="{{true}}" label="{{t.retry}}"/></view>
  </view>
  <view class="section-heading people-heading"><text>{{t.people}}</text><ui-button bind:press="refreshPeople" variant="secondary" compact="{{true}}" label="{{t.refresh}}"/></view>
  <scroll-view scroll-x class="people-strip discovery-people horizontal-rail rail-page" enhanced show-scrollbar="{{false}}"><view class="horizontal-track"><ui-person-card rail="{{true}}" wx:for="{{people}}" wx:key="owner" person="{{item}}" t="{{t}}" locale="{{locale}}" reason="{{locale !== 'en' && item.reason_text ? item.reason_text : t[item.reason]}}" bind:interaction="uiInteraction"/></view></scroll-view>
 </block>
 <block wx:if="{{route === 'discover' || route === 'calendar'}}">
  <template wx:if="{{route === 'discover' && campaigns.length}}" is="featureCarousel" data="{{cards:campaigns,isNodes:false,current:bannerIndex,city:city,locale:locale,demo:demo}}"/>
  <view wx:if="{{route === 'discover'}}" class="calendar-entry" role="button" aria-label="{{t.calendar}}" data-route="calendar" bindtap="navigate"><view class="calendar-sticker" aria-hidden="true"><image src="{{illustrations.calendar}}"/></view><view class="grow"><text class="section-title">{{t.calendar}}</text><text class="meta">{{locale === 'en' ? 'This week · ' + calendarSummarySpaces + ' spaces · ' + calendarSummaryTotal + ' events' : '本周 ' + calendarSummarySpaces + ' 个空间 · ' + calendarSummaryTotal + ' 场活动'}}</text></view><text class="calendar-chevron" aria-hidden="true">›</text></view>
  <ui-calendar wx:if="{{route === 'calendar'}}" weekdays="{{weekdays}}" days="{{days}}" month="{{calendarMode === 'month'}}" hidden="{{!!sheet}}" disabled="{{busy}}" pending="{{loading}}" locale="{{locale}}" bind:interaction="uiInteraction">
  <view slot="header" class="calendar-period-switch"><ui-icon-button surface="plain" direction="left" data-delta="-1" bind:press="period" disabled="{{busy}}" loading="{{loading}}" icon="{{illustrations.back}}" label="{{t.previous}}"/><text class="calendar-period-label">{{calendarMode === 'month' ? monthLabel : rangeLabel}}</text><ui-icon-button surface="plain" direction="right" data-delta="1" bind:press="period" disabled="{{busy}}" loading="{{loading}}" icon="{{illustrations.back}}" label="{{t.next}}"/></view>
  </ui-calendar>
  <view class="filters">
   <view wx:if="{{route === 'discover'}}" class="filter-group"><ui-choice-group appearance="filter" mode="single" layout="tags" label="{{locale === 'en' ? 'Time period' : '活动时段'}}" options="{{route === 'discover' ? [{value:'week',label:t.week},{value:'next',label:t.nextWeek},{value:'month',label:t.month}] : [{value:'week',label:t.week},{value:'month',label:t.month}]}}" value="{{calendarMode === 'month' ? ['month'] : offset === 1 ? ['next'] : offset === 0 ? ['week'] : []}}" bind:change="periodChoice"/></view>

   <view class="filter-group"><scroll-view scroll-x class="chips filter-options horizontal-rail rail-page" role="radiogroup" aria-label="{{t.allSpaces}}"><view class="horizontal-track"><ui-filter-chip rail="{{true}}" selection-mode="single" data-key="space_id" data-value="" bind:press="filter" label="{{t.allSpaces}}" selected="{{!filters.space_id}}"/><ui-filter-chip rail="{{true}}" wx:for="{{spaces}}" wx:key="id" selection-mode="single" data-key="space_id" data-value="{{item.id}}" bind:press="filter" label="{{item.name}}" selected="{{filters.space_id === item.id}}"/></view></scroll-view></view>
   <view class="filter-group"><view class="chips filter-options"><ui-filter-chip data-key="free_only" data-value="{{!filters.free_only}}" bind:press="filter" label="{{t.free}}" selected="{{filters.free_only}}"/><ui-filter-chip data-key="has_capacity" data-value="{{!filters.has_capacity}}" bind:press="filter" label="{{t.capacity}}" selected="{{filters.has_capacity}}"/></view></view>
  </view>

  <view wx:if="{{route === 'calendar'}}" class="section-heading calendar-results-title"><view class="grow"><text class="section-title">{{selectedDate || (calendarMode === 'month' ? (locale === 'en' ? 'This month' : '本月活动') : (locale === 'en' ? 'This week' : '本周活动'))}}</text><text class="meta">{{total}} {{locale === 'en' ? (total === 1 ? 'event' : 'events') : '场活动'}}</text></view><ui-button loading="{{busy}}" bind:press="poster" variant="secondary" compact label="{{t.poster}}"/></view>
  <ui-button wx:if="{{route === 'calendar' && selectedDate}}" bind:press="clearDate" variant="secondary" compact label="{{locale === 'en' ? 'All dates' : '返回全部日期'}}"/>
  <ui-section wx:if="{{route === 'discover'}}" inset="none" title="{{total + ' ' + (locale === 'en' ? (total === 1 ? 'event' : 'events') : '场活动')}}"/>
 </block>

 <block wx:if="{{route === 'me'}}">
  <view wx:if="{{record}}" class="self-profile"><ui-identity-row data-route="member" data-id="{{currentUser}}" bind:press="navigate" src="{{(record.avatar_url) || ''}}" name="{{record.display_name}}" description="{{cityName + (record.bio ? ' · ' + record.bio : '')}}" size="60" interactive="{{true}}"><ui-button slot="actions" data-route="edit-profile" bind:press="navigate" variant="secondary" compact="{{true}}" label="{{locale === 'en' ? 'Edit profile' : '编辑资料'}}"/></ui-identity-row><view class="self-stats"><view class="self-stat-column"><ui-stat-link data-route="relations" value="{{me.following}}" label="{{t.following}}" bind:press="navigate"/></view><view class="self-stat-column"><ui-stat-link data-route="relations" data-extra="{{ {mode: 'followers'} }}" value="{{me.followers}}" label="{{t.followers}}" bind:press="navigate"/></view></view></view>
  <ui-menu-group wx:for="{{menuGroups}}" wx:key="id" title="{{item.title}}" title-inside><ui-action-row wx:for="{{item.rows}}" wx:for-item="entry" wx:key="label" data-route="{{entry.route}}" data-id="{{entry.id}}" data-kind="{{entry.kind}}" bind:press="menuEntry" label="{{entry.label}}" value="{{entry.value == null ? '' : entry.value}}" icon="{{illustrations[entry.icon]}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group wx:if="{{developerVisible}}"><ui-action-row data-route="review-lab" bind:press="navigate" label="{{locale === 'en' ? 'Developer' : '开发者'}}" icon="{{illustrations.developer}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group wx:if="{{record}}"><ui-action-row bind:press="logout" label="{{t.logout}}" icon="{{illustrations.logout}}"/></ui-menu-group>
 </block>
 <block wx:if="{{route === 'manage' && canManage}}">
  <view class="settings-intro"><text class="hero-title">{{t.manage}}</text><text class="body-text meta">{{locale === 'en' ? 'Create a space, or open one you already manage.' : '创建新的空间，或打开你已经管理的空间与组织。'}}</text></view>
  <ui-menu-group ><ui-action-row data-route="create-space" bind:press="navigate" label="{{locale === 'en' ? 'Create a space' : '创建空间'}}" icon="{{illustrations.publish}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group wx:if="{{managed.length}}" title="{{locale === 'en' ? 'Places you manage' : '我管理的'}}" title-inside><ui-action-row wx:for="{{managed}}" wx:key="id" data-route="{{item.kind === 'SPACE' ? 'space' : 'org'}}" data-id="{{item.id}}" bind:press="navigate" label="{{item.name}}" icon="{{illustrations[item.kind === 'SPACE' ? 'home' : 'org']}}" navigation="{{true}}"/></ui-menu-group>
 </block>
 <block wx:if="{{route === 'more'}}">
  <view class="settings-intro"><text class="hero-title">706 {{locale === 'en' ? 'Community' : '社区'}}</text><text class="body-text">{{locale === 'en' ? 'Community events and information for your language and city.' : '按你的语言和所在城市，提供更合适的活动与社区信息。'}}</text></view>
  <ui-menu-group ><ui-action-row data-route="onboarding" bind:press="navigate" label="{{locale === 'en' ? 'New member profile' : '新人资料'}}" value="{{record.onboarded ? (locale === 'en' ? 'Complete' : '已完成') : (locale === 'en' ? 'Complete profile' : '去完善')}}" icon="{{illustrations.new}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group ><ui-action-row bind:press="chooseCity" label="{{t.city}}" description="{{locale === 'en' ? 'Current city' : '当前城市'}}" value="{{cityName}}" icon="{{illustrations.city}}" navigation="{{true}}"/><ui-action-row data-kind="language" bind:press="sheet" label="{{t.language}}" description="{{locale === 'en' ? 'Interface language' : '选择界面语言'}}" value="{{locale === 'en' ? 'English' : '简体中文'}}" icon="{{illustrations.language}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group ><ui-action-row data-kind="notifications" bind:press="sheet" label="{{t.notificationSettings}}" value="{{record.notification_preferences.enabled ? (locale === 'en' ? 'On' : '已开启') : (locale === 'en' ? 'Off' : '已关闭')}}" icon="{{illustrations.bell}}" navigation="{{true}}"/><ui-action-row data-route="privacy" bind:press="navigate" label="{{locale === 'en' ? 'Privacy and security' : '隐私与安全'}}" icon="{{illustrations.shield}}" navigation="{{true}}"/><ui-action-row data-route="blocks" bind:press="navigate" label="{{t.blocks}}" icon="{{illustrations.shield}}" navigation="{{true}}"/></ui-menu-group>
  <ui-menu-group ><ui-action-row data-kind="about" bind:press="sheet" label="{{locale === 'en' ? 'About 706 Community' : '关于 706 社区'}}" icon="{{illustrations.info}}" navigation="{{true}}"/><ui-action-row data-route="feedback" bind:press="navigate" label="{{locale === 'en' ? 'Feedback and suggestions' : '反馈与建议'}}" icon="{{illustrations.feedback}}" navigation="{{true}}"/></ui-menu-group>
 </block>
 <block wx:if="{{route === 'event' || route === 'activity-preview'}}">
  <view wx:if="{{record}}"><ui-gallery wx:if="{{record.galleryUrls.length}}" urls="{{record.galleryUrls}}" current="{{galleryIndex}}" locale="{{locale}}" bind:interaction="uiInteraction"/>
   <view class="event-overview"><view class="event-overview-copy"><text class="hero-title">{{record.title}}</text><view wx:if="{{record.detailSummary || record.detailDescription}}" class="section event-information"><text class="section-title">{{locale === 'en' ? 'About this event' : '活动介绍'}}</text><text wx:if="{{record.detailSummary}}" class="body-text">{{record.detailSummary}}</text></view></view></view>
   <view wx:if="{{record.detailDescription}}" class="event-description"><text class="body-text">{{record.detailDescription}}</text></view><view wx:if="{{record.tags.length}}" class="chips event-overview-tags"><text wx:for="{{record.tags}}" wx:key="*this" class="chip">{{item}}</text></view>
   <view wx:if="{{route === 'event' && record.fit_description}}" class="section event-information"><text class="section-title">{{locale === 'en' ? 'Who is it for' : '适合谁参加'}}</text><text class="body-text">{{record.fit_description}}</text></view>
   <view class="detail-facts section"><text class="section-title">{{locale === 'en' ? 'Time and place' : '时间与地点'}}</text>
    <ui-fact-row icon="{{illustrations.calendar}}" label="{{record.dateLine}}" description="{{locale === 'en' ? 'Registration stays open until the event ends' : '报名开放至活动结束'}}"/>
    <ui-fact-row icon="{{illustrations.location}}" label="{{record.venue_display || record.venue_name}}" description="{{record.address}}" interactive="{{!!record.space_id}}" data-route="space" data-id="{{record.space_id}}" bind:press="navigate"/>
    <ui-fact-row icon="{{illustrations.ticket}}" label="{{record.price_minor ? record.feeLabel + (locale === 'en' ? ' / person' : ' / 人') : (locale === 'en' ? 'Free admission' : '免费参加')}}" description="{{!record.bookingOpen ? record.bookingLabel : record.remaining == null ? t.unlimited : (locale === 'en' ? record.remaining + ' places left' : '还剩 ' + record.remaining + ' 个名额')}}"/>
   </view>
   <view wx:if="{{route === 'event'}}" class="section event-person-card"><text class="section-title">{{t.organizer}}</text><ui-identity-row data-route="member" data-id="{{record.owner}}" bind:press="navigate" src="{{(record.initiator.avatar_url) || ''}}" name="{{record.initiator.display_name || record.host_display}}" description="{{locale === 'en' ? 'Host · ' + record.host_recent_count + ' recent events' : '发起人 · 最近组织 ' + record.host_recent_count + ' 场活动'}}" interactive="{{true}}"/></view>
   <ui-participant-summary wx:if="{{route === 'event'}}" data-kind="participants" participants="{{record.detailParticipants}}" label="{{locale === 'en' ? record.capacityLabel : '已有 ' + (record.capacity == null ? record.registered : record.capacityDisplay) + ' 人决定参加'}}" bind:press="sheet"/>
   <view wx:if="{{record.campaigns.length}}" class="detail-series-links"><text class="section-title">{{locale === 'en' ? 'Part of a series' : '所属专题'}}</text><view class="detail-series-actions"><ui-button wx:for="{{record.campaigns}}" wx:key="id" data-route="campaign" data-id="{{item.id}}" bind:press="navigate" variant="secondary" compact="{{true}}" custom="{{true}}"><text class="grow">{{item.title}}</text><text aria-hidden="true">›</text></ui-button></view></view>
   <view wx:if="{{route === 'event'}}" class="row event-secondary-actions"><ui-button variant="secondary" compact="{{true}}" open-type="share" label="{{locale === 'en' ? 'Share event' : '分享活动'}}"/><ui-button wx:if="{{record.recommended}}" label="{{t.withdrawRecommendation}}" variant="danger" compact data-op="withdrawRecommendation" bind:press="action" disabled="{{busy}}" loading="{{busy}}"/><ui-button label="{{t.clone}}" variant="secondary" compact data-op="clone" bind:press="action" disabled="{{busy}}" loading="{{busy}}"/></view>
   <view wx:if="{{route === 'event'}}" class="section event-discussion"><view class="section-heading"><text>{{t.comments}}</text><ui-button label="{{locale === 'en' ? 'Write a comment' : '写评论'}}" variant="secondary" compact data-kind="comment" bind:press="sheet"/></view><ui-comment-thread wx:for="{{detailThreads}}" wx:key="id" item="{{item}}" t="{{t}}" current-user="{{currentUser}}" locale="{{locale}}" busy="{{busy}}" bind:interaction="uiInteraction"/></view>
   <view wx:if="{{route === 'event' && (record.can_edit || record.can_check_in)}}" class="event-management">
    <text class="section-title">{{locale === 'en' ? 'Event management' : '活动管理'}}</text>
    <view class="management-group">
     <ui-action-row wx:if="{{record.can_edit && record.status === 'PUBLISHED'}}" label="{{t.edit}}" navigation divider data-route="publish" data-id="{{record.id}}" bind:press="navigate"/>
     <ui-action-row label="{{t.attendees}}" navigation divider="{{record.can_edit}}" data-route="attendees" data-id="{{record.id}}" bind:press="navigate"/>
     <ui-action-row wx:if="{{record.can_edit}}" label="{{t.progress}}" navigation divider data-route="approval-progress" data-id="{{record.id}}" bind:press="navigate"/>
     <ui-action-row wx:if="{{record.can_cancel}}" label="{{t.cancelEvent}}" tone="danger" data-op="cancelEvent" bind:press="action" disabled="{{busy}}" loading="{{busy}}"/>
    </view>
   </view>
   <ui-floating-bar wx:if="{{route === 'event'}}"><ui-button data-kind="recommend" bind:press="sheet" variant="secondary" label="{{record.recommended ? (locale === 'en' ? 'Recommended' : '已推荐') : t.recommend}}"/><ui-button wx:if="{{record.activeRegistration}}" data-route="event-access" data-id="{{record.registration.id}}" bind:press="navigate" variant="primary" grow="{{true}}" label="{{record.registrationAction}}"/><ui-button wx:else disabled="{{!canRegister || (record.remaining === 0 && !record.waitlist_enabled)}}" data-kind="register" bind:press="sheet" variant="primary" grow="{{true}}" label="{{!canRegister ? t.closed : record.remaining === 0 ? (record.waitlist_enabled ? t.waitlist : t.full) : record.approval_required ? (locale === 'en' ? 'Apply to join' : '申请报名') : (locale === 'en' ? 'Join event' : '立即报名')}}"/></ui-floating-bar>
  </view>
 </block>
 <block wx:if="{{route === 'campaign' && record}}">
  <ui-gallery wx:if="{{record.galleryUrls.length}}" urls="{{record.galleryUrls}}" current="{{galleryIndex}}" locale="{{locale}}" label="{{locale === 'en' ? 'Series photos' : '专题图片'}}" bind:interaction="uiInteraction"/>
  <view class="campaign-overview"><text wx:if="{{record.kicker}}" class="campaign-kicker">{{record.kicker}}</text><text class="hero-title">{{record.title}}</text><text wx:if="{{record.citySummary}}" class="campaign-cities">{{record.citySummary}}</text></view>
  <view wx:if="{{!localPreview}}" class="campaign-actions"><view class="grow"><ui-button variant="secondary" block open-type="share" label="{{locale === 'en' ? 'Share series' : '分享系列'}}"/></view><view wx:if="{{record.can_edit}}" class="grow"><ui-button data-route="campaign-edit" data-id="{{record.id}}" bind:press="navigate" variant="primary" block label="{{locale === 'en' ? 'Manage series' : '管理系列'}}"/></view><view wx:if="{{record.can_edit}}" class="grow"><ui-button data-op="deleteCampaign" data-id="{{record.id}}" bind:press="action" variant="danger" block label="{{t.deleteCampaign}}" disabled="{{busy}}"/></view></view>
  <ui-section wx:if="{{record.introduction}}" title="{{locale === 'en' ? 'About this series' : '关于这个系列'}}"><text class="campaign-introduction">{{record.introduction}}</text></ui-section>
 </block>
 <block wx:if="{{route === 'member' && record}}">
  <view class="member-hero"><ui-identity-row src="{{record.avatar_url || ''}}" name="{{record.display_name}}" description="{{record.cityLabel}}" size="60"/><view class="member-id"><text class="member-id-label">ID</text><text class="member-id-value" selectable user-select="{{true}}">{{record.owner}}</text><ui-button variant="text" compact="{{true}}" label="{{t.copy}}" data-value="{{record.owner}}" bind:press="copy"/></view><text wx:if="{{record.bio}}" class="member-signature">{{record.bio}}</text><text wx:if="{{record.introduction}}" class="member-intro">{{record.introduction}}</text>
   <view wx:if="{{record.owner === currentUser && accountPending}}" class="profile-next-step"><ui-button block variant="primary" label="{{locale === 'en' ? 'Continue where you left off' : '继续刚才的操作'}}" bind:press="returnFromAccount"/></view>
