<template name="eventCard">
 <view aria-hidden="{{modalOpen}}" class="event-card {{large ? 'event-card-large' : ''}}" data-id="{{e.id}}" bindtap="openEvent">
  <view wx:if="{{large}}" class="large-card-art"><image src="{{e.cover_url}}" mode="aspectFill"/><view class="large-card-shade"/><text class="large-card-count">{{e.registered}} {{t.registered}}</text><text class="large-card-title">{{e.title}}</text></view>
  <view class="event-main"><view class="event-info"><button wx:if="{{interactiveTitle}}" class="event-title event-title-link" data-id="{{e.id}}" catchtap="openEvent">{{e.title}}</button><text wx:else class="event-title">{{e.title}}</text><view class="event-badges"><text class="event-status">{{e.bookingLabel}}</text><text wx:if="{{e.activeRegistration}}" class="attendance-status">{{t[e.registration.status]}}</text></view><view class="card-fact"><view class="glyph glyph-calendar"/><text>{{e.dateOnly}} · {{e.timeOnly}}–{{e.endTime}}</text></view><view class="card-fact"><view class="glyph glyph-location"/><text>{{e.venue_display || e.venue_name}}</text></view><view class="card-fact"><view class="glyph glyph-group"/><text>{{e.organization_name || e.host_display}}</text></view><view class="card-fact"><image wx:if="{{e.initiator.avatar_url}}" class="mini-avatar" src="{{e.initiator.avatar_url}}"/><view wx:else class="glyph glyph-person"/><text>{{e.initiator.display_name || e.host_display}}</text></view></view>
   <view class="event-side"><view class="event-art"><image wx:if="{{e.cover_url}}" class="event-cover" src="{{e.cover_url}}" mode="aspectFill"/><view wx:else class="event-cover placeholder">706</view><text class="cover-time">{{e.timeOnly}}</text></view><view class="card-side-actions"><text>{{e.feeLabel}}</text><button class="recommend-icon {{e.recommended ? 'is-recommended' : ''}}" aria-label="{{t.recommend}}" data-id="{{e.id}}" data-enabled="{{!e.recommended}}" catchtap="cardRecommend"><view class="glyph glyph-star"/></button></view></view>
  </view>
  <view class="participant" data-route="{{e.can_manage ? 'attendees' : 'event'}}" data-id="{{e.id}}" catchtap="navigate"><view><text class="participant-label">{{t.registered}} {{e.registered || 0}}</text><text class="participant-note">{{e.remaining === null ? t.unlimited : t.remaining + ' ' + e.remaining}}</text><text wx:if="{{e.can_manage && e.pending_count}}" class="participant-note">{{e.pending_count}} {{t.PENDING}}</text></view><view class="avatar-stack"><image wx:for="{{e.participants}}" wx:for-item="person" wx:key="owner" src="{{person.avatar_url}}" class="stack-avatar"/><text wx:if="{{e.participantOverflow > 0}}" class="stack-avatar overflow">+{{e.participantOverflow}}</text><text class="participant-chevron">›</text></view></view>
 </view>
</template>
<view class="screen page-{{route}} {{demo && reviewIndex >= 0 ? 'reviewing' : ''}} {{route === 'event' ? 'has-bottom' : ''}}" style="{{theme}}">
 <button class="demo-banner" data-route="review-lab" bindtap="navigate">{{demo ? '演示数据 · ' + demoName + ' · 切换 / 页面目录 →' : 'Montana 真实服务 · 模式设置 →'}}</button>
 <view wx:if="{{demo && reviewIndex >= 0}}" class="review-controls"><button class="small" data-delta="-1" bindtap="reviewNext">‹</button><text>{{reviewIndex + 1}} / 118</text><button class="small" data-delta="-1" bindtap="reviewScroll">↑</button><button class="small" data-delta="1" bindtap="reviewScroll">↓</button><button class="small" data-delta="1" bindtap="reviewNext">›</button></view>
 <block wx:if="{{route === 'review-lab'}}"><view class="card"><text class="hero-title">待查看页面</text><text class="body-text">12 项待修、32 项待核对、4 个额外路由，共 48 项。已核对的 19 项不列入；开发核对不代表本人验收。</text><text class="meta">点击切换到对应演示身份与上海筛选，保留 r12 业务记录与草稿，不重置数据。页面顶部“页面目录”可返回。</text><button wx:if="{{!demo}}" class="secondary" bindtap="labMode">切换到离线演示后查看</button></view><view wx:if="{{demo}}" class="menu"><view wx:for="{{pendingCatalog}}" wx:key="index"><button class="menu-item catalog-button" data-index="{{item.index}}" data-pending="{{true}}" bindtap="labOpen">{{item.label}}　›</button><text wx:if="{{item.note}}" class="meta">{{item.note}}</text></view></view></block>
 <view wx:if="{{route === 'feed' || route === 'discover'}}" class="topbar"><button class="city" bindtap="chooseCity"><text>{{cityName}}</text><text class="picker-chevron">⌄</text></button><view wx:if="{{route === 'discover'}}" class="search"><input value="{{query}}" placeholder="{{t.search}}" bindinput="searchInput" bindconfirm="search" confirm-type="search"/></view><button wx:if="{{route === 'discover'}}" class="icon-button" bindtap="search">⌕</button></view>
 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="small" bindtap="{{needsLogin ? 'login' : 'load'}}">{{needsLogin ? t.login : t.retry}}</button></view>
 <view wx:if="{{loading && !items.length && !record}}" class="skeleton"><view/><view/><view/></view>
 <block wx:if="{{route === 'feed'}}">
  <view class="section-heading"><text>{{t.people}}</text><button class="text-button" data-kind="why" bindtap="sheet">ⓘ</button><button class="text-button" bindtap="refreshPeople">{{t.refresh}}</button></view>
  <scroll-view scroll-x class="people-strip"><view class="person" wx:for="{{people}}" wx:key="id"><view class="person-content" data-route="member" data-id="{{item.owner}}" bindtap="navigate"><image class="avatar" src="{{item.avatar_url}}"/><text>{{item.display_name}}</text><text class="meta">{{item.bio}}</text><text class="person-reason">{{locale !== 'en' && item.reason_text ? item.reason_text : t[item.reason]}}</text></view><button wx:if="{{item.owner === currentUser}}" class="small" data-route="edit-profile" bindtap="navigate">{{t.edit}}</button><button wx:else class="small" data-id="{{item.owner}}" data-enabled="{{!item.following}}" bindtap="follow">{{item.following ? t.unfollow : '＋ ' + t.follow}}</button></view></scroll-view>
 </block>
 <block wx:if="{{route === 'discover' || route === 'calendar'}}">
  <view wx:if="{{route === 'discover'}}" class="calendar-entry" data-route="calendar" bindtap="navigate"><text class="section-title">{{t.calendar}} ↗</text><text class="meta">{{t.week}} · {{rangeSpaceCount}} {{t.spaces}} · {{total}} {{t.event}}</text></view>
  <view wx:if="{{route === 'discover' && campaigns.length}}" class="banner-pages"><swiper current="{{bannerIndex || 0}}" bindchange="bannerChange" indicator-dots indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#ffffff" circular class="campaign-swiper"><swiper-item wx:for="{{campaigns}}" wx:key="id"><view class="campaign-slide" data-route="campaign" data-id="{{item.id}}" bindtap="navigate"><image src="{{item.cover_url}}" class="campaign-background" mode="aspectFill"/><view class="campaign-shade"/><view class="campaign-copy"><text class="banner-kicker">{{item.kicker}}</text><text class="banner-title">{{item.title}}</text><text class="banner-description">{{item.banner_description || item.introduction}}</text><text class="banner-link">{{locale === 'en' ? 'View series' : '查看系列'}} ›</text></view></view></swiper-item></swiper><view class="banner-controls"><button class="text-button" data-delta="-1" bindtap="bannerMove" aria-label="上一张">‹</button><text>{{(bannerIndex || 0) + 1}} / {{campaigns.length}}</text><button class="text-button" data-delta="1" bindtap="bannerMove" aria-label="下一张">›</button></view></view>
  <view class="filters">
   <view class="chips"><button class="chip {{calendarMode === 'week' && offset === 0 ? 'selected' : ''}}" data-key="date" data-value="week" bindtap="filter">{{t.week}}</button><button wx:if="{{route === 'discover'}}" class="chip {{offset === 1 ? 'selected' : ''}}" data-key="date" data-value="next" bindtap="filter">{{t.nextWeek}}</button><button wx:if="{{route === 'discover'}}" class="chip" data-key="date" data-value="calendar" bindtap="filter">{{t.calendar}}</button><button wx:else class="chip {{calendarMode === 'month' ? 'selected' : ''}}" data-mode="month" bindtap="calendarMode">{{t.month}}</button><button wx:if="{{route === 'calendar'}}" class="text-button calendar-export" bindtap="poster">{{t.poster}}</button></view><view wx:if="{{route === 'calendar'}}" class="calendar-heading calendar-period"><button class="icon-button" data-delta="-1" bindtap="period" aria-label="上一周期">‹</button><text>{{calendarMode === 'month' ? monthLabel : rangeLabel}}</text><button class="icon-button" data-delta="1" bindtap="period" aria-label="下一周期">›</button></view>
  <view wx:if="{{route === 'discover' && showWeek}}" aria-hidden="{{!!sheet}}" class="calendar-box {{calendarMode === 'month' ? 'month-calendar' : 'week-calendar'}}"><view class="calendar-heading"><button class="icon-button" data-delta="-1" bindtap="period" aria-label="上一周期">‹</button><text>{{monthLabel}}</text><button class="icon-button" data-delta="1" bindtap="period" aria-label="下一周期">›</button></view><view class="calendar-grid weekday-row"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'blank-day' : ''}}" ><button class="day-number" aria-label="{{item.date}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="selectDay">{{item.label}}</button><block wx:if="{{calendarMode === 'month'}}"><button wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="month-event" data-id="{{event.id}}" catchtap="openEvent">{{event.title}}</button></block><text wx:else class="dot">{{item.count ? '•' : ' '}}</text></view></view><text class="meta calendar-caption">{{rangeLabel}}</text></view>
   <scroll-view scroll-x class="chips"><button class="chip {{!filters.space_id ? 'selected' : ''}}" data-key="space_id" data-value="" bindtap="filter">{{t.allSpaces}}</button><button wx:for="{{spaces}}" wx:key="id" class="chip {{filters.space_id === item.id ? 'selected' : ''}}" data-key="space_id" data-value="{{item.id}}" bindtap="filter">{{item.name}}</button></scroll-view>
   <scroll-view scroll-x class="chips"><button class="chip {{!filters.tag && !filters.free_only && !filters.has_capacity ? 'selected' : ''}}" data-key="clearTags" bindtap="filter">{{t.any}}</button><button class="chip {{filters.free_only ? 'selected' : ''}}" data-key="free_only" data-value="{{!filters.free_only}}" bindtap="filter">{{t.free}}</button><button class="chip {{filters.has_capacity ? 'selected' : ''}}" data-key="has_capacity" data-value="{{!filters.has_capacity}}" bindtap="filter">{{t.capacity}}</button><button wx:for="{{route === 'calendar' ? ['screening','outdoor'] : ['reading','screening','outdoor']}}" wx:key="*this" class="chip {{filters.tag === item ? 'selected' : ''}}" data-key="tag" data-value="{{item}}" bindtap="filter">{{t[item]}}</button></scroll-view>
  </view>

  <view wx:if="{{route === 'calendar'}}" aria-hidden="{{!!sheet}}" class="calendar-box {{calendarMode === 'month' ? 'month-calendar' : 'week-calendar'}}"><view class="calendar-grid weekday-row"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'blank-day' : ''}}" ><button class="day-number" aria-label="{{item.date}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="selectDay">{{item.label}}</button><block wx:if="{{calendarMode === 'month'}}"><button wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="month-event" data-id="{{event.id}}" catchtap="openEvent">{{event.title}}</button></block><text wx:else class="dot">{{item.count ? '•' : ' '}}</text></view></view><text class="meta calendar-caption">{{rangeLabel}}</text></view>
  <view wx:if="{{route === 'calendar' && calendarMode === 'month'}}" class="month-legend"><text>● {{locale === 'en' ? 'Has events' : '有活动'}}</text><text>{{total}} {{locale === 'en' ? 'events' : '场活动'}}</text></view>
  <view wx:if="{{route === 'calendar'}}" class="section-heading calendar-results-title"><view><text class="section-title">{{selectedDate || (calendarMode === 'month' ? (locale === 'en' ? 'This month' : '本月活动') : (locale === 'en' ? 'Event overview' : '活动概览'))}}</text><text class="meta">{{total}} {{t.event}}</text></view><button wx:if="{{selectedDate}}" class="text-button" bindtap="clearDate">{{locale === 'en' ? 'All dates' : '返回全部日期'}}</button><view wx:elif="{{calendarMode === 'week'}}" class="row overview-nav"><button class="text-button" aria-label="周内前几天" data-delta="-1" bindtap="moveTimeline">‹</button><button class="text-button" aria-label="周内后几天" data-delta="1" bindtap="moveTimeline">›</button></view></view>
  <scroll-view wx:if="{{route === 'calendar' && calendarMode !== 'month'}}" scroll-y scroll-top="{{timelineScrollTop}}" class="timeline-viewport"><view class="calendar-timeline"><view class="time-scale" style="height:{{timeline.height + 110}}rpx"><text wx:for="{{timeline.hours}}" wx:key="label" style="top:{{item.top + 70}}rpx">{{item.label}}</text></view><scroll-view scroll-x scroll-left="{{timelineScrollLeft}}" bindscroll="timelineScrolled" class="timeline-scroll"><view class="timeline-columns"><view wx:for="{{timeline.days}}" wx:key="date" class="timeline-day {{selectedDate ? 'one-day' : ''}}"><text class="timeline-date">{{item.date}}</text><view class="timeline-grid" style="height:{{timeline.height}}rpx"><view wx:for="{{timeline.hours}}" wx:for-item="hour" wx:key="label" class="hour-rule" style="top:{{hour.top}}rpx"/><button wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="timeline-event {{event.compact ? 'compact' : ''}}" style="top:{{event.top}}rpx;height:{{event.height}}rpx;left:{{event.left}}%;width:{{event.width}}%" data-id="{{event.id}}" bindtap="openEvent"><text class="timeline-title">{{event.title}}</text><text>{{event.range}}</text><text wx:if="{{!event.compact}}">{{event.host_display}}</text><text wx:if="{{!event.compact}}">{{event.venue_display}}</text><text wx:if="{{event.continuesBefore || event.continuesAfter}}">{{event.continuesBefore ? '← ' : ''}}{{locale === 'en' ? 'Continues' : '跨日活动'}}{{event.continuesAfter ? ' →' : ''}}</text></button></view></view></view></scroll-view></view></scroll-view>
  <view wx:if="{{route === 'discover'}}" class="section-heading"><text>{{total}} {{t.event}}</text></view>
 </block>
 <block wx:if="{{route === 'messages'}}"><view class="row"><scroll-view scroll-x class="chips grow"><button wx:for="{{['','ADMIN','EVENT','SOCIAL']}}" wx:key="*this" class="chip {{category === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="category">{{t[item] || t.all}}</button></scroll-view><button class="text-button" bindtap="markRead">{{t.readAll}}</button></view></block>
 <block wx:if="{{route === 'me'}}">
  <view wx:if="{{record}}" class="self-profile"><view class="row"><view class="self-identity" data-route="member" data-id="{{currentUser}}" bindtap="navigate"><image class="avatar large" src="{{record.avatar_url}}"/><view><text class="hero-title">{{record.display_name}}</text><text class="meta">{{cityName}} · {{record.bio}}</text></view></view><button class="small" data-route="edit-profile" bindtap="navigate">{{locale === 'en' ? 'Edit profile' : '编辑资料'}}</button></view><view class="self-stats"><button data-route="relations" bindtap="navigate"><text>{{me.following}}</text><text>{{t.following}}</text></button><button data-route="relations" data-extra="{{ {mode: 'followers'} }}" bindtap="navigate"><text>{{me.followers}}</text><text>{{t.followers}}</text></button></view></view>
  <button wx:if="{{me.roles.length}}" class="admin-summary" data-route="approvals" bindtap="navigate"><view><text class="section-title">{{locale === 'en' ? 'Admin tasks' : '管理员待办'}}</text><text class="meta">{{reviewCount ? reviewCount + (locale === 'en' ? ' events or series await review' : ' 个活动或专题正在等待审核') : (locale === 'en' ? 'All reviews complete' : '新的审核都处理完了')}}</text></view><text class="admin-count">{{reviewCount}}</text></button>
  <view wx:for="{{menuGroups}}" wx:key="id" class="settings-menu"><button wx:for="{{item.rows}}" wx:for-item="entry" wx:key="route" class="settings-row" data-route="{{entry.route}}" data-id="{{entry.id}}" bindtap="navigate"><view class="settings-icon"><view class="settings-glyph icon-{{entry.icon}}"/></view><text class="settings-label">{{entry.label}}</text><text class="settings-value">{{entry.value}}</text><text class="settings-chevron">›</text></button></view>
 </block>
 <block wx:if="{{route === 'more'}}">
  <view class="settings-intro"><text class="hero-title">706 {{locale === 'en' ? 'Community' : '社区'}}</text><text class="body-text">{{locale === 'en' ? 'Community events and information for your language and city.' : '按你的语言和所在城市，提供更合适的活动与社区信息。'}}</text></view>
  <view class="settings-menu"><button class="settings-row" data-route="onboarding" bindtap="navigate"><view class="settings-icon"><view class="settings-glyph icon-new"/></view><text class="settings-label">{{locale === 'en' ? 'New member profile' : '新人资料'}}</text><text class="settings-value">{{record.onboarded ? (locale === 'en' ? 'Complete' : '已完成') : (locale === 'en' ? 'Complete profile' : '去完善')}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" bindtap="chooseCity"><view class="settings-icon"><view class="settings-glyph icon-city"/></view><view class="settings-label"><text>{{t.city}}</text><text class="meta">{{locale === 'en' ? 'Current city' : '当前城市'}}</text></view><text class="settings-value">{{cityName}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-kind="language" bindtap="sheet"><view class="settings-icon"><view class="settings-glyph icon-language"/></view><view class="settings-label"><text>{{t.language}}</text><text class="meta">{{locale === 'en' ? 'Interface language' : '选择界面语言'}}</text></view><text class="settings-value">{{locale === 'en' ? 'English' : '简体中文'}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" data-kind="notifications" bindtap="sheet"><view class="settings-icon"><view class="settings-glyph icon-bell"/></view><text class="settings-label">{{t.notificationSettings}}</text><text class="settings-value">{{record.notification_preferences.enabled ? (locale === 'en' ? 'On' : '已开启') : (locale === 'en' ? 'Off' : '已关闭')}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-route="privacy" bindtap="navigate"><view class="settings-icon"><view class="settings-glyph icon-shield"/></view><text class="settings-label">{{locale === 'en' ? 'Privacy and security' : '隐私与安全'}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" data-kind="about" bindtap="sheet"><view class="settings-icon"><view class="settings-glyph icon-info"/></view><text class="settings-label">{{locale === 'en' ? 'About 706 Community' : '关于 706 社区'}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-route="feedback" bindtap="navigate"><view class="settings-icon"><view class="settings-glyph icon-feedback"/></view><text class="settings-label">{{locale === 'en' ? 'Feedback and suggestions' : '反馈与建议'}}</text><text class="settings-chevron">›</text></button></view>
  <button class="settings-logout" bindtap="logout">{{t.logout}}</button>
 </block>
 <block wx:if="{{route === 'event' || route === 'activity-preview'}}">
  <view wx:if="{{record}}"><image wx:if="{{record.cover_url}}" class="detail-cover" src="{{mediaPreviews.cover_url || record.cover_url}}" mode="aspectFill" data-url="{{mediaPreviews.cover_url || record.cover_url}}" bindtap="previewImage"/><view class="detail-intro"><text class="event-status">{{record.bookingLabel}}</text><text class="hero-title">{{record.title}}</text><text class="body-text">{{record.dateLabel}}–{{record.endTime}} · {{record.cityLabel}}</text><button wx:for="{{record.campaigns}}" wx:key="id" class="banner detail-campaign" data-route="campaign" data-id="{{item.id}}" bindtap="navigate"><text class="meta">{{locale === 'en' ? 'Multi-city series' : '多城联动系列'}}</text><text>{{item.title}} ↗</text></button></view>
   <view wx:if="{{route === 'event'}}" class="detail-social"><view class="avatar-stack"><image wx:for="{{record.detailParticipants}}" wx:key="owner" class="stack-avatar" src="{{item.avatar_url}}" data-route="member" data-id="{{item.owner}}" bindtap="navigate"/></view><text><text class="social-names">{{record.participantNames}}</text>{{record.participantNames ? (locale === 'en' ? ' and others · ' : ' 等 ') : ''}}{{record.registered}}{{locale === 'en' ? ' registered' : ' 人已经报名'}}</text></view>
   <view class="detail-facts"><view class="detail-fact"><view class="glyph glyph-calendar"/><view class="grow"><text class="fact-main">{{record.dateLabel}}–{{record.endTime}}</text><text class="meta">{{locale === 'en' ? 'Registration closes 2 hours before the event' : '活动开始前 2 小时停止报名'}}</text></view></view><button class="detail-fact detail-location" data-route="space" data-id="{{record.space_id}}" bindtap="navigate"><view class="glyph glyph-location"/><view class="grow"><text class="fact-main">{{record.venue_display || record.venue_name}}</text><text class="meta">{{record.address}}</text></view><text>›</text></button><view class="detail-fact"><view class="glyph icon-ticket"/><view class="grow"><text class="fact-main">{{record.price_minor ? record.feeLabel + (locale === 'en' ? ' / person' : ' / 人') : (locale === 'en' ? 'Free admission' : '免费参加')}}</text><text class="meta">{{record.remaining === null ? t.unlimited : record.remaining === 0 ? (locale === 'en' ? 'Waitlist available' : '可以加入候补') : (locale === 'en' ? record.remaining + ' places left' : '还剩 ' + record.remaining + ' 个名额')}}</text></view></view></view>
   <view class="section"><text class="section-title">{{locale === 'en' ? 'About this event' : '关于活动'}}</text><text class="body-text">{{record.summary}}</text><view class="chips"><text wx:for="{{record.tags}}" wx:key="*this" class="chip">{{item}}</text></view></view><view wx:if="{{route === 'event'}}" class="section"><text class="section-title">{{locale === 'en' ? 'Who is it for' : '适合谁参加'}}</text><text class="body-text">{{record.fit_description}}</text></view>
   <view wx:if="{{route === 'event'}}" class="section"><text class="section-title">{{t.organizer}}</text><button class="member-row" data-route="member" data-id="{{record.owner}}" bindtap="navigate"><image class="avatar" src="{{record.initiator.avatar_url}}"/><view class="grow"><text class="section-title">{{record.initiator.display_name || record.host_display}}</text><text class="meta">{{locale === 'en' ? 'Host · ' + record.host_recent_count + ' recent events' : '发起人 · 最近组织 ' + record.host_recent_count + ' 场活动'}}</text></view><text>›</text></button><button class="member-row" data-route="space" data-id="{{record.space_id}}" bindtap="navigate"><view class="venue-mark"><view class="glyph icon-home"/></view><view class="grow"><text class="section-title">{{record.venue_display || record.venue_name}}</text><text class="meta">{{record.organization_name || t.personal}}</text></view><text>›</text></button></view>
   <view wx:if="{{route === 'event'}}" class="section"><view class="section-heading"><text>{{t.comments}}</text><button class="text-button" data-kind="comment" bindtap="sheet">{{locale === 'en' ? 'Write a comment' : '写评论'}}</button></view><view wx:for="{{detailThreads}}" wx:key="id" class="comment"><view class="row"><image class="avatar" src="{{item.author.avatar_url}}" data-route="member" data-id="{{item.owner}}" bindtap="navigate"/><text class="section-title" data-route="member" data-id="{{item.owner}}" bindtap="navigate">{{item.author.display_name}}</text><text wx:if="{{item.badge}}" class="attendance-status">{{item.badge}}</text></view><text class="body-text">{{item.text}}</text><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-reply">{{reply.author.display_name}}：{{reply.text}}</view><view class="row"><button class="text-button" data-kind="comment" data-reply="{{item.id}}" bindtap="sheet">{{t.reply}}</button><button wx:if="{{item.owner === currentUser}}" class="text-button" data-op="deleteComment" data-id="{{item.id}}" bindtap="action">{{t.delete}}</button></view></view></view>
   <view wx:if="{{route === 'event'}}" class="row"><button class="secondary" open-type="share">{{t.share}}</button><button wx:if="{{record.recommended}}" class="secondary" data-op="withdrawRecommendation" bindtap="action">{{t.withdrawRecommendation}}</button><button class="secondary" data-op="clone" bindtap="action">{{t.clone}}</button></view>
