<ui-sheet wx:if="{{sheet}}" title="{{(sheet === 'notifications' ? t.notificationSettings : sheet === 'participants' ? (locale === 'en' ? 'Participants' : '参与者') : sheetCopy.titles[sheet] || t.confirm) + (sheet === 'comment' ? ' · ' + commentCount : '')}}" description="{{(sheet === 'group' && record.event.price_minor === 0 ? (locale === 'en' ? 'Your registration is confirmed. View the group and organizer instructions below.' : '你的报名已确认，可查看活动群和组织者的参与说明。') : sheetCopy.descriptions[sheet]) || ''}}" error="{{error}}" busy="{{busy}}" poster="{{sheet === 'poster'}}" close-label="{{sheet === 'group' || sheet === 'why' ? (locale === 'en' ? 'Done' : '完成') : t.cancel}}" bind:close="requestCloseSheet">
 <block wx:if="{{sheet === 'participants'}}"><text class="body-text">{{record.capacityLabel}}</text><text class="meta">{{locale === 'en' ? 'Only public profiles returned by the event are shown. This is not the complete registration list.' : '仅展示活动返回的公开参与者资料，并非完整报名名单。'}}</text><ui-identity-row wx:for="{{record.participants}}" wx:key="owner" data-route="member" data-id="{{item.owner}}" bind:press="navigate" src="{{(item.avatar_url) || ''}}" name="{{item.display_name}}" description="" interactive="{{true}}"/><text wx:if="{{!record.participants.length}}" class="meta">{{locale === 'en' ? 'No public participants to show yet' : '暂无可展示的公开参与者'}}</text></block>
 <block wx:elif="{{sheet === 'poster'}}"><text class="section-title">{{cityName}} · {{posterTitle}}</text><text class="meta">{{t.posterNotice}}</text><text class="meta">{{posterPeriod}}</text><scroll-view scroll-y class="poster-scroll"><image class="poster-preview" src="{{posterPath}}" mode="widthFix"/></scroll-view><view class="poster-actions"><ui-button bind:press="savePoster" variant="primary" block label="{{t.saveImage}}"/></view></block>
 <block wx:elif="{{sheet === 'official' || sheet === 'recap'}}"><text class="hero-title">{{externalContent.label}}</text><text class="external-preview-note">{{demo || externalContent.demo ? (locale === 'en' ? 'Offline demo only. No real account or article is opened.' : '离线演示内容，不会打开真实公众号或文章。') : (locale === 'en' ? 'We could not open this in WeChat. The account may need linking, or this version may not support it.' : '暂时无法在微信内打开，请检查账号关联、文章状态或微信版本。')}}</text><image wx:if="{{externalContent.cover_url}}" class="external-preview-cover" src="{{externalContent.cover_url}}" mode="aspectFill"/><text wx:if="{{externalContent.excerpt}}" class="body-text">{{externalContent.excerpt}}</text><text wx:if="{{externalContent.published_at}}" class="meta">{{externalContent.published_at}}</text><text wx:if="{{externalContent.username && !externalContent.demo}}" class="body-text" selectable>{{externalContent.username}}</text><ui-button wx:if="{{sheet === 'official' && externalContent.username && !demo && !externalContent.demo}}" data-value="{{externalContent.username}}" bind:press="copy" variant="secondary" label="{{locale === 'en' ? 'Copy account ID' : '复制公众号 ID'}}"/><ui-button wx:if="{{sheet === 'recap' && externalContent.url && !demo && !externalContent.demo}}" data-value="{{externalContent.url}}" bind:press="copy" variant="secondary" label="{{locale === 'en' ? 'Copy article link' : '复制文章链接'}}"/></block>
 <block wx:elif="{{sheet === 'city'}}"><ui-action-row wx:for="{{cities}}" wx:key="id" data-id="{{item.id}}" bind:press="selectCity" label="{{locale === 'en' ? item.en : item.zh}}" description="{{locale === 'en' ? item.zh : item.en}}" selection="{{true}}" selected="{{city === item.id}}"/></block>
 <block wx:elif="{{sheet === 'language'}}"><ui-action-row data-locale="zh-CN" bind:press="selectLanguage" label="简体中文" description="Chinese (Simplified)" selection="{{true}}" selected="{{locale !== 'en'}}"/><ui-action-row data-locale="en" bind:press="selectLanguage" label="English" description="English" selection="{{true}}" selected="{{locale === 'en'}}"/></block>
 <block wx:elif="{{sheet === 'notifications'}}"><view class="settings-row"><view class="settings-icon"><image class="ui-icon" src="{{illustrations.bell}}" aria-hidden="true"/></view><text class="settings-label">{{t.notificationSettings}}</text><ui-switch checked="{{record.notification_preferences.enabled}}" data-kind="notifications" bind:change="preference"/></view><text class="meta">{{record.notification_preferences.enabled ? (locale === 'en' ? 'Notifications enabled' : '已开启通知') : (locale === 'en' ? 'Notifications disabled' : '已关闭通知')}}</text></block>
 <block wx:elif="{{sheet === 'mini'}}"><text class="brand mini-logo">706</text><ui-action-row data-kind="about" bind:press="sheet" label="{{sheetCopy.titles.about}}" navigation="{{true}}"/><ui-action-row bind:press="reloadPage" label="{{locale === 'en' ? 'Reload page' : '重新加载页面'}}"/><ui-action-row data-route="feedback" bind:press="navigate" label="{{t.feedback}}" navigation="{{true}}"/></block>
 <block wx:elif="{{sheet === 'about'}}"><text class="brand mini-logo">706</text><text class="body-text">{{sheetCopy.descriptions.mini}}</text></block>
 <block wx:elif="{{sheet === 'manage'}}"><ui-action-row data-route="edit-entity" data-id="{{record.id}}" bind:press="navigate" label="{{t.edit}}" navigation="{{true}}"/><ui-action-row data-route="approvals" bind:press="navigate" label="{{t.approvals}}" navigation="{{true}}"/><ui-action-row wx:if="{{record.can_admin}}" data-route="admins" data-id="{{record.id}}" bind:press="navigate" label="{{t.admins}}" navigation="{{true}}"/></block>
 <block wx:elif="{{sheet === 'member'}}"><ui-action-row data-value="{{'/pages/member/index?id=' + record.owner}}" bind:press="copy" label="{{locale === 'en' ? 'Copy profile link' : '复制主页链接'}}"/><ui-action-row wx:if="{{record.owner !== currentUser && record.muted}}" data-op="mute" data-id="{{record.owner}}" data-block-id="{{record.block_id}}" data-enabled="0" disabled="{{busy}}" loading="{{busy}}" bind:press="action" label="{{t.unmute}}"/><ui-action-row wx:elif="{{record.owner !== currentUser}}" data-op="mute" data-id="{{record.owner}}" disabled="{{busy}}" loading="{{busy}}" bind:press="action" label="{{t.mute}}"/><ui-action-row wx:if="{{platformAdmin && record.owner !== currentUser}}" data-op="grantPlatformAdmin" data-id="{{record.owner}}" disabled="{{busy}}" loading="{{busy}}" bind:press="action" label="{{t.grantAdmin}}"/><ui-action-row data-kind="report" bind:press="sheet" label="{{t.report}}" navigation="{{true}}"/></block>
 <block wx:elif="{{sheet === 'why'}}"><ui-identity-row wx:for="{{sheetCopy.reasons}}" wx:key="index" src="{{illustrations.reasons[index]}}" name="{{item[0]}}" description="{{item[1]}}" size="30"/></block>
 <block wx:elif="{{sheet === 'payment'}}"><text class="section-title">{{record.event.title}}</text><view class="payment-total"><text>{{locale === 'en' ? 'Total' : '应付金额'}}</text><text>{{record.event.feeLabel}}</text></view><text wx:if="{{demo}}" class="notice">{{locale === 'en' ? 'Demo payment only. No money is charged.' : '仅模拟本地付款状态，不会扣款。'}}</text><ui-button data-op="payment" disabled="{{busy}}" loading="{{busy}}" bind:press="action" variant="primary" block label="{{demo ? (locale === 'en' ? 'Simulate payment' : '模拟付款') : t.pay}}"/></block>
 <block wx:elif="{{sheet === 'group'}}"><view wx:for="{{access.methods}}" wx:key="type" class="participation-method"><text class="participation-method-title">{{t[item.type]}}</text><text wx:if="{{demo && item.type === 'GROUP_QR'}}" class="participation-note">合成演示二维码 · 仅含 DEMO 标识，无真实群信息</text><image wx:if="{{item.type === 'GROUP_QR'}}" class="qr" src="{{item.value}}" mode="widthFix"/><text wx:else class="participation-method-value" user-select="{{true}}">{{item.value}}</text><view wx:if="{{item.type !== 'GROUP_QR' && item.value}}" class="participation-sheet-actions"><view class="participation-sheet-action"><ui-button compact label="{{t.copy}}" data-value="{{item.value}}" bind:press="copy" disabled="{{busy}}"/></view></view></view></block>
 <block wx:elif="{{sheet === 'return'}}"><ui-form-field data-key="note" value="{{sheetForm.note}}" placeholder="{{t.note}}" type="area" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/><ui-button data-op="review" data-approve="{{false}}" loading="{{busy}}" disabled="{{busy}}" bind:press="action" variant="primary" block label="{{locale === 'en' ? 'Send requested changes' : '发送修改意见'}}"/></block>
 <block wx:else>
  <block wx:if="{{sheet === 'register'}}"><text class="section-title">{{record.title}}</text><text class="label">{{t.display_name}}</text><ui-form-field data-key="display_name" value="{{sheetForm.display_name}}" placeholder="{{t.display_name}}" type="text" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/><text class="label">{{t.motivation}}</text><ui-form-field data-key="motivation" value="{{sheetForm.motivation}}" placeholder="{{t.motivation}}" type="area" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/><template is="privacyConsent" data="{{consent,busy,locale,profileScope:false}}"/><ui-checkbox wx:if="{{demo}}" checked="{{shareContact}}" label="{{t.shareContact}}" bindchange="contactConsent"/></block>
  <block wx:elif="{{sheet === 'comment'}}"><scroll-view scroll-y class="sheet-comments"><ui-comment-thread wx:for="{{commentThreads}}" wx:key="id" item="{{item}}" t="{{t}}" current-user="{{currentUser}}" locale="{{locale}}" busy="{{busy}}" surface="sheet" bind:interaction="uiInteraction"/></scroll-view><text wx:if="{{sheetForm.reply_to}}" class="meta">{{t.reply}}</text><ui-form-field data-key="text" value="{{sheetForm.text}}" placeholder="{{t.comment}}" type="area" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/></block>
  <ui-form-field wx:elif="{{sheet === 'invite' || sheet === 'grantAdmin'}}" data-key="user_id" value="{{sheetForm.user_id}}" placeholder="{{t.user_id}}" type="text" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/>
  <ui-form-field wx:else data-key="{{sheet === 'report' ? 'reason' : 'text'}}" value="{{sheetForm[sheet === 'report' ? 'reason' : 'text']}}" placeholder="{{sheet === 'report' ? t.reason : t.text}}" type="area" bind:input="sheetInput" bind:keyboardheightchange="keyboardChange"/>
  <ui-button disabled="{{busy || (sheet === 'register' && !consent)}}" loading="{{busy}}" bind:press="submitSheet" variant="primary" block label="{{sheet === 'register' ? (record.remaining === 0 ? t.waitlist : record.approval_required ? t.apply : t.register) : sheet === 'recommend' ? (locale === 'en' ? 'Publish recommendation' : '发布推荐') : t.confirm}}"/>
 </block>
</ui-sheet>
