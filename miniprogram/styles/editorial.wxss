/* 706 shared page and slot layout. Native ui-* components own controls, cards,
   navigation, forms, media editing, comments and their interaction states. */

.screen .chip{border:1px solid transparent;border-radius:var(--pill);background:var(--surface);color:var(--ink);font-size:var(--typeFact);padding:10rpx 18rpx}
.screen .section-heading{font-size:var(--typeSection);font-weight:600;margin:var(--sectionGap) 0 var(--headingGap);gap:20rpx;line-height:1.6}
.screen .section-title{font-size:var(--typeSection);font-weight:600;line-height:1.45}
.screen .hero-title{font-size:var(--typeTitle);font-weight:600;line-height:1.35;letter-spacing:-.5rpx}
.screen .body-text{font-size:var(--typeBody);font-weight:400;line-height:1.7}
.screen .meta{font-size:var(--typeMeta);color:var(--muted)}
.screen .list-card{border:0;border-radius:var(--radius);box-shadow:none;padding:var(--panelInset);margin-bottom:var(--itemGap)}
.screen .self-profile{border:0;border-radius:var(--radius);box-shadow:none;margin-bottom:var(--itemGap)}
.screen .people-heading{margin-top:16rpx;margin-bottom:16rpx}

.screen .status{display:inline-block;padding:3rpx 10rpx;border:0;border-radius:var(--pill);font-size:var(--typeLabel);line-height:1.4}
.screen .filters{margin:32rpx 0 36rpx}
.screen .chips{margin:20rpx 0}
.screen.has-bottom{padding-bottom:calc(160rpx + var(--tabBarSpace) + env(safe-area-inset-bottom))}
.screen.has-bottom .detail-cover{height:440rpx;border:0;border-radius:var(--radius)}
.screen .detail-facts{padding:24rpx 28rpx;border:0;border-radius:var(--radius)}
.screen .detail-fact{padding-top:20rpx;padding-bottom:20rpx;gap:24rpx}
.screen .fact-main{font-size:var(--typeBody);font-weight:500;line-height:1.5}
.screen .detail-fact .meta{font-size:var(--typeMeta);line-height:1.6}
.screen .section{padding:var(--sectionInset) 0}
.screen .section>.section-title{margin-bottom:var(--headingGap)}
.screen .section>.section-title + .body-text{margin-top:0}
.screen .section>.section-heading{margin-top:0}
.screen .member-hero{padding:36rpx;border:0;border-radius:var(--radius);margin-bottom:var(--sectionGap)}
.screen .member-avatar{width:120rpx;height:120rpx}
.screen .member-name{font-size:var(--typeTitle);line-height:1.5;margin:28rpx 0 20rpx}
.screen .member-city{line-height:1.8;gap:12rpx}
.screen .member-intro{font-size:var(--typeBody);line-height:1.9;margin-top:24rpx}
.screen .member-hero .chips{display:flex;flex-wrap:wrap;white-space:normal;gap:12rpx;margin:28rpx 0 32rpx}
.screen .member-hero .chip{font-size:var(--typeFact);line-height:1.5;padding:10rpx 18rpx;margin:0}
.screen .member-actions{margin:32rpx 0;gap:20rpx}
.screen .member-stats{margin-top:32rpx;padding-top:32rpx}
.screen .member-stats text{font-size:var(--typeSection)}
.screen .member-stats text + text{font-size:var(--typeFact);margin-top:12rpx}
.screen .member-section{margin-bottom:var(--sectionGap)}
.screen .member-section>.section-title{margin-bottom:var(--headingGap);line-height:1.6}
.screen .member-history-heading{margin-top:0;margin-bottom:var(--headingGap)}
.screen .label{margin-bottom:16rpx;line-height:1.6}
.screen .settings-row{background:var(--surface)!important;border:0;border-radius:0!important;min-height:104rpx;padding:24rpx!important;margin:0!important;font-size:var(--typeBody);font-weight:400}
.screen .settings-icon{border-radius:50%}
.screen .self-profile{padding:36rpx}
.main-navigation{position:fixed;top:0;left:0;right:0;z-index:9;box-sizing:border-box;background:linear-gradient(to bottom,var(--canvas) 0,var(--canvas) calc(100% - 48rpx),var(--chromeClear) 100%);pointer-events:none}
.main-navigation-content{display:flex;align-items:center;gap:12rpx;box-sizing:border-box;width:100%;padding-left:var(--pageGutter)}
.subpage-title{flex:1;min-width:0;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--typeBody);font-weight:500;line-height:1.4}
.screen .review-controls{background:linear-gradient(to bottom,var(--chromeSoft),var(--chromeClear));border:0}
.screen .status{background:var(--control);color:var(--muted)}
.screen .event-discussion{padding-top:40rpx;padding-bottom:16rpx}
.screen .event-discussion>.section-heading{margin-bottom:28rpx}
.screen .event-management{display:flex;flex-direction:column;gap:16rpx;margin:32rpx 0 48rpx;padding-top:32rpx;border-top:var(--stroke) solid var(--line)}
.screen .management-group{overflow:hidden;border-radius:var(--radius);background:var(--surface)}
.screen .settings-icon{background:transparent}
.screen .developer-personas{display:flex;flex-wrap:wrap;gap:12rpx;white-space:normal;margin-top:28rpx}
.screen .filter-group{display:flex;align-items:center;gap:12rpx;min-height:64rpx;margin:10rpx 0}
.screen .filter-options{flex:1;min-width:0;margin:0;white-space:nowrap}
.screen .filter-options .chip{padding:8rpx 16rpx;font-size:var(--typeFact);border-color:var(--line);line-height:1.4}
.screen .calendar-results-title{margin-top:40rpx}
.screen .detail-series-links{padding:16rpx 0;border-bottom:var(--stroke) solid var(--line)}
.screen .event-secondary-actions{flex-wrap:wrap;justify-content:flex-start;padding:16rpx 0 24rpx;gap:24rpx}
.main-navigation-content>.header-message-filters{pointer-events:auto;flex:1;min-width:0;height:100%;white-space:nowrap}
.screen .header-message-filters .chip{vertical-align:middle;font-size:var(--typeMeta);line-height:1.4;padding:6rpx 14rpx;margin:0 8rpx 0 0!important}
.menu-group-title{display:block;font-size:var(--typeFact);font-weight:500;line-height:1.5;margin:36rpx 0 20rpx;color:var(--muted)}
.screen.page-me .settings-row{min-height:104rpx;padding:24rpx!important;margin:0!important}
.screen .settings-label{min-width:0;line-height:1.5}
.form-intro{margin-bottom:32rpx}
.screen .form-intro .hero-title{margin:0 0 16rpx}
.screen .form-intro .body-text{line-height:1.7;margin:0}
.field-error{display:block;margin-top:12rpx;font-size:var(--typeFact);line-height:1.5;color:var(--danger)}
.screen .onboarding-spaces-title{font-size:var(--typeBody);margin-top:32rpx}
.screen .review-guidance{display:block;background:var(--control);border-radius:24rpx;padding:24rpx;color:var(--ink);font-size:var(--typeFact);line-height:1.7;margin:24rpx 0 32rpx}
.screen .review-history-title{font-size:var(--typeBody);margin-top:32rpx;margin-bottom:20rpx}
.screen .review-steps{margin-bottom:32rpx}
.screen .review-step{align-items:flex-start;font-size:var(--typeBody);line-height:1.6}
.screen .review-step .meta{font-size:var(--typeFact);line-height:1.7;margin-top:8rpx}
.screen .review-scope{font-size:var(--typeMeta);color:var(--muted)}
.screen .avatar{border:0}
.screen .review-cover{width:100%;height:280rpx;background:var(--control);border-radius:24rpx;margin:24rpx 0}
.node-shelf{margin:0 0 24rpx}
.node-load-note{display:flex;align-items:center;gap:12rpx;font-size:var(--typeMeta);color:var(--muted)}
.screen.page-feed .people-heading{font-size:var(--typeBody);margin-top:20rpx}
.screen.page-feed .discovery-people{margin-bottom:32rpx}
.node-directory-intro{margin-bottom:32rpx}
.node-directory-tabs{margin-top:24rpx}
.screen .space-directory-card{height:320rpx;background:var(--control);border-radius:28rpx;margin:24rpx 0}
.space-directory-summary{font-size:var(--typeFact);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.space-directory-count{margin-top:16rpx;font-size:var(--typeMeta)}
.screen .space-directory-body .meta{color:rgba(255,253,248,.85)}
.entity-intro{margin-bottom:32rpx}
.screen .entity-cover{height:280rpx;margin-bottom:28rpx}
.entity-actions{display:flex;align-items:center;gap:28rpx;margin-top:24rpx}
.entity-connections{padding:12rpx 0}
.entity-section-label{display:block;font-size:var(--typeFact);line-height:1.5;color:var(--muted);margin-bottom:8rpx}
.entity-missing{padding:16rpx 0}
.entity-link-title{display:block;font-size:var(--typeBody);line-height:1.5;font-weight:500}
.entity-connections .meta{font-size:var(--typeMeta);line-height:1.6;margin-top:4rpx}
.entity-stories .meta{font-size:var(--typeMeta);line-height:1.6;margin-top:4rpx}
.screen .entity-stories .section-heading{margin-top:32rpx;margin-bottom:16rpx}
.screen .entity-events-heading{margin-top:40rpx}
.entity-members-section{margin-top:48rpx}
.entity-member-strip{white-space:nowrap;margin-top:24rpx}
.external-preview-cover{display:block;width:100%;height:240rpx;border-radius:24rpx;margin:24rpx 0}
.external-preview-note{display:block;margin:20rpx 0;font-size:var(--typeFact);line-height:1.7;color:var(--muted)}
.screen.task-page{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}
.screen.task-page .form-intro{margin-bottom:40rpx}
.screen .label{font-size:var(--typeBody);font-weight:500}
.screen .form-intro .hero-title{font-size:var(--typeTitle)}
.screen .form-intro .body-text{font-size:var(--typeFact)}
.ui-icon{display:block;flex:none;width:40rpx;height:40rpx;object-fit:contain}
.screen .detail-fact>.ui-icon{width:36rpx;height:36rpx;margin-top:4rpx}
.screen .settings-icon>.ui-icon{width:40rpx;height:40rpx}
.screen .member-city>.ui-icon{display:inline-block;width:28rpx;height:28rpx;vertical-align:middle;margin-right:8rpx}
.screen .detail-facts{background:var(--surface)}
.screen .detail-series-links{border:0}
.screen .series-hero{background:var(--surface);border-radius:var(--radius)}
.screen .series-tint{background:rgba(255,255,255,.9)}
.screen .series-about{border:0}
.screen.child-page:not(.has-bottom):not(.task-page){padding-bottom:calc(var(--sectionGap) + env(safe-area-inset-bottom))}
.screen .mine-filter-row{display:block;white-space:nowrap;margin:var(--headingGap) 0 var(--itemGap)}
.screen .participation-steps{margin-top:var(--sectionGap)}
.screen .participation-steps>.section-title{margin-bottom:var(--headingGap)}
.screen .participation-group{overflow:hidden;border-radius:var(--radius);background:var(--surface)}
.screen .participation-note{display:block;margin:var(--headingGap) 0;color:var(--muted);font-size:var(--typeMeta);line-height:1.7}
.screen .participation-management{margin-top:var(--sectionGap)}
.screen .participation-management-label{display:block;margin-bottom:var(--actionGap);font-size:var(--typeMeta);color:var(--muted);line-height:1.5}
.screen .participation-method{margin-bottom:var(--itemGap)}
.screen .participation-method-title{display:block;font-size:var(--typeBody);font-weight:600;line-height:1.5}
.screen .participation-method-value{display:block;margin-top:var(--actionGap);font-size:var(--typeFact);line-height:1.7;white-space:pre-wrap}
.screen .participation-sheet-actions{display:flex;justify-content:flex-end;gap:var(--actionGap);margin-top:var(--spaceUnit)}
.screen .participation-sheet-action{display:flex;flex:0 0 auto;max-width:100%;margin-left:auto}
.screen .review-step{border:0;background:var(--surface);border-radius:var(--radius);padding:24rpx;margin-bottom:16rpx;gap:16rpx}
.screen .status-dot{background:var(--control);border:1px solid var(--ink)}
.screen .status-dot.passed{background:var(--ink)}
.screen.page-event{padding-bottom:calc(168rpx + env(safe-area-inset-bottom))}
.screen.page-activity-preview{padding-bottom:calc(168rpx + env(safe-area-inset-bottom))}
.screen.page-event .detail-cover{display:block;flex:none;width:180rpx;height:240rpx;margin:0;border-radius:24rpx;border:0}
.screen.page-activity-preview .detail-cover{display:block;flex:none;width:180rpx;height:240rpx;margin:0;border-radius:24rpx;border:0}
.screen.page-event .section{padding:28rpx 0;margin:0 0 24rpx}
.screen.page-activity-preview .section{padding:28rpx 0;margin:0 0 24rpx}
.screen.page-event .event-information{padding:28rpx 0;background:transparent;border:0;border-radius:0}
.screen.page-activity-preview .event-information{padding:28rpx 0;background:transparent;border:0;border-radius:0}
.screen.page-event .detail-facts{padding:28rpx 0;background:transparent;border:0;border-radius:0}
.screen.page-activity-preview .detail-facts{padding:28rpx 0;background:transparent;border:0;border-radius:0}
.screen.page-event .section>.section-title{display:block;margin:0 0 24rpx;font-size:var(--typeSection);line-height:1.4}
.screen.page-activity-preview .section>.section-title{display:block;margin:0 0 24rpx;font-size:var(--typeSection);line-height:1.4}
.screen.page-event .detail-fact{padding:16rpx 0}
.screen.page-event .event-person-card{padding:28rpx;background:var(--surface);border-radius:var(--radius);margin:0 0 24rpx}
.screen.page-event .detail-series-links{margin:0 0 32rpx;padding:28rpx;background:var(--surface);border-radius:var(--radius)}
.screen.page-event .detail-series-links>.section-title{display:block;margin-bottom:16rpx;font-size:var(--typeBody)}
.screen.page-event .event-secondary-actions{display:flex;flex-wrap:wrap;padding:0;margin:0 0 48rpx}
.screen.page-event .event-discussion{padding:28rpx;background:var(--surface);border-radius:var(--radius);margin-bottom:32rpx}
.screen.page-event .event-discussion .section-heading{font-size:var(--typeSection);font-weight:600}
.screen .event-overview{display:flex;align-items:flex-start;gap:28rpx;padding:16rpx 0 24rpx}
.screen .event-overview-copy{flex:1;min-width:0}
.screen .event-overview-copy>.hero-title{display:block;font-size:var(--typeTitle);line-height:1.35;margin:0 0 28rpx}
.screen.page-event .event-overview-copy>.event-information{padding:0;margin:0}
.screen.page-activity-preview .event-overview-copy>.event-information{padding:0;margin:0}
.screen.page-event .event-overview-copy .section-title{font-size:var(--typeSection);margin-bottom:16rpx}
.screen.page-activity-preview .event-overview-copy .section-title{font-size:var(--typeSection);margin-bottom:16rpx}
.screen .event-overview-copy .body-text{margin:0}
.screen .event-overview-tags{margin:0 0 24rpx}
.screen .event-description{padding:0 0 24rpx}
.main-navigation.subpage-navigation{background:transparent}
.screen.page-event .event-secondary-actions{gap:var(--actionGap);align-items:center}
/* Horizontal public member strip composes the shared identity primitive. */
.entity-member-item{display:inline-block;vertical-align:top;min-width:160rpx;max-width:300rpx;white-space:normal;flex:none}
